<style id="umit-mini-fs-fix">html.fs-fallback #main.pw-mini #pw{width:100%!important;height:100%!important}html.fs-fallback #main.pw-mini #vid{position:absolute!important;top:0!important;left:0!important;right:auto!important;bottom:auto!important;width:100%!important;height:100%!important;object-fit:cover!important;pointer-events:none!important}html.fs-fallback #main.pw-mini #epg-panel{display:none!important}#app:fullscreen #main.pw-mini #pw{width:100%!important;height:100%!important}#app:fullscreen #main.pw-mini #vid{position:absolute!important;top:0!important;left:0!important;width:100%!important;height:100%!important;object-fit:cover!important;pointer-events:none!important}#app:fullscreen #main.pw-mini #epg-panel{display:none!important}#app:-webkit-full-screen #main.pw-mini #pw{width:100%!important;height:100%!important}#app:-webkit-full-screen #main.pw-mini #vid{position:absolute!important;top:0!important;left:0!important;width:100%!important;height:100%!important;object-fit:cover!important;pointer-events:none!important}#app:-webkit-full-screen #main.pw-mini #epg-panel{display:none!important} html.fs-fallback #main.pw-mini{z-index:10000} .dm-flip-clone{pointer-events:none!important}</style>
