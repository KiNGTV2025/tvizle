<style id="umit-brand-back">#setup .brand{perspective:800px}#setup .brand-badge{transform-style:preserve-3d;-webkit-transform-style:preserve-3d;outline:none}#setup .brand-badge .bb-face{-webkit-backface-visibility:hidden;backface-visibility:hidden}#setup .brand-badge .bb-front{display:flex;align-items:center;gap:9px;transform:translateZ(1px)}#setup .brand-badge .bb-back{position:absolute;inset:-1px;border-radius:999px;display:none;align-items:center;justify-content:center;gap:8px;transform:rotateY(180deg) translateZ(1px);background:linear-gradient(135deg,#dc2626,#991b1b);color:#fff;font-weight:900;font-size:1.05rem;letter-spacing:-.2px;white-space:nowrap;box-shadow:inset 0 0 0 1px var(--bord2)}html.umit-embedded #setup .brand-badge{cursor:pointer;transition:transform .6s cubic-bezier(.4,.1,.2,1)!important;transition-duration:.6s!important;transition-property:transform!important}html.umit-embedded #setup .brand-badge .bb-back{display:flex}html.umit-embedded #setup .brand-badge:focus,html.umit-embedded #setup .brand-badge.bb-flip{transform:rotateY(180deg)}html.umit-embedded #setup .brand-badge:focus-visible{outline:3px solid var(--acc)!important;outline-offset:5px}@keyframes bbSpin{0%,36%{transform:rotateY(0deg)}48%,86%{transform:rotateY(180deg)}100%{transform:rotateY(360deg)}}html.umit-embedded #setup .brand-badge,html.umit-embedded.umit-quiet #setup .brand-badge{animation:bbSpin 5s cubic-bezier(.4,.1,.2,1) infinite,brandGlow 2.6s ease-in-out infinite!important;-webkit-tap-highlight-color:transparent;will-change:transform}html.umit-embedded #setup .brand-badge:focus,html.umit-embedded #setup .brand-badge:active,html.umit-embedded #setup .brand-badge.bb-flip{animation:none!important;transform:rotateY(180deg)}</style>
