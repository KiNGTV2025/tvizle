<style id="umit-bigfs-css">html.umit-bigfs-hide #main{display:none!important}html.umit-bigfs-hide #chpanel,html.umit-bigfs-hide #chpanel.open{flex:1 1 auto!important;width:auto!important;max-width:none!important;min-width:0!important}html.umit-bigfs-hide #chlist{padding:16px 22px 22px 16px!important}html.umit-bigfs-hide #chpanel-search,html.umit-bigfs-hide #chpanel-toolbar{padding-right:22px}</style>
<style id="umit-mobile-header">@media (max-width:1024px) and (min-height:601px){html:not(.tv-device) #topbar{--tbf:calc(.66rem*var(--umit-fs,1));height:auto!important;min-height:0!important;box-sizing:border-box;flex-wrap:wrap;align-items:center;justify-content:flex-start;padding:5px 8px!important;gap:5px!important;row-gap:5px!important;overflow:visible}html:not(.tv-device) #topbar .tb-logo{font-size:calc(1rem*var(--umit-fs,1))!important;line-height:1.1}html:not(.tv-device) #topbar .tb-src{font-size:var(--tbf)!important;padding:.4em .6em!important;border-radius:.7em;gap:.4em;max-width:38vw}html:not(.tv-device) #topbar .tb-src #srcnm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}html:not(.tv-device) #topbar #tb-settingsbtn{margin-left:auto} html:not(.tv-device) #topbar .tbbtn,html:not(.tv-device) #topbar .pls-refresh-standalone{font-size:var(--tbf)!important;padding:.45em .6em!important;border-radius:.75em!important;gap:.35em;line-height:1.15;min-height:0;box-sizing:border-box}html:not(.tv-device) #topbar .tbbtn svg{width:1.25em;height:1.25em;flex-shrink:0}html:not(.tv-device) #topbar #voiceCmdBtn svg{width:1.45em;height:1.45em}html:not(.tv-device) #topbar .tb-btns{order:4;flex:1 1 100%;width:100%;max-width:100%;flex-wrap:wrap;overflow:visible!important;gap:5px;justify-content:flex-start;padding:0}html:not(.tv-device) #topbar #tb-fitbtn{margin-left:0} html:not(.tv-device) #topbar #mmtabs{order:5;flex:1 1 100%;width:100%;box-sizing:border-box;gap:2px;padding:3px;border-radius:.9em;overflow-x:auto;overflow-y:hidden;align-items:stretch;scroll-snap-type:x proximity}html:not(.tv-device) #topbar #mmtabs .mmtab,html:not(.tv-device) #topbar #mmtabs .tbbtn,html:not(.tv-device) #topbar #mmtabs #whatBtn{flex:0 0 auto;background:none;border:none!important;box-shadow:none;border-radius:.65em!important;font-family:'Outfit',sans-serif;font-size:var(--tbf)!important;font-weight:700;padding:.45em .6em!important;gap:.35em;line-height:1.15;display:flex;align-items:center;color:var(--text2);white-space:nowrap;scroll-snap-align:start;transform:none}html:not(.tv-device) #topbar #mmtabs .mmtab span,html:not(.tv-device) #topbar #mmtabs .tbbtn span{display:inline!important;font-size:inherit!important;color:inherit}html:not(.tv-device) #topbar #mmtabs .mmtab svg,html:not(.tv-device) #topbar #mmtabs .tbbtn svg{width:1.2em;height:1.2em}html:not(.tv-device) #topbar #mmtabs .mmtab.on{background:linear-gradient(135deg,var(--acc),var(--acc2));color:var(--on-acc,#fff)}html:not(.tv-device) #topbar #mmtabs #whatBtn{color:#a855f7}html:not(.tv-device) #topbar #mmtabs #whatBtn span{color:var(--text2)}}@media (max-width:480px) and (min-height:601px){ html:not(.tv-device) #topbar #tb-orient-lbl,html:not(.tv-device) #topbar #tb-fit-lbl{display:none}}</style>

<style id="umit-continue-modern">#vodContinueRow{margin:10px 14px 4px;border-radius:22px;background:linear-gradient(135deg,color-mix(in srgb,var(--acc) 16%,var(--bg2)) 0%,var(--bg1) 62%);border:1px solid color-mix(in srgb,var(--acc) 26%,transparent)}#vodContinueRow .continue-row-hd{padding:12px 16px 6px;border-radius:22px 22px 0 0}#vodContinueRow .continue-row-hd-t{font-size:1.05rem;font-weight:800;letter-spacing:.2px;gap:10px}#vodContinueRow .continue-row-hd-t::before{content:'';width:5px;height:20px;border-radius:4px;flex-shrink:0;background:linear-gradient(180deg,var(--acc3),var(--acc))}#vodContinueRow .continue-row-count{background:linear-gradient(135deg,var(--acc),var(--acc2));border:none;color:var(--on-acc,#111);min-width:22px;text-align:center;padding:2px 9px;font-weight:800}#vodContinueRow .continue-row-chev{width:30px;height:30px;padding:6px;border-radius:50%;box-sizing:border-box;background:color-mix(in srgb,var(--acc) 18%,transparent);color:var(--acc3)}#vodContinueRow .continue-row-hd:focus,#vodContinueRow .continue-row-hd:focus-visible{outline:3px solid var(--acc);outline-offset:-3px;background:color-mix(in srgb,var(--acc) 14%,transparent)}#vodContinueRow .continue-row-body{padding-bottom:6px}#vodContinueRow .disc-row.disc-row-resume,.disc-row.disc-row-resume{gap:16px;padding:16px 30px 16px;scroll-padding-left:30px;scroll-padding-right:30px;scroll-padding-inline:30px} .disc-row.disc-row-resume::after{content:'';flex:0 0 14px}#vodContinueRow .disc-row.disc-row-resume .vcard{flex:0 0 138px;width:138px}@media(min-width:900px){#vodContinueRow .disc-row.disc-row-resume .vcard{flex-basis:164px;width:164px}}#vodContinueRow .vcard-poster{border-radius:16px;border:1px solid color-mix(in srgb,var(--acc) 22%,transparent);overflow:hidden}#vodContinueRow .vcard-poster::after{content:'';position:absolute;left:0;right:0;bottom:0;height:46%;pointer-events:none;z-index:1;background:linear-gradient(180deg,transparent,rgba(0,0,0,.78))}#vodContinueRow .vcard-typebadge{z-index:3;top:8px;left:8px;border-radius:8px;padding:3px 9px}#vodContinueRow .vcard-resume{z-index:3;left:10px;right:10px;bottom:9px;height:4px;border-radius:4px;background:rgba(255,255,255,.28);overflow:hidden}#vodContinueRow .vcard-resume-fill{border-radius:4px}#vodContinueRow .vcard-resume-tag{z-index:3;left:auto;right:8px;top:8px;bottom:auto;border-radius:999px;padding:3px 9px;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.18)}#vodContinueRow .vcard-title{margin-top:8px;font-size:.82rem;font-weight:700;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}#vodContinueRow .vcard:focus .vcard-poster,#vodContinueRow .vcard:focus-visible .vcard-poster{border-color:var(--acc)}</style>
