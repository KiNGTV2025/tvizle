<style id="umit-side-focus-fix">html #sidebar .catbtn:focus,html #sidebar .catbtn:focus-visible,html #mob-cats .catbtn:focus,html #mob-cats .catbtn:focus-visible{outline:3px solid var(--acc)!important;outline-offset:-3px!important;box-shadow:inset 0 0 0 5px var(--bord2)!important;border-radius:12px!important;transform:none!important}html #sidebar{overflow-x:hidden!important;box-sizing:border-box!important;padding-left:10px!important;padding-right:10px!important;padding-top:12px!important;padding-bottom:14px!important;scroll-padding:12px 0!important}html.tv-device #sidebar{width:120px!important}html #sidebar .catbtn,html #sidebar .cat-search-side{max-width:100%!important;box-sizing:border-box!important} html.tv-device #chpanel{box-sizing:border-box!important;padding-left:max(6px,env(safe-area-inset-left,0px))!important;padding-bottom:max(6px,env(safe-area-inset-bottom,0px))!important}</style>
<style id="umit-side-scroll-fix">html #sidebar{min-height:0}html #sidebar > *{flex-shrink:0!important}html #sidebar #sidebar-catlist{flex:0 0 auto!important;height:auto!important;max-height:none!important;overflow-y:visible!important}html #sidebar .catbtn{flex-shrink:0!important}</style>
<style id="umit-player-noring">#pw:focus,#pw:focus-visible,#vid:focus,#vid:focus-visible,video:focus,video:focus-visible,#main:focus,#main:focus-visible,#app:focus,#app:focus-visible,#ov:focus,#ov:focus-visible,body:focus,html:focus{outline:none!important;box-shadow:none!important}</style>
<style id="umit-tv-eps-compact">html.tv-device #sd-eps,html.umit-lite #sd-eps{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}html.tv-device #sd-eps .sv-card,html.umit-lite #sd-eps .sv-card{margin-bottom:0;border-radius:12px}html.tv-device #sd-eps .sv-thumb,html.umit-lite #sd-eps .sv-thumb{aspect-ratio:16/8}html.tv-device #sd-eps .sv-body,html.umit-lite #sd-eps .sv-body{padding:8px 10px}html.tv-device #sd-eps .sv-title,html.umit-lite #sd-eps .sv-title{font-size:.82rem}html.tv-device #sd-eps .sv-plot,html.umit-lite #sd-eps .sv-plot{font-size:.68rem;-webkit-line-clamp:1;margin-top:3px}html.tv-device #sd-eps .sv-row3,html.umit-lite #sd-eps .sv-row3{margin-top:5px}html.tv-device #sd-eps .sv-ib,html.umit-lite #sd-eps .sv-ib{width:28px;height:28px}html.tv-device #sd-eps .sv-ib:focus,html.tv-device #sd-eps .sv-more:focus{outline:3px solid var(--acc);outline-offset:2px}</style>
<style id="umit-lowend-fs-list-css">html:not(#u).umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel:not([style*="display: none"]),html:not(#u).umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel.fs-open:not([style*="display: none"]),html:not(#u).umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar,html:not(#u).umit-fs-on.umit-fs-list:not(.mm-nonlive):not(.vod-skin) body #sidebar,html:not(#u).umit-fs-on body #fs-chlist-backdrop,html:not(#u).umit-fs-on body #fs-chlist-backdrop.show{transition:none!important;will-change:auto!important}html:not(#u).umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel:not(.fs-open):not([style*="display: none"]){content-visibility:hidden}html:not(#u).umit-fs-on:not(.umit-fs-list):not(.mm-nonlive):not(.vod-skin) body #sidebar{content-visibility:hidden}</style>
<style id="umit-freeze-nologo">html:root:root:root #pw.ch-freezing #pw-brand,html:root:root:root #pw.ch-freezing #pw-brand::before{display:none!important}</style>
<style id="umit-fs-cats-drawer">html:not(#u).tv-device.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel:not([style*="display: none"]){padding-left:0!important}html:not(#u).tv-device.umit-fs-on.umit-fs-list:not(.umit-fs-cats):not(.mm-nonlive):not(.vod-skin) body #sidebar{transform:translate3d(-320%,0,0)!important;visibility:hidden!important;pointer-events:none!important;transition:transform .16s cubic-bezier(.4,0,.6,1),visibility 0s linear .16s!important}html:not(#u).tv-device.umit-fs-on.umit-fs-list.umit-fs-cats:not(.mm-nonlive):not(.vod-skin) body #sidebar{transform:translate3d(0,0,0)!important;visibility:visible!important;pointer-events:auto!important;transition:transform .18s cubic-bezier(.16,.84,.3,1),visibility 0s linear 0s!important}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.mm-nonlive):not(.vod-skin) body #chpanel.fs-open:not([style*="display: none"]){padding-left:var(--fs-sb,112px)!important;width:calc(50vw + var(--fs-sb,112px))!important}</style>
<style id="umit-sidebar-modern">html.tv-device.umit-fs-on{--fs-sb:132px}html:not(#u).tv-device.umit-fs-on body #sidebar{background:linear-gradient(180deg,var(--bg1) 0%,var(--bg2,var(--bg1)) 100%)!important;border-right:1px solid rgba(251,191,36,.28)!important;padding:12px 8px!important;gap:5px!important;overscroll-behavior:contain}html:not(#u).tv-device.umit-fs-on body #sidebar::before{content:"KATEGORİLER";display:block;flex-shrink:0;padding:2px 8px 8px;margin-bottom:2px;font-size:.6rem;font-weight:800;letter-spacing:.16em;color:var(--acc3,#fbbf24);opacity:.85;border-bottom:1px solid rgba(255,255,255,.07)}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn{position:relative;border-radius:14px!important;min-height:46px!important;border:1px solid transparent!important;background:transparent!important;padding:6px 8px 6px 10px!important;gap:9px!important;transition:transform .12s ease-out!important}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn .ci{width:30px!important;height:30px!important;padding:5px;box-sizing:border-box;border-radius:10px;background:rgba(255,255,255,.07)}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn .cl{font-size:.7rem!important;font-weight:700!important;color:var(--text,#fff)!important;opacity:.82} html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn.on{background:linear-gradient(90deg,rgba(249,115,22,.26),rgba(249,115,22,.06))!important}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn.on .cl{color:var(--acc3,#fbbf24)!important;opacity:1}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn.on .ci{background:rgba(249,115,22,.30)}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn.on::before{content:"";position:absolute;left:0;top:22%;bottom:22%;width:3px;border-radius:0 3px 3px 0;background:var(--acc3,#fbbf24)} html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus,html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus-visible{outline:2px solid var(--acc)!important;outline-offset:-2px!important;box-shadow:none!important;background:linear-gradient(90deg,var(--bord2),var(--bord2))!important;transform:translate3d(4px,0,0)!important;border-radius:14px!important}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus .cl,html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus-visible .cl{color:#fff!important;opacity:1}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus .ci,html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn:focus-visible .ci{background:var(--bord2)}html:not(#u).tv-device.umit-fs-on body #sidebar .catdiv{height:1px!important;background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent)!important;margin:4px 0!important}html:not(#u).tv-device.umit-fs-on body #sidebar .catbtn-exit{border:1px solid rgba(239,68,68,.45)!important;background:rgba(239,68,68,.10)!important}html:not(#u).tv-device.umit-fs-on body #sidebar .cat-search-side .cat-search-inp{border-radius:12px!important;height:36px!important;background:rgba(255,255,255,.06)!important} @keyframes umitCatIn{from{opacity:0;transform:translate3d(-18px,0,0)}to{opacity:1;transform:translate3d(0,0,0)}}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > *{animation:umitCatIn .22s cubic-bezier(.16,.84,.3,1) backwards}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(1){animation-delay:0ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(2){animation-delay:24ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(3){animation-delay:48ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(4){animation-delay:72ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(5){animation-delay:96ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(6){animation-delay:120ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(7){animation-delay:144ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(8){animation-delay:168ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(9){animation-delay:192ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(10){animation-delay:216ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(11){animation-delay:240ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(12){animation-delay:264ms}html:not(#u).tv-device.umit-fs-on.umit-fs-cats:not(.umit-lowend) body #sidebar > :nth-child(13){animation-delay:288ms}html:not(#u).tv-device.umit-fs-on.umit-lowend body #sidebar .catbtn{transition:none!important}@media(prefers-reduced-motion:reduce){html body #sidebar > *{animation:none!important}html body #sidebar .catbtn{transition:none!important}}</style>
<style id="umit-hide-native-controls">video::-webkit-media-controls,video::-webkit-media-controls-enclosure,video::-webkit-media-controls-panel,video::-webkit-media-controls-overlay-enclosure,video::-webkit-media-controls-overlay-play-button,video::-webkit-media-controls-start-playback-button,video::-webkit-media-controls-play-button,video::-webkit-media-controls-timeline,video::-webkit-media-controls-current-time-display,video::-webkit-media-controls-time-remaining-display,video::-webkit-media-controls-mute-button,video::-webkit-media-controls-volume-slider,video::-webkit-media-controls-fullscreen-button,video::-webkit-media-controls-toggle-closed-captions-button,video::-webkit-media-controls-overflow-button,video::-webkit-media-controls-picture-in-picture-button{display:none!important;opacity:0!important;visibility:hidden!important;-webkit-appearance:none!important;pointer-events:none!important}video::-internal-media-controls-overlay-cast-button{display:none!important}.plyr__controls,.plyr__control,.plyr__control--overlaid,.plyr__poster,.plyr__captions,.plyr__menu,.plyr__tooltip,.plyr__progress,.plyr__volume,.plyr__time,.plyr__badge,.plyr__preview-thumb,.plyr__sr-only,.vjs-control-bar,.vjs-big-play-button,.vjs-loading-spinner,.vjs-text-track-display,.vjs-modal-dialog,.vjs-error-display,.vjs-poster,.vjs-menu,.vjs-control-text{display:none!important}</style>
<style id="umit-lite-extra">html.umit-lite *,html.perf-lite *,html.umit-lowend *{backdrop-filter:none!important;-webkit-backdrop-filter:none!important}html.umit-lite #chpanel *:not([class*="spin"]):not([class*="load"]),html.umit-lite #sidebar *:not([class*="spin"]):not([class*="load"]),html.perf-lite #chpanel *:not([class*="spin"]):not([class*="load"]),html.perf-lite #sidebar *:not([class*="spin"]):not([class*="load"]){animation:none!important;transition:none!important}html.umit-lite #chlist,html.umit-lite #sidebar,html.umit-lite #sidebar-catlist,html.perf-lite #chlist,html.perf-lite #sidebar-catlist{scroll-behavior:auto!important}</style>
<style id="umit-net-badge-css">
#umitNetBadge{position:absolute;top:14px;right:14px;z-index:61;display:flex;align-items:center;gap:8px;padding:7px 11px;border-radius:10px;background:rgba(0,0,0,.6);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;font:600 13px/1 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s ease}
#pw.shov #umitNetBadge{opacity:1}
@media(hover:hover){#pw:hover #umitNetBadge{opacity:1}}
html.tv-device #pw:hover #umitNetBadge{opacity:0}
html.tv-device #pw.shov #umitNetBadge{opacity:1}
#app:fullscreen #pw:hover:not(.shov) #umitNetBadge,html.fs-fallback #pw:hover:not(.shov) #umitNetBadge{opacity:0}
#main.pw-mini #umitNetBadge{display:none}
#umitNetBadge .nb-dot{width:7px;height:7px;border-radius:50%;background:#9aa0a6}
#umitNetBadge[data-net="wifi"] .nb-dot,#umitNetBadge[data-net="eth"] .nb-dot{background:#34d399}
#umitNetBadge[data-net="cell"] .nb-dot{background:#fbbf24}
#umitNetBadge[data-net="off"] .nb-dot{background:#ef4444}
#umitNetBadge .nb-type{padding:3px 6px;border-radius:5px;background:rgba(255,255,255,.16);font-size:11px;letter-spacing:.4px}
#umitNetBadge .nb-res{padding-left:8px;border-left:1px solid rgba(255,255,255,.25)}
.umit-stats-panel{top:56px!important}
</style>
</head>
<body>


<div id="setup">
  <div class="brand">
    <div class="brand-badge" id="brand-badge" role="button" tabindex="-1" aria-label="Store'a dön">
     <div class="bb-face bb-front">
      <div class="brand-icon">
        <img id="brand-logo-img" alt="ÜmitTV" style="display:none;width:100%;height:100%;object-fit:contain;padding:5px;border-radius:11px;" onload="if(this.naturalWidth>0){this.style.display='block';this.nextElementSibling.style.display='none';}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
        <span class="brand-icon-fallback" style="display:flex;width:100%;height:100%;align-items:center;justify-content:center;"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3a2 2 0 00-2 2v10a2 2 0 002 2h5l-2 3v1h12v-1l-2-3h5a2 2 0 002-2V5a2 2 0 00-2-2zm0 12H3V5h18v10z"/></svg></span>
      </div>
      <div class="brand-name">ÜmitTV</div>
     </div>
     <div class="bb-face bb-back" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg><span>Store Dön</span></div>
    </div>
  </div>
  <div class="setup-body">
    <div class="scard">
      <div class="stitle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
        Kayıtlı listeler
      </div>
      <div id="saved-list"><div class="no-pl">Henüz liste yok</div></div>
    </div>

    
    <button class="btn-launch" id="btn-launch" onclick="launch()" disabled>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:6px"><path d="M8 5v14l11-7z"/></svg>Başlat
    </button>

    
    <button class="btn-exit" id="setupExitBtn" type="button" onclick="umitExitApp()" aria-label="Çıkış" style="display:none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:8px"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M16 8l4 4-4 4"/><path d="M20 12H9"/></svg>Çıkış
    </button>

    <div class="scard">
      <div class="stitle">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
        Yeni liste ekle
      </div>
      <div class="row2" style="gap:6px;">
        <button class="src-tab on" id="tab-m3u" onclick="setAddTab('m3u')">M3U URL</button>
        <button class="src-tab" id="tab-xt" onclick="setAddTab('xt')">Xtream Codes</button>
        <button class="src-tab" id="tab-local" onclick="setAddTab('local')">Cihazdan Dosya</button>
        <button class="src-tab" id="tab-gh" onclick="setAddTab('gh')">GitHub</button>
      </div>

      <button class="src-tab" id="tab-phone" onclick="PhoneLink.open()" style="width:100%;margin:2px 0 8px;display:flex;align-items:center;justify-content:center;gap:8px"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18h2"/></svg>Telefondan Ekle (QR / kod ile)</button>
      <button class="src-tab" id="tab-vk" onclick="UmitVkMode.cycle()" style="width:100%;margin:0 0 8px;display:flex;align-items:center;justify-content:center;gap:8px"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><rect x="2" y="6" width="20" height="12" rx="2.5"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/></svg><span id="vk-mode-lbl">Sanal klavye: Otomatik</span></button>

      <div id="pane-m3u" style="display:flex;flex-direction:column;gap:9px;">
        <div><div class="ilbl" style="margin-bottom:5px">Liste Adı</div><input class="inp" id="pl-nm" placeholder="Örn: Ev, İş, Kablo..."></div>
        <div><div class="ilbl" style="margin-bottom:5px">M3U URL</div><input class="inp" id="pl-ur" type="url" placeholder="http://sunucu.com/liste.m3u"></div>
        <div><div class="ilbl" style="margin-bottom:5px">EPG URL (Opsiyonel)</div><input class="inp" id="pl-ep" type="url" placeholder="http://sunucu.com/epg.xml"></div>
      </div>

      
      <div id="pane-local" style="display:none;flex-direction:column;gap:9px;">
        <div><div class="ilbl" style="margin-bottom:5px">Liste Adı (Opsiyonel)</div><input class="inp" id="local-nm" placeholder="Boş bırakılırsa dosya adı kullanılır"></div>
        <div>
          <div class="ilbl" style="margin-bottom:5px">M3U / M3U8 / TXT Dosyası</div>
          <input type="file" id="local-file-input" accept="*/*" style="display:none;" onchange="handleLocalM3uFile(this.files&&this.files[0])">
          <button class="btn-sec" style="width:100%;justify-content:center;" onclick="document.getElementById('local-file-input').click()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:5px"><path d="M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
            Cihazdan Dosya Seç
          </button>
          <div id="local-file-name" style="margin-top:6px;font-size:.68rem;color:var(--text2);"></div>
        </div>
        <div id="local-file-status" style="display:none;font-size:.7rem;"></div>
      </div>

      
      <div id="pane-gh" style="display:none;flex-direction:column;gap:9px;">
        <div style="display:flex;gap:9px;">
          <div style="flex:1"><div class="ilbl" style="margin-bottom:5px">GitHub Kullanıcı/Org</div><input class="inp" id="gh-user" placeholder="Örn: umitm0d" onkeydown="if(event.key==='Enter'){event.preventDefault();ghListRepoM3u();}"></div>
          <div style="flex:1"><div class="ilbl" style="margin-bottom:5px">Repo Adı</div><input class="inp" id="gh-repo" placeholder="Örn: iptv-listeler" onkeydown="if(event.key==='Enter'){event.preventDefault();ghListRepoM3u();}"></div>
        </div>
        <div><div class="ilbl" style="margin-bottom:5px">Dal (Opsiyonel — boş bırakılırsa otomatik bulunur)</div><input class="inp" id="gh-branch" placeholder="Örn: main"></div>
        <button class="btn-sec" style="width:100%;justify-content:center;" onclick="ghListRepoM3u()" id="gh-list-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:5px"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0112 6.8c.85 0 1.71.11 2.5.32 1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.01 10.01 0 0022 12c0-5.52-4.48-10-10-10z"/></svg>
          Repodaki M3U Listelerini Tara
        </button>
        <div id="gh-status" style="display:none;font-size:.7rem;"></div>
        <div id="gh-results" style="display:none;flex-direction:column;gap:6px;max-height:260px;overflow-y:auto;"></div>
        <button class="btn-add" style="display:none;" onclick="ghAddSelected()" id="gh-add-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/></svg>Seçilenleri Ekle
        </button>
      </div>

      <div id="pane-xt" style="display:none;flex-direction:column;gap:9px;">
        <div><div class="ilbl" style="margin-bottom:5px">Liste Adı</div><input class="inp" id="xt-nm" placeholder="Örn: Ev, İş, Kablo..."></div>

        <div>
          <div class="ilbl xt-lbl-row" style="margin-bottom:5px"><span>Hazır Xtream Linki (Yapıştır — otomatik doldurur)</span>
            <button type="button" id="xtInfoBtn" class="xt-info-btn" aria-label="Xtream Codes linki hakkında bilgi" aria-expanded="false" aria-controls="xtInfoPop" title="Xtream Codes linki hakkında bilgi">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
            </button>
          </div>
          <div id="xtInfoPop" class="xt-info-pop" role="tooltip" style="display:none">
            <b>Xtream Codes linki nedir?</b>
            <p>IPTV sağlayıcınızın verdiği tek satırlık giriş adresidir. İçinde <b>sunucu adresi:port</b>, <b>kullanıcı adı</b> ve <b>şifre</b> bulunur.</p>
            <p class="xt-ex">http://sunucu.com:8080/get.php?username=<u>KULLANICI</u>&amp;password=<u>ŞİFRE</u>&amp;type=m3u_plus</p>
            <ul>
              <li>Linki yapıştırınca <b>Sunucu / Kullanıcı Adı / Şifre</b> alanları otomatik dolar.</li>
              <li><b>Hesabı Kontrol Et</b> ile durum, başlangıç–bitiş tarihi, kalan gün ve eşzamanlı bağlantı sayısı görülür.</li>
              <li><b>Eşzamanlı bağlantı</b>: aynı anda kaç cihazın izleyebildiği. 1 ise başka cihaz açıkken bu kanal açılmayabilir.</li>
              <li><b>Kumanda:</b> bu ⓘ butonuna gelip <b>OK</b> ile açıp kapatın, <b>Geri</b> ile kapanır.</li>
              <li><b>Dokunmatik:</b> ⓘ butonuna dokunun; tekrar dokununca veya dışarı dokununca kapanır. <b>Fare:</b> üzerine gelmeniz yeterli.</li>
            </ul>
            <p class="xt-warn">⚠ Link şifrenizi içerir, kimseyle paylaşmayın.</p>
          </div>
          <input class="inp" id="xt-paste" type="url" placeholder="http://sunucu.com:8080/get.php?username=...&password=...&type=m3u" oninput="parseXtreamLink(this.value)">
        </div>

        <div style="display:flex;align-items:center;gap:8px;margin:2px 0;">
          <div style="flex:1;height:1px;background:var(--bord);"></div>
          <span style="font-size:.65rem;color:var(--text2);">VEYA MANUEL GİR</span>
          <div style="flex:1;height:1px;background:var(--bord);"></div>
        </div>

        <div><div class="ilbl" style="margin-bottom:5px">Sunucu Adresi</div><input class="inp" id="xt-host" type="url" placeholder="http://sunucu.com:8080"></div>
        <div style="display:flex;gap:9px;">
          <div style="flex:1"><div class="ilbl" style="margin-bottom:5px">Kullanıcı Adı</div><input class="inp" id="xt-user" placeholder="kullanici"></div>
          <div style="flex:1"><div class="ilbl" style="margin-bottom:5px">Şifre</div><input class="inp" id="xt-pass" type="password" placeholder="şifre"></div>
        </div>
        <div class="row2">
          <button class="btn-sec" style="flex:1" onclick="checkXtream()" id="xt-check-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>Hesabı Kontrol Et
          </button>
        </div>
        <div id="xt-info" style="display:none;"></div>
      </div>


      <div class="row2" id="add-actions">
        <button class="btn-add" onclick="addPl()" id="btn-add-m3u" style="flex:1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/></svg>Ekle
        </button>
      </div>
    </div>

    

    
    <details class="scard adv-details" id="adv-details">
      <summary class="stitle adv-summary">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 15.5A3.5 3.5 0 1112 8.5a3.5 3.5 0 010 7zm7.4-3.5c0-.62-.06-1.22-.17-1.8l2.02-1.58a.5.5 0 00.12-.64l-1.92-3.32a.5.5 0 00-.6-.22l-2.39.96a7.5 7.5 0 00-1.56-.9L14.5 2.2a.5.5 0 00-.5-.42h-3.84a.5.5 0 00-.5.42l-.4 2.32c-.56.22-1.08.52-1.56.9l-2.39-.96a.5.5 0 00-.6.22L2.79 8a.5.5 0 00.12.64l2.02 1.58c-.11.58-.17 1.18-.17 1.8s.06 1.22.17 1.8L2.9 15.4a.5.5 0 00-.12.64l1.92 3.32c.14.24.42.32.6.22l2.39-.96c.48.38 1 .68 1.56.9l.4 2.32c.05.24.26.42.5.42h3.84c.24 0 .45-.18.5-.42l.4-2.32c.56-.22 1.08-.52 1.56-.9l2.39.96c.24.1.46.02.6-.22l1.92-3.32a.5.5 0 00-.12-.64l-2.02-1.58c.11-.58.17-1.18.17-1.8z"/></svg>
        Diğer Seçenekler
      </summary>
      <div class="adv-body">
        
        <div class="stitle" style="margin-top:2px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          TEK YAYIN AÇ
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;">
          <div>
            <div class="ilbl" style="margin-bottom:5px">Yayın Linki</div>
            <input class="inp" id="single-play-ur" type="url" placeholder="https://sunucu.com/yayin.m3u8 veya .ts linki" onkeydown="if(event.key==='Enter'){event.preventDefault();openSinglePlayFromInput();}">
          </div>
          <button class="btn-add" onclick="openSinglePlayFromInput()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:4px"><path d="M8 5v14l11-7z"/></svg>Aç
          </button>
        </div>
        <button class="btn-tv" onclick="toggleTV()" style="margin-top:9px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:6px"><path d="M21 3H3a2 2 0 00-2 2v10a2 2 0 002 2h5l-2 3v1h12v-1l-2-3h5a2 2 0 002-2V5a2 2 0 00-2-2zm0 12H3V5h18v10z"/></svg>TV Box Modu: <span id="tvlbl">KAPALI</span>
        </button>
      </div>
    </details>
  </div>
</div>


<div id="loading">
  <div class="ld-badge">
    <img id="ld-logo-img" class="ld-logo-img" alt="ÜmitTV" onerror="this.style.display='none';this.nextElementSibling.style.display='block';">
    <div class="ld-logo" style="display:none;font-size:1.1rem;">ÜmitTV</div>
  </div>
  <div class="ld-bar"><div class="ld-fill" id="ldfill"></div></div>
  <div class="ld-msg" id="ldmsg">YÜKLENIYOR...</div>
  <div id="ldpct" style="font-weight:900;font-size:clamp(1.6rem,6vmin,3.4rem);color:var(--acc2,#fb923c);letter-spacing:.04em;line-height:1">0%</div>
</div>


<div id="app">

  <div id="topbar">
    <div class="tb-logo">ÜmitTV</div>
    <div class="tb-src" onclick="goSetup()" tabindex="0" role="button" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();goSetup();}">
      <div class="src-dot" id="srcdot"></div>
      <span id="srcnm">—</span>
      <span id="srcconn" style="display:none;"></span>
    </div>
    <div class="pl-switch" id="plSwitch" style="display:none;">
      <button class="pls-btn" id="plsPrev" title="Önceki liste" onclick="switchPl(-1)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>
      <button class="pls-btn" id="plsNext" title="Sonraki liste" onclick="switchPl(1)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
      </button>
    </div>
    <button class="pls-refresh-standalone" id="plsRefresh" title="Listeyi yenile" onclick="refreshActivePl()" style="display:none;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08a5.99 5.99 0 01-5.65 4c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L14 11h7V4l-3.35 2.35z"/></svg>
    </button>
    
    <button class="tbbtn" id="tb-settingsbtn" onclick="openAppSettings()" title="Ayarlar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
      <span>Ayarlar</span>
    </button>
    <button class="tbbtn" id="tb-pagefsbtn" onclick="umitTogglePageFs()" title="Tam Ekran (uygulamayı tam ekranda göster/kapat)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      <span id="tb-pagefs-t">Tam Ekran</span>
    </button>
    <div id="mmtabs" class="mmtabs">
      <button class="mmtab on" data-m="live" onclick="onLiveTabClick()">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3a2 2 0 00-2 2v10a2 2 0 002 2h5l-2 3v1h12v-1l-2-3h5a2 2 0 002-2V5a2 2 0 00-2-2zm0 12H3V5h18v10z"/></svg>
        <span>Canlı TV</span>
      </button>
      
      <button class="tbbtn" id="tb-folderbtn" title="Klasörlerim">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H2v16h20V6H12l-2-2z"/></svg>
      <span>Klasör</span>
    </button>
      
      <button class="mmtab" id="discover-tab-btn" data-m="discover" onclick="setMediaMode('discover')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
        <span>Keşfet</span>
      </button>
      
      <button class="tbbtn hm" id="whatBtn" onclick="openWhatToWatch()" title="Bugün Ne İzlesem?">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/></svg>
      <span>Bugün Ne İzlesem?</span>
    </button>
      <button class="mmtab" data-m="vod" onclick="setMediaMode('vod')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V4h-4z"/></svg>
        <span>Filmler</span>
      </button>
      <button class="mmtab" data-m="series" onclick="setMediaMode('series')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16a1 1 0 011 1v11a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1zm2-3h12v2H6V3zm-2 7h16v2H4v-2z"/></svg>
        <span>Diziler</span>
      </button>
      <button class="mmtab" data-m="new" onclick="setMediaMode('new')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.39 6.55L21 9l-5 4.36L17.45 20 12 16.5 6.55 20 8 13.36 3 9l6.61-.45L12 2z"/></svg>
        <span>Son Eklenenler</span>
      </button>
    </div>
    <div class="tb-btns">
      <button class="tbbtn hm" onclick="toggleEPG()" id="epgtb">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5C3.9 3 3 3.9 3 5v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
        <span>EPG</span>
      </button>
      <button class="tbbtn hm" onclick="toggleHelp()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 5H4a1 1 0 00-1 1v10a1 1 0 001 1h3v3l4-3h9a1 1 0 001-1V6a1 1 0 00-1-1zm-9 10H9v-2h2v2zm3.5-4c-.5.7-1.2 1-1.5 1.3V13h-2v-2.5l.8-.5c.7-.5 1.2-.9 1.2-1.5a1 1 0 00-2 0h-2a3 3 0 016 0c0 1.2-.7 2-2.5 3z"/></svg>
      </button>
      <button class="tbbtn" id="voiceCmdBtn" onclick="toggleVoiceCommand()" title="Sesli Komut">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14a3 3 0 003-3V5a3 3 0 00-6 0v6a3 3 0 003 3zm5-3a5 5 0 01-10 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-2z"/></svg>
      </button>
      
      <button class="tbbtn" id="voiceInfoBtn" onclick="toggleVoiceInfo()" title="Sesli Komutlar Listesi">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11 7h2v2h-2V7zm0 4h2v6h-2v-6zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
      </button>
      <button class="tbbtn" id="xtTopInfoBtn" type="button" style="display:none" title="Xtream Codes linki hakkında bilgi" aria-label="Xtream Codes linki hakkında bilgi" aria-expanded="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18v2H3zm0 6h18v2H3zm0 6h12v2H3z"/><path d="M19 14.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7zm-.5 1.5h1v1h-1zm0 2h1v2h-1z" fill="var(--acc3,#f59e0b)"/></svg>
      </button>
      <div id="voiceInfoScrim"></div>
      <div id="voiceInfoPanel" class="voice-info-panel"></div>
      <button class="tbbtn" id="tb-orientbtn" onclick="umitCycleOrient()" title="Ekran Yönü: Otomatik / Yatay / Dikey">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.48 2.52c3.27 1.55 5.61 4.72 5.97 8.48h1.5C23.44 4.84 18.29 0 12 0l-.66.03 3.81 3.81 1.33-1.32zm-6.25-.77a2.003 2.003 0 00-2.83 0L1.75 7.4a2.003 2.003 0 000 2.83l12.02 12.02c.78.78 2.05.78 2.83 0l5.65-5.65c.78-.78.78-2.05 0-2.83L10.23 1.75zm4.6 19.44L2.81 9.17l6.36-6.36 12.02 12.02-6.36 6.36zm-7.31.29C4.25 19.94 1.91 16.76 1.55 13H.05C.56 19.16 5.71 24 12 24l.66-.03-3.81-3.81-1.33 1.32z"/></svg>
        <span id="tb-orient-lbl">Otomatik</span>
      </button>
      <button class="tbbtn" id="tb-fitbtn" onclick="cycleFit()" title="Görüntü Modu (Z)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3v18h18V3zm-2 16H5V5h14v14zm-4-4h-4v-4h4v4z"/></svg>
        <span id="tb-fit-lbl">Sığdır</span>
      </button>
      <button class="tbbtn" onclick="doFullscreen()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      </button>
      <button class="tbbtn" id="castbtn" onclick="doCast()" title="Ekrana Yansıt" style="display:none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm18-7H5v1.63c3.96 1.28 7.09 4.41 8.37 8.37H19V7zM1 10v2c4.97 0 9 4.03 9 9h2c0-6.08-4.93-11-11-11zm20-7H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
      </button>
    </div>
  </div>


  <div id="body">

    <div id="sidebar"></div>

    <div id="chpanel">
      <div id="chpanel-search">
        <div class="sw" id="live-search-wrap">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19l-4.35-4.35A7 7 0 103.5 10.5a7 7 0 008.15 6.85L16 21.5 21 19zm-10-3a5 5 0 110-10 5 5 0 010 10z"/></svg>
          <input id="srch" placeholder="Kanal ara..." oninput="doSearch(this.value)" autocomplete="off" enterkeyhint="search" autocapitalize="off" spellcheck="false">
          <button type="button" id="srchMic" aria-label="Sesle ara" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:0;color:inherit;opacity:.7;padding:4px;cursor:pointer;display:none"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14a3 3 0 003-3V5a3 3 0 10-6 0v6a3 3 0 003 3zm5-3a5 5 0 01-10 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-2z"/></svg></button>
          <div id="srchHist" style="display:none;position:absolute;left:0;right:0;top:100%;z-index:80;margin-top:4px;background:var(--bg2,#1a1d26);border:1px solid rgba(255,255,255,.12);border-radius:10px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.45)"></div>
        </div>
        <div class="sw" id="vod-search-wrap" style="display:none;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19l-4.35-4.35A7 7 0 103.5 10.5a7 7 0 008.15 6.85L16 21.5 21 19zm-10-3a5 5 0 110-10 5 5 0 010 10z"/></svg>
          <input id="vodsrch" placeholder="Film / dizi ara..." oninput="doVodSearch(this.value)" autocomplete="off" enterkeyhint="search" autocapitalize="off" spellcheck="false">
        </div>
      </div>
      <div id="mob-cats"></div>
      <div id="chpanel-toolbar">
        <button id="chHomeBtn" class="chvt-btn" type="button" onclick="umitGoStoreHome()" title="Mağazaya dön (Ana sayfa)" aria-label="Ana sayfa" style="display:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        </button>
        <button id="chExitBtn" class="chvt-btn chvt-danger" type="button" onclick="umitExitApp()" title="Uygulamadan çık" aria-label="Çıkış" style="display:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M16 8l4 4-4 4"/><path d="M20 12H9"/></svg>
          <span>Çıkış</span>
        </button>
        <button id="chViewToggle" class="chvt-btn" onclick="toggleChView()" title="Görünümü Değiştir"></button>
        <button id="chEpgRefreshBtn" class="chvt-btn" type="button" onclick="umitEpgRefresh()" title="EPG (yayın akışı) verisini yeniden indir" aria-label="EPG Yenile"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg><span>EPG Yenile</span></button>
        <button id="chEpgToastBtn" class="chvt-btn on" type="button" role="checkbox" aria-checked="true" onclick="umitToggleEpgToast()" title="EPG bilgi kartı" aria-label="EPG Bilgi Kartı"><span class="chan-tick"></span><span>EPG Bilgi Kartı</span></button>
        <button id="chActNavBtn" class="chvt-btn on" type="button" role="checkbox" aria-checked="true" onclick="toggleChActNav()" title="Alt butonları kumandada kullan"><span class="chan-tick"></span><span>Alt Butonlar</span></button>
        <button id="fsQuickPlBtn" class="chvt-btn" onclick="toggleFsQuickPlMenu()" title="Hızlı Liste Değiştir" style="display:none;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"/></svg>
          <span id="fsQuickPlLabel">Liste</span>
        </button>
        <div id="fsQuickPlMenu" class="fs-quickpl-menu" style="display:none;"></div>
        <button id="chClearRecBtn" class="chvt-btn chvt-danger" style="display:none;" onclick="confirmClearRecentCh()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19a2 2 0 002 2h8a2 2 0 002-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
          <span>Geçmişi Sil</span>
        </button>
        <button id="chResetOrderBtn" class="chvt-btn" style="display:none;" onclick="resetChOrder()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 8c-2.65 0-5.05 1-6.9 2.6L2 7v9h9l-3.62-3.62A7.96 7.96 0 0112.5 10c3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 10.72 17.19 8 12.5 8z"/></svg>
          <span>Sırayı Sıfırla</span>
        </button>
        <button id="chDelCatBtn" class="chvt-btn chvt-danger" style="display:none;" onclick="confirmDeleteCurUserCat()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19a2 2 0 002 2h8a2 2 0 002-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
          <span>Klasörü Sil</span>
        </button>
      </div>
      
      <div id="chFlipWrap">
        <div id="chFlipInner">
          <div id="chlist" class="chflip-face chflip-front"></div>
          <div id="chFlipEpgPane" class="chflip-face chflip-back">
            <div id="chFlipEpgHdr">
              <button id="chFlipEpgBack" onclick="closeChFlipEpg()" title="Kanal Listesine Dön">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
              </button>
              <div id="chFlipEpgChName"></div>
            </div>
            <div id="chFlipEpgList"></div>
          </div>
        </div>
      </div>
    </div>

    
    <div id="vodview" style="display:none;">
      <div id="vodContinueRow" style="display:none;"></div>
      <div id="vodcats"></div>
      <div id="vodgrid-wrap">
        <div id="vodgrid"></div>
        <div id="seriesdetail" style="display:none;"></div>
        <div id="discoverview" style="display:none;"></div>
      </div>
    </div>

    
    
    <div id="wtwModal" class="detail-modal wtw-modal" style="display:none;" role="dialog" aria-label="Bugün Ne İzlesem?">
      <div class="dm-body wtw-body" tabindex="-1">
        <div class="wtw-top">
          <button class="dm-close" onclick="closeWhatToWatch()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>Geri
          </button>
        </div>
        <div class="wtw-hero">
          <div class="wtw-hero-ico">
            <svg width="26" height="26" viewBox="0 0 24 24"><path d="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/></svg>
          </div>
          <div class="wtw-hero-txt">
            <div class="wtw-title">Bugün Ne İzlesem?</div>
            <div class="wtw-sub">Filtreni seç, gerisini zara bırak.</div>
          </div>
        </div>
        <div class="wtw-card">
          <div class="wtw-lbl">İçerik Türü</div>
          <div class="wtw-seg" id="wtwType">
            <button class="wtw-seg-btn on" data-v="all">Tümü</button>
            <button class="wtw-seg-btn" data-v="vod">Filmler</button>
            <button class="wtw-seg-btn" data-v="series">Diziler</button>
          </div>
          <div class="wtw-lbl">Asgari IMDB Puanı</div>
          <div class="wtw-seg wtw-seg4" id="wtwRating">
            <button class="wtw-seg-btn on" data-v="0">Tümü</button>
            <button class="wtw-seg-btn" data-v="7">7.0+</button>
            <button class="wtw-seg-btn" data-v="8">8.0+</button>
            <button class="wtw-seg-btn" data-v="8.5">8.5+</button>
          </div>
          <div class="wtw-lbl">Kategori</div>
          <div class="wtw-step" id="wtwCatStep">
            <button class="wtw-step-btn" data-d="-1" aria-label="Önceki kategori"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg></button>
            <button class="wtw-step-val" id="wtwCatLbl" data-d="1"><span id="wtwCatTxt">Tüm Kategoriler</span><small id="wtwCatIdx"></small></button>
            <button class="wtw-step-btn" data-d="1" aria-label="Sonraki kategori"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg></button>
          </div>
          <select id="wtwCat" tabindex="-1" aria-hidden="true" style="display:none;"><option value="__ALL__">Tüm Kategoriler</option></select>
        </div>
        <button class="wtw-roll" id="wtwRoll" onclick="rollWhatToWatch()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zM8.5 17a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm0-9a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm3.5 4.5A1.5 1.5 0 1112 9a1.5 1.5 0 010 3.5zM15.5 17a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm0-9a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/></svg>
          <span>ŞANSIMI DENE / ZAR AT</span>
        </button>
        <div class="wtw-empty" id="wtwEmpty" style="display:none;">Bu filtrelere uyan içerik bulunamadı.</div>
      </div>
    </div>

    <div id="detailModal" class="detail-modal" style="display:none;">
      <div class="dm-bg" id="dmBg"><img id="dmBgImg" src="" alt=""></div>
      <div class="dm-body" id="dmBody" tabindex="0">
        <button class="dm-close" onclick="closeDetailModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>Geri
        </button>
        <div class="dm-hero">
          <div class="dm-poster"><img id="dmPoster" src="" alt=""></div>
          <div class="dm-info">
            <div class="dm-title" id="dmTitle"></div>
            <div class="dm-meta" id="dmMeta"></div>
          </div>
        </div>
        <div class="dm-actions" id="dmActions"></div>
        <div class="dm-section" id="dmOverviewSec">
          <div class="dm-h">📝 Özet</div>
          <div class="dm-overview" id="dmOverview">Yükleniyor...</div>
        </div>
        <div class="dm-section" id="dmGenresSec" style="display:none;">
          <div class="dm-h">Türler</div>
          <div class="dm-genres" id="dmGenres"></div>
        </div>
        <div class="dm-section" id="dmCastSec" style="display:none;">
          <div class="dm-h">Oyuncular</div>
          <div class="dm-cast" id="dmCast"></div>
        </div>
        <div class="dm-section" id="dmDirSec" style="display:none;">
          <div class="dm-h">Yönetmen</div>
          <div class="dm-cast" id="dmDir"></div>
        </div>
      </div>
    </div>

    
    <div id="libSearchModal">
      <div class="ls-card">
        <div class="ls-poster" id="lsPoster"><img src="" alt=""></div>
        <div class="ls-title" id="lsTitle"></div>
        <div class="ls-status" id="lsStatus">Kütüphanenizde aranıyor...</div>
        <div class="ls-progress"><div class="ls-progress-fill" id="lsProgFill" style="width:0%"></div></div>
        <div class="ls-results" id="lsResults" style="display:none;"></div>
        <button class="ls-close" onclick="closeLibSearchModal()">Kapat</button>
      </div>
    </div>

    
    <div id="resumeDelModal">
      <div class="rdm-card">
        <div class="rdm-poster" id="rdmPoster"><img src="" alt=""></div>
        <div class="rdm-title" id="rdmTitle"></div>
        <div class="rdm-sub">Bu kaydı "Kaldığın Yerde" listesinden silmek istiyor musun?</div>
        <div class="rdm-btns">
          <button class="rdm-btn" onclick="closeResumeDelModal()">Vazgeç</button>
          <button class="rdm-btn rdm-btn-danger" onclick="confirmResumeDel()">Sil</button>
        </div>
      </div>
    </div>

    <div id="main">

      <div id="pw">
        <video id="vid" poster="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" autoplay playsinline webkit-playsinline autopictureinpicture referrerpolicy="no-referrer"></video>
        
        <div id="pw-brand" aria-hidden="true"><img id="pw-brand-img" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='block';"><div class="pwb-txt" style="display:none">ÜmitTV</div><div id="pwb-load"></div><div id="pwPctA">0%</div><div id="pwMsgA"></div></div>
        
        <div id="pw-pause" aria-hidden="true"><img id="pw-pause-img" alt=""><div class="pwp-txt">Duraklatıldı</div></div>
        <div id="umitNetBadge" aria-hidden="true"><span class="nb-dot"></span><span class="nb-type" id="umitNetType">AĞ</span><span class="nb-mbps" id="umitNetMbps">…</span><span class="nb-res" id="umitNetRes" style="display:none"></span></div>
        <canvas id="ch-freeze" style="position:absolute;inset:0;width:100%;height:100%;z-index:5;display:none;object-fit:inherit;"></canvas>
        
        <div class="umit-stats-panel" id="umitStatsPanel" style="display:none;">
          <div class="umit-stats-header"><span>YAYIN BİLGİSİ</span></div>
          <div class="umit-stats-row"><span class="umit-stats-label">Çözünürlük:</span><span class="umit-stats-value" id="umitStatRes">Bekleniyor</span></div>
          <div class="umit-stats-row"><span class="umit-stats-label">Kare Hızı (FPS):</span><span class="umit-stats-value" id="umitStatFps">Bekleniyor</span></div>
          <div class="umit-stats-row"><span class="umit-stats-label">Bit Hızı:</span><span class="umit-stats-value" id="umitStatBit">Bekleniyor</span></div>
          <div class="umit-stats-row"><span class="umit-stats-label">Video Codec:</span><span class="umit-stats-value" id="umitStatVc">Bekleniyor</span></div>
          <div class="umit-stats-row"><span class="umit-stats-label">Ses:</span><span class="umit-stats-value" id="umitStatAud">Bekleniyor</span></div>
        </div>
        <button class="pw-mini-hit" id="pwMiniHit" title="Tam ekrana dön / sürükleyerek taşı" aria-label="Tam ekrana dön"></button>
        <div class="pw-mini-chrome" id="pwMiniChrome">
          <div class="pw-mini-topbar">
            <span class="pw-mini-live-dot"></span>
            <span class="pw-mini-label" id="pwMiniLabel"></span>
          </div>
          <button class="pw-mini-close" id="pwMiniClose" title="Kapat" aria-label="Oynatıcıyı kapat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          <button class="pw-mini-expand" id="pwMiniExpand" title="Tam ekrana dön" aria-label="Tam ekrana dön">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
          </button>
          <div class="pw-mini-progress"><div class="pw-mini-progress-fill" id="pwMiniProgressFill"></div></div>
        </div>
        <iframe id="embedFrame" style="display:none;position:absolute;inset:0;width:100%;height:100%;border:0;background:#000" allow="autoplay; fullscreen; encrypted-media" allowfullscreen></iframe>
        <div id="spin"></div>

        <div id="dbl-hint">
          <div class="dbl-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg></div>
          <div class="dbl-lbl" id="dbl-lbl">Tam Ekran</div>
        </div>

        
        
        
        <div id="voice-listen-scrim" onclick="voiceCloseListenModal()" ontouchend="voiceCloseListenModal()"></div>
        <div id="voice-listen-modal" onclick="voiceCloseListenModal()" ontouchend="voiceCloseListenModal()">
          <div class="vlm-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5-3c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
          </div>
          <div class="vlm-lbl">Sizi dinliyorum...</div>
          <div class="vlm-sub">Bir komut söyleyin</div>
          <div class="vlm-close-hint">Kapatmak için dokunun</div>
        </div>


        <div id="seek-toast">
          <svg id="seek-toast-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
          <div class="seek-toast-txt">
            <div class="seek-toast-delta" id="seek-toast-delta"></div>
            <div class="seek-toast-abs" id="seek-toast-abs"></div>
          </div>
        </div>

        <div id="ch-transition">
          <div class="ct-card">
            <div class="ct-top">
              <div class="ct-logo-wrap">
                <div class="ct-logo-ring"></div>
                <div class="ct-logo-inner" id="ct-logo-inner"></div>
              </div>
              <div class="ct-info">
                <div class="ct-badge-row">
                  <div class="ct-now-badge">ŞİMDİ</div>
                  <div class="ct-num-badge" id="ct-num"></div>
                </div>
                <div class="ct-ch-name" id="ct-ch-name"></div>
              </div>
              <div class="ct-ch-time" id="ct-ch-time"></div>
            </div>
            <div class="ct-tech" id="ct-tech" style="display:none">
              <span class="ct-res-badge" id="ct-res-badge"></span>
              <span class="ct-tech-pill" id="ct-tech-res"></span>
              <span class="ct-tech-dot"></span>
              <span class="ct-tech-pill" id="ct-tech-aud"></span><span class="ct-tech-dot" id="ct-dot-vc" style="display:none"></span><span class="ct-tech-pill" id="ct-tech-vc" style="display:none"></span><span class="ct-tech-dot" id="ct-dot-fps" style="display:none"></span><span class="ct-tech-pill" id="ct-tech-fps" style="display:none"></span><span class="ct-tech-dot" id="ct-dot-br" style="display:none"></span><span class="ct-tech-pill" id="ct-tech-br" style="display:none"></span>
            </div>
            <div class="ct-epg" id="ct-epg">
              <div class="ct-epg-now">
                <div class="ct-epg-title" id="ct-epg-title"></div>
                <span class="ct-epg-left" id="ct-epg-left"></span>
              </div>
              <div class="ct-epg-desc" id="ct-epg-desc"></div>
              <div class="ct-prog"><div class="ct-prog-fill" id="ct-prog-fill" style="width:0%"></div></div>
            </div>
            <div class="ct-next" id="ct-next" style="display:none">
              <div class="ct-next-chip"><div class="ct-next-lbl">SIRADA</div><div class="ct-next-time" id="ct-next-time"></div></div>
              <div class="ct-next-title" id="ct-next-title"></div>
            </div>
          </div>
        </div>

        <div class="gest-hint" id="gh-left">
          <div class="gh-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 7a5 5 0 100 10 5 5 0 000-10zm0-5a1 1 0 011 1v2a1 1 0 01-2 0V3a1 1 0 011-1zm0 17a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1zM4.22 4.22a1 1 0 011.42 0l1.41 1.41a1 1 0 11-1.41 1.42L4.22 5.64a1 1 0 010-1.42zm12.73 12.73a1 1 0 011.41 0l1.42 1.41a1 1 0 01-1.42 1.42l-1.41-1.42a1 1 0 010-1.41zM1 12a1 1 0 011-1h2a1 1 0 010 2H2a1 1 0 01-1-1zm17 0a1 1 0 011-1h2a1 1 0 010 2h-2a1 1 0 01-1-1zM4.22 19.78a1 1 0 010-1.41l1.41-1.42a1 1 0 111.42 1.42l-1.42 1.41a1 1 0 01-1.41 0zM16.95 4.22a1 1 0 010 1.42l-1.41 1.41a1 1 0 11-1.42-1.41l1.42-1.42a1 1 0 011.41 0z"/></svg></div>
          <div class="gh-label" id="gh-left-lbl">Parlaklık</div>
          <div class="gh-val" id="gh-left-val"></div>
        </div>
        <div class="gest-hint" id="gh-right">
          <div class="gh-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path id="gh-right-path" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg></div>
          <div class="gh-label" id="gh-right-lbl">Ses</div>
          <div class="gh-val" id="gh-right-val"></div>
        </div>
        <div class="gest-hint" id="gh-center">
          <div class="gh-icon" id="gh-cen-ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></div>
          <div class="gh-label" id="gh-cen-lbl">Sonraki</div>
        </div>
        <div class="gest-hint" id="gh-mute">
          <div class="gh-icon" id="gh-mute-ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3z"/></svg></div>
          <div class="gh-label" id="gh-mute-lbl">Ses Açık</div>
        </div>
        <div id="fs-chlist-backdrop"></div>

        <div id="ov">
          
          <div class="ov-top">
            
            <div class="vs-topbar">
              <button class="vs-top-btn" onclick="closeVodPlayer()" title="Geri">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
              </button>
              <button class="vs-top-btn" onclick="vsTogglePip()" title="PiP Modu">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 7h-8v6h8V7zm2-4H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.98h18v14.03z"/></svg>
              </button>
              
              <button class="vs-top-btn" id="episodes-vs-btn" onclick="openEpisodesQuickPanel()" title="Bölümler" style="display:none;">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4zm12-1l4 3-4 3v-6z"/></svg>
              </button>
              <button class="vs-top-btn" onclick="openVodSettings()" title="Ayarlar">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg>
              </button>
            </div>
            <div class="ov-ci">
              <div class="ov-nm" id="ovnm">Kanal Seçin</div>
              <div class="ov-pr" id="ovpr"></div>
            </div>
          </div>

          <div class="ov-bot">
            <div class="prog-wrap">
              <div class="scrub-preview" id="scrubPreview" style="display:none;">
                <canvas id="scrubCanvas" width="160" height="90"></canvas>
                <div class="scrub-time" id="scrubTime"></div>
              </div>
              <div class="prog-bar" id="progbar">
                <div class="prog-buf" id="progbuf" style="width:0%"></div>
                <div class="prog-fill" id="progfill" style="width:0%"><div class="prog-fill-knob"></div></div>
                <div class="prog-bar-hit" id="progbarhit"></div>
              </div>
              <div class="prog-times"><span id="progs"></span><span id="proge"></span></div>
            </div>
            
            <div class="ov-acts-row" id="ovActsRow">
              <button class="ov-btn" id="vod-back-btn" onclick="closeVodPlayer()" style="display:none;" title="Listeye Dön">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                <span>Geri</span>
              </button>
              
              <button class="ov-btn" onclick="toggleVodDebugPanel()" title="Debug Log">                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 2v2h6V2h2v2h1a2 2 0 012 2v13a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h1V2h2zm10 8H5v9h14v-9zm-4.5 2a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg>
                <span>DBG</span>
              </button>
              <button class="ov-btn" id="fav-ov-btn" onclick="toggleFavCur()" title="Favorilere Ekle">
                <svg viewBox="0 0 24 24" fill="currentColor" id="fav-ov-ico"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                <span id="fav-ov-lbl">Favori</span>
              </button>
              <button class="ov-btn" onclick="toggleEPG()" id="ov-epgbtn">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5C3.9 3 3 3.9 3 5v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
                <span>EPG</span>
              </button>
              <button class="ov-btn" id="fitbtn" onclick="cycleFit()" title="Görüntü Modu">
                <svg id="fit-ov-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3v18h18V3zm-2 16H5V5h14v14z"/></svg>
                <span id="fit-lbl">Sığdır</span>
              </button>
              
              <button class="ov-btn" id="quality-ov-btn" onclick="openQualityQuickPanel()" title="Kalite" style="display:none;">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/></svg>
                <span id="quality-ov-lbl">Kalite</span>
              </button>
              <button class="ov-btn" id="ov-folderbtn" title="Klasörlerim">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H2v16h20V6H12l-2-2z"/></svg>
                <span>Klasör</span>
              </button>
              
              <button class="ov-btn" id="vod-settings-btn" onclick="openVodSettings()" title="Ayarlar" style="display:none;">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                <span>Ayarlar</span>
              </button>
              
              <button class="ov-btn ov-secondary ov-keep-tv" onclick="openCurrentInExternalPlayer()" title="Harici Oynatıcıda Aç">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7z"/></svg>
                <span>Harici Oynatıcı</span>
              </button>
              
              <button class="ov-btn ov-secondary" id="rec-btn" onclick="toggleRecording()" title="Yayını Kaydet" style="display:none;">
                <div class="rec-dot"></div>
                <span id="rec-btn-lbl">Kayıt</span>
              </button>
              <button class="ov-btn ov-secondary" id="rec-lib-btn" onclick="openRecLibrary()" title="Kayıtlarım" style="display:none;">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/></svg>
                <span>Kayıtlar</span>
              </button>
              <button class="ov-btn" onclick="doFullscreen()">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                <span>Tam Ekran</span>
              </button>
            </div>
            <div class="ctrl-row">
              <button class="icbtn sm" onclick="prevCh()" title="Önceki Kanal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
              </button>
              <button class="icbtn lg" id="ppbtn" onclick="togglePlay()">
                <svg id="pp-ico" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path id="pp-path" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <button class="icbtn sm" onclick="nextCh()" title="Sonraki Kanal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm2.5-6l5.5 4-5.5 4V6l5.5 4z" opacity=".01"/><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
              </button>
              <div class="vol-wrap">
                <button class="icbtn sm" id="volbtn" onclick="toggleMute()" style="width:28px;height:28px;">
                  <svg id="vol-ico" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path id="vol-path" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                </button>
                <input type="range" class="vol-sl" min="0" max="1" step="0.05" value="1" oninput="setVol(this.value)" id="volsl" ontouchstart="event.stopPropagation()" ontouchmove="event.stopPropagation()" style="background:linear-gradient(90deg,var(--acc) 100%,rgba(255,255,255,.22) 100%);">
              </div>
              <div class="ch-badge" id="chbadge"></div>
              
              <button id="ctrlsExpandBtn" onclick="toggleCtrlsExpanded()" title="Diğer kontroller" aria-label="Diğer kontrolleri göster/gizle" aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </button>
            </div>
          </div>
        </div>

        
        <div id="vodSettingsScrim" onclick="closeVodSettings()"></div>
        <div id="vodSettingsPanel">
          <div id="vs-main" class="vs-page">
            <div class="vs-head"><span>Ayarlar</span></div>
            <button class="vs-row" onclick="vsExternalOpen()">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Harici Aç</span><span class="vs-row-s">VLC, MX Player vb.</span></span>
            </button>
            
            <button class="vs-row" onclick="toggleVodDebugPanel();closeVodSettings();">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 2v2h6V2h2v2h1a2 2 0 012 2v13a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h1V2h2zm10 8H5v9h14v-9zm-4.5 2a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Hata Kaydı (Debug)</span><span class="vs-row-s">Oynatma günlüğünü göster/kopyala</span></span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('audio')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Ses</span><span class="vs-row-s" id="vs-audio-val">Varsayılan</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('sub')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6zm0 4h6v2H6zm8 0h4v2h-4zm-4-4h8v2h-8z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Altyazı</span><span class="vs-row-s" id="vs-sub-val">Kapalı</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('speed')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 12c0-4.42-3.58-8-8-8s-8 3.58-8 8 3.58 8 8 8 8-3.58 8-8zm-8.5 3V8h1v6.5l4.5 2.7-.5.85L11.5 15z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Hız</span><span class="vs-row-s" id="vs-speed-val">1.0x</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('fit')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3v18h18V3zm-2 16H5V5h14v14zm-4-4h-4v-4h4v4z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Görüntü Oranı</span><span class="vs-row-s" id="vs-fit-val">Sığdır</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" id="vs-quality-row" onclick="vsOpenSub('quality')" style="display:none;">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Kalite</span><span class="vs-row-s" id="vs-quality-val">Otomatik</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('fx')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 16a7 7 0 010-14v14z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Görüntü Ayarları</span><span class="vs-row-s">Parlaklık · Kontrast · Doygunluk</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsOpenSub('sleep')">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 20c4.42 0 8-3.58 8-8s-3.58-8-8-8-8 3.58-8 8 3.58 8 8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Uyku</span><span class="vs-row-s" id="vs-sleep-val">Kapalı</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" id="vs-stats-row" onclick="vsToggleStats()">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Gelişmiş İstatistikler</span><span class="vs-row-s" id="vs-stats-val">Kapalı</span></span>
              <span class="vs-chev">›</span>
            </button>
            <button class="vs-row" onclick="vsToggleOrientLock()">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M15.55 5.55L11 1v3.07C7.06 4.56 4 7.92 4 12s3.05 7.44 7 7.93v-2.02c-2.84-.48-5-2.94-5-5.91s2.16-5.43 5-5.91V10l4.55-4.45zM19.93 11c-.17-1.39-.72-2.73-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47h2.02zM13 17.9v2.02c1.39-.17 2.74-.71 3.9-1.61l-1.44-1.44c-.75.54-1.59.89-2.46 1.03zm3.89-2.42l1.42 1.41c.9-1.16 1.45-2.5 1.62-3.89h-2.02c-.14.87-.48 1.72-1.02 2.48z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Yön Kilidi</span><span class="vs-row-s" id="vs-orient-val">Kapalı</span></span>
            </button>
            <button class="vs-row" onclick="vsTogglePip()">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 7h-8v6h8V7zm2-4H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.98h18v14.03z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">PiP Modu</span><span class="vs-row-s" id="vs-pip-val">Küçük Ekran</span></span>
            </button>
            <div class="vs-sep"></div>
            <button class="vs-row" onclick="vsLockScreen()">
              <span class="vs-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10z"/></svg></span>
              <span class="vs-row-txt"><span class="vs-row-t">Kilitle</span><span class="vs-row-s">Kilitle</span></span>
            </button>
          </div>

          <div id="vs-sub" class="vs-page" style="display:none;">
            <div class="vs-head"><button class="vs-back" onclick="vsBackOrClose()">‹</button><span id="vs-sub-title"></span></div>
            <div id="vs-sub-body"></div>
          </div>
        </div>

        
        <div id="vs-stats-overlay"></div>

        
        <div id="vs-lock-overlay" onclick="vsUnlockTap()">
          <div class="vs-lock-hint"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10z"/></svg><span>Kilidi açmak için dokun</span></div>
        </div>

        <div id="resume-hint"></div>

        <div id="fmt-modal">
          <div class="fmt-card">
            <div class="fmt-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg></div>
            <div class="fmt-ttl">Desteklenmeyen Format</div>
            <div class="fmt-txt">Bu içerik tarayıcıda oynatılamıyor. Cihazınızdaki bir video oynatıcıda (VLC, MX Player vb.) açabilirsiniz.</div>
            <div class="fmt-btns">
              <button class="fmt-btn" tabindex="0" onclick="openInDevicePlayer()">Cihazda Aç</button>
            </div>
            <div class="fmt-ext" id="fmt-ext" style="display:none">
              <div class="fmt-ext-ttl">Harici oynatıcı yüklü değil mi? Hemen indir</div>
              <div class="fmt-ext-list" id="fmt-ext-list"></div>
            </div>
            <button class="fmt-debug-btn" tabindex="0" onclick="toggleVodDebugPanel()">Hata Kaydı (Debug)</button>
            <button class="fmt-close" tabindex="0" onclick="closeFmtModal()">Kapat</button>
          </div>
        </div>

        <div id="vod-debug-panel">
          <div id="vod-debug-hdr">
            <span class="vdl-title"><span class="vdl-dot"></span>VOD Hata Kaydı<span class="vdl-count" id="vdl-count">0</span></span>
            <span class="vdl-actions">
              <button class="vdl-copy-btn" id="vdl-copy-btn" onclick="copyVodDebugLog()" title="Tümünü Kopyala">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                <span class="vdl-btn-label">Tümünü Kopyala</span>
              </button>
              <button onclick="clearVodDebugLog()" title="Temizle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z"/></svg>
                <span class="vdl-btn-label">Temizle</span>
              </button>
              <button onclick="toggleVodDebugPanel()" title="Kapat">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </span>
          </div>
          <div id="vod-debug-body"></div>
        </div>

        <div id="extplay-overlay">
          <div class="extplay-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>
          <div class="extplay-ttl">Harici Oynatıcıda Oynatılıyor</div>
          <div class="extplay-txt">Yayın şu an cihazınızdaki video oynatıcıda açık. Buraya dönmek için oynatıcıyı kapatın ya da geri tuşuna basın.</div>
          <button class="extplay-btn" onclick="closeExtplayOverlay()">Geri Dön</button>
        </div>

        <div id="chinfo-modal">
          <div class="fmt-card">
            <div class="fmt-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3a2 2 0 00-2 2v10a2 2 0 002 2h5l-2 3v1h12v-1l-2-3h5a2 2 0 002-2V5a2 2 0 00-2-2zm0 12H3V5h18v10z"/></svg></div>

            <div class="fmt-ttl">Kanal Listesi</div>
            <div class="fmt-txt">Kanal listesi paneli bazen kapanabilir. Tekrar görmek için üstteki <b>Canlı TV</b> butonuna dokunman yeterli.</div>
            <label class="chinfo-chk-row">
              <input type="checkbox" id="chinfoDontShow">
              <span>Bir daha gösterme</span>
            </label>
            <button class="fmt-btn" onclick="closeChInfoModal()">Anladım</button>
          </div>
        </div>

        
      </div>

      <div id="epg-panel">
        <div class="epg-hdr">
          <div class="epg-hdr-t" style="display:flex;align-items:center;gap:6px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5C3.9 3 3 3.9 3 5v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>YAYIN REHBERİ</div>
          <button class="epg-cls" onclick="toggleEPG()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
          </button>
        </div>
        <div id="epg-items"></div>
      </div>

      
      <div id="progReminderModal">
        <div class="prm-card">
          <svg class="prm-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
          <div class="prm-ttl" id="prmTitle"></div>
          <div class="prm-sub" id="prmSub"></div>
          <div class="prm-btns">
            <button class="prm-btn" onclick="dismissProgReminder()">Kapat</button>
            <button class="prm-btn prm-yes" onclick="acceptProgReminder()">Kanala Geç</button>
          </div>
        </div>
      </div>

      <div id="sb">
        <div class="sbd" id="sbdot"></div>
        <span id="sbtxt">Hazır</span>
        <span id="sblive" class="sb-live" style="display:none;">
          <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          CANLI
        </span>
        <span id="sbq" style="color:var(--acc2)"></span>
        <span id="sbclk"></span>
      </div>

    </div>
  </div>
</div>


<div id="genPromptModal">
  <div class="fmt-card compact-card">
    <div class="fmt-ico sm" id="genPromptIco"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></div>
    <div class="fmt-ttl" id="genPromptTtl">Yeniden Adlandır</div>
    <input type="text" id="genPromptInput" class="chinfo-input" maxlength="60" autocomplete="off" enterkeyhint="done" autocapitalize="sentences" spellcheck="false" onkeydown="if(event.key==='Enter'){event.preventDefault();confirmGenPrompt();}">
    <div class="fmt-btns" style="margin-top:12px;">
      <button class="fmt-btn" onclick="confirmGenPrompt()">Kaydet</button>
      <button class="fmt-btn sec" id="genPromptResetBtn" style="display:none;" onclick="revertChannelName()">Orijinal İsme Dön</button>
      <button class="fmt-btn sec" onclick="closeGenPrompt()">Vazgeç</button>
    </div>
  </div>
</div>

<div id="catPickModal">
  <div class="fmt-card compact-card">
    <div class="fmt-ico sm"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H2v16h20V6H12l-2-2z"/></svg></div>
    <div class="fmt-ttl" id="catPickTtl">Kategoriye Ekle</div>
    <div class="fmt-txt" id="catPickChName" style="margin-bottom:10px;"></div>
    <div id="catPickList" class="catpick-list"></div>
    <button class="fmt-btn sec" style="margin-top:6px;" onclick="openNewCatPrompt(true)">+ Yeni Kategori</button>
    <button class="fmt-btn" style="margin-top:9px;" onclick="closeCatPickModal()">Bitti</button>
  </div>
</div>


<div id="folderBrowserModal">
  <div class="fb-card">
    <div class="fb-hdr">
      <button class="fb-back" id="fbBackBtn" onclick="folderBrowserBack()" style="display:none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </button>
      <div class="fb-ttl" id="fbTtl">Klasörlerim</div>
