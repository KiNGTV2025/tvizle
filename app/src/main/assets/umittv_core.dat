<style id="umit-reorder-css">#mmtabs #whatBtn{background:none;border:none;box-shadow:none;border-radius:7px;padding:6px 9px;flex-shrink:0;order:0;color:#a855f7}#mmtabs #whatBtn:hover{background:rgba(139,92,246,.18);box-shadow:none}#mmtabs #whatBtn{gap:5px;display:flex;align-items:center;white-space:nowrap}#mmtabs #whatBtn span{display:inline!important;font-family:'Outfit',sans-serif;font-size:.72rem;font-weight:700;color:var(--text2)}#mmtabs #whatBtn:hover span{color:var(--text)}#mmtabs #whatBtn svg{width:15px;height:15px}.chi-drag-h{touch-action:none!important;cursor:grab;color:var(--acc)!important}.chi-drag-h:active{cursor:grabbing}.chi.ch-dragsrc{opacity:.25}.ch-drop-ind{position:absolute;box-sizing:border-box;border:2px dashed var(--acc);border-radius:14px;background:rgba(239,68,68,.12);pointer-events:none;z-index:5}.ch-drop-ind::after{content:attr(data-n);position:absolute;top:6px;left:6px;background:var(--acc);color:var(--on-acc,#fff);font-weight:800;font-size:.8rem;line-height:1;padding:4px 9px;border-radius:8px}.chi.ch-drag-ghost{position:absolute;z-index:20;pointer-events:none;opacity:.93;margin:0;transform:scale(1.04);box-shadow:0 12px 30px rgba(0,0,0,.65);transition:none}#chlist.ch-dragging,#chlist.ch-dragging *{-webkit-user-select:none;user-select:none} #chlist .chi .chi-drag-h,#chlist .chi .chi-drag-h:hover,#chlist .chi .chi-drag-h:focus,#chlist .chi .chi-drag-h:focus-visible,#chlist .chi .chi-drag-h:active{background:var(--bg3);border-color:var(--bord);color:var(--acc);transform:none;outline:none}#chlist .chi.grid .chi-drag-h,#chlist .chi.grid .chi-drag-h:hover,#chlist .chi.grid .chi-drag-h:focus,#chlist .chi.grid .chi-drag-h:active{background:rgba(0,0,0,.6);border-color:rgba(255,255,255,.22)}#chlist .chi.ch-drag-ghost .chi-drag-h{background:var(--acc);border-color:var(--acc);color:var(--on-acc,#fff)} #umitCfm{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:22px;background:rgba(0,0,0,0);backdrop-filter:blur(0);-webkit-backdrop-filter:blur(0);transition:background .2s,backdrop-filter .2s}#umitCfm.in{background:rgba(0,0,0,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}#umitCfm .cf-card{width:100%;max-width:340px;box-sizing:border-box;text-align:center;padding:26px 22px 20px;border-radius:22px;background:linear-gradient(160deg,var(--bg2,#1a0c0c),var(--bg,#120808));border:1px solid var(--bord,rgba(255,255,255,.12));box-shadow:0 24px 60px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.03) inset;transform:translateY(18px) scale(.94);opacity:0;transition:transform .22s cubic-bezier(.2,.9,.3,1.2),opacity .18s}#umitCfm.in .cf-card{transform:none;opacity:1}#umitCfm .cf-ico{width:58px;height:58px;margin:0 auto 14px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(239,68,68,.14);color:#ef4444;box-shadow:0 0 0 6px rgba(239,68,68,.07)}#umitCfm .cf-ico.acc{background:rgba(168,85,247,.16);color:#a855f7;box-shadow:0 0 0 6px rgba(168,85,247,.08)}#umitCfm .cf-ico svg{width:28px;height:28px}#umitCfm .cf-t{font-family:'Outfit',sans-serif;font-weight:800;font-size:1.1rem;color:var(--text,#fff);margin-bottom:6px}#umitCfm .cf-m{font-size:.84rem;line-height:1.45;color:var(--text2,#bbb);margin-bottom:20px}#umitCfm .cf-row{display:flex;gap:10px}#umitCfm .cf-b{flex:1;padding:12px 10px;border-radius:13px;font-family:'Outfit',sans-serif;font-weight:700;font-size:.9rem;cursor:pointer;border:1px solid var(--bord,rgba(255,255,255,.14));background:var(--bg3,#241010);color:var(--text,#fff);transition:transform .12s,filter .12s}#umitCfm .cf-b:active{transform:scale(.96)}#umitCfm .cf-b:focus-visible,#umitCfm .cf-b:focus,#umitCfm .cf-b.nv-hi{outline:3px solid #fff;outline-offset:2px;transform:scale(1.04)}#umitCfm .cf-ok{border:none;color:var(--on-acc,#fff);background:linear-gradient(135deg,var(--acc,#ef4444),var(--acc2,#f97316))}#umitCfm .cf-ok.danger{background:linear-gradient(135deg,#ef4444,#b91c1c)} #umitCfm .cf-poster{position:relative;width:92px;margin:-52px auto 14px}#umitCfm .cf-poster .cf-pimg{width:92px;aspect-ratio:2/3;border-radius:14px;overflow:hidden;background:var(--bg3,#241010);border:1px solid rgba(255,255,255,.14);box-shadow:0 14px 34px rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;color:var(--text2,#bbb)}#umitCfm .cf-poster img{width:100%;height:100%;object-fit:cover;display:block}#umitCfm .cf-poster .cf-pbadge{position:absolute;right:-12px;bottom:-12px;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--on-acc,#fff);background:linear-gradient(135deg,var(--acc,#ef4444),var(--acc2,#f97316));box-shadow:0 6px 16px rgba(0,0,0,.5),0 0 0 3px var(--bg,#120808)}#umitCfm .cf-poster .cf-pbadge svg{width:18px;height:18px}#umitCfm .cf-card.has-poster{padding-top:20px;overflow:visible}#umitCfm .cf-card.has-poster .cf-b{white-space:nowrap;padding-left:8px;padding-right:8px;font-size:.86rem}#umitCfm .cf-name{font-family:'Outfit',sans-serif;font-weight:700;font-size:.95rem;color:var(--text,#fff);margin:0 0 8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}#umitCfm .cf-chip{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:6px 12px;margin-bottom:16px;border-radius:999px;font-size:.76rem;font-weight:600;color:var(--text,#fff);background:rgba(255,255,255,.07);border:1px solid var(--bord,rgba(255,255,255,.14))}#umitCfm .cf-chip svg{width:14px;height:14px;flex:none;color:var(--acc,#ef4444)}#umitCfm .cf-chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}</style>
