<style id="umit-nowplay-css">.chi.on::before{content:'';position:absolute;left:0;top:8px;bottom:8px;width:4px;border-radius:4px;background:var(--acc);z-index:4;pointer-events:none}.chi.on .chi-nm{color:var(--acc)}.chi-now{display:none;position:absolute;left:0;right:0;bottom:0;z-index:3;flex-direction:column;align-items:center;justify-content:center;padding:2px 2px 3px;background:rgba(0,0,0,.74);border-top:2px solid var(--acc);color:#fff;line-height:1.15;pointer-events:none;text-align:center;overflow:hidden}.chi.on .chi-now{display:flex}.chi-now-t{font-size:.5rem;font-weight:900;letter-spacing:.3px;color:var(--acc2,#fb923c);white-space:nowrap}.chi-now-t::before{content:'';display:inline-block;width:0;height:0;margin-right:3px;vertical-align:baseline;border-left:5px solid currentColor;border-top:3px solid transparent;border-bottom:3px solid transparent}.chi-now-r{font-size:.62rem;font-weight:900;white-space:nowrap}.chi-now-r:empty{display:none}.chi.grid .chi-now-t{font-size:.62rem}.chi.grid .chi-now-r{font-size:.78rem}.chi-now[data-tier="4K"] .chi-now-t,.chi-now[data-tier="2K"] .chi-now-t{color:#fbbf24}.chi-now[data-tier="SD"] .chi-now-t{color:#94a3b8} .chi.list .chi-now{display:none!important}.chi-now2{display:none;align-items:center;gap:6px;margin-bottom:2px;font-size:.6rem;line-height:1.25;white-space:nowrap;overflow:hidden;color:#fff}.chi.list.on .chi-now2{display:flex}.n2-t{padding:0 6px;border-radius:4px;background:var(--acc);color:#000;font-weight:900;letter-spacing:.3px}.n2-t[data-tier="SD"]{background:#64748b;color:#fff}.n2-t[data-tier="4K"],.n2-t[data-tier="2K"]{background:#fbbf24}.n2-r{font-weight:800;opacity:.9}.n2-r:empty{display:none}#chlist:not(.chl-cmp) .chi.list.on .chi-nm{-webkit-line-clamp:1}.chi.chi-pulse::after{content:'';position:absolute;inset:0;border-radius:inherit;border:3px solid var(--acc);pointer-events:none;z-index:5;animation:chiPulse .7s ease-out 1 both}@keyframes chiPulse{0%{opacity:0;transform:scale(.94)}25%{opacity:1}100%{opacity:0;transform:scale(1.04)}}html.umit-lite .chi.chi-pulse::after,html.umit-quiet .chi.chi-pulse::after{animation:chiPulseLite .7s linear 1 both;transform:none}@keyframes chiPulseLite{0%{opacity:1}100%{opacity:0}}</style>
