<style id="umit-exit-css">#setup .btn-exit{display:block;width:100%;margin:10px 0 0;padding:13px 16px;border-radius:16px;font:inherit;font-weight:800;font-size:.95rem;letter-spacing:1.5px;text-align:center;cursor:pointer;color:#fca5a5;background:rgba(239,68,68,.10);border:1.5px solid rgba(239,68,68,.45);transition:transform .12s,background .15s,border-color .15s,color .15s}#setup .btn-exit:hover{background:rgba(239,68,68,.20)}#setup .btn-exit:active{transform:scale(.97)}#setup .btn-exit:focus,#setup .btn-exit:focus-visible,#chExitBtn:focus,#chExitBtn:focus-visible{outline:3px solid var(--acc)!important;outline-offset:2px;background:rgba(239,68,68,.30);color:#fff}</style>
