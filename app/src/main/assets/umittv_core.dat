<style id="umr-css">#umitRmtLogin{position:fixed;inset:0;z-index:2147483000;display:none;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;background:radial-gradient(1200px 700px at 50% 20%,rgba(255,176,32,.14),transparent 60%),rgba(5,4,8,.92);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#f4efe9}#umitRmtLogin .umr-card{width:min(760px,100%);background:linear-gradient(160deg,#1f1611,#120c09);border:1px solid rgba(255,176,32,.25);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.05);padding:28px 30px 22px;box-sizing:border-box}#umitRmtLogin .umr-head{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:700;letter-spacing:.3px}#umitRmtLogin .umr-dot{width:10px;height:10px;border-radius:50%;background:#ffb020;box-shadow:0 0 0 0 rgba(255,176,32,.6);animation:umrPulse 1.8s infinite}#umitRmtLogin .umr-dot.ok{background:#3ddc84;animation:none;box-shadow:0 0 12px rgba(61,220,132,.6)}@keyframes umrPulse{0%{box-shadow:0 0 0 0 rgba(255,176,32,.5)}70%{box-shadow:0 0 0 10px rgba(255,176,32,0)}100%{box-shadow:0 0 0 0 rgba(255,176,32,0)}}#umitRmtLogin .umr-body{display:flex;gap:26px;align-items:center;margin-top:18px;flex-wrap:wrap;justify-content:center}#umitRmtLogin .umr-qrWrap{padding:14px;border-radius:20px;background:linear-gradient(135deg,#ffb020,#ff7a1a);box-shadow:0 12px 30px rgba(255,140,0,.25)}#umitRmtLogin #umitRmtQr{width:240px;height:240px;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:hidden}#umitRmtLogin #umitRmtQr img,#umitRmtLogin #umitRmtQr canvas{width:240px!important;height:240px!important}#umitRmtLogin .umr-side{min-width:220px;flex:1;text-align:center}#umitRmtLogin .umr-label{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#a89a8e}#umitRmtLogin .umr-code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:44px;font-weight:800;letter-spacing:10px;color:#ffb020;margin:8px 0 14px;text-shadow:0 0 22px rgba(255,176,32,.35)}#umitRmtLogin .umr-st{font-size:15px;line-height:1.55;color:#cfc3b8}#umitRmtLogin .umr-actions{display:flex;gap:14px;justify-content:center;margin-top:24px}#umitRmtLogin .umr-btn{min-width:170px;font-size:17px;font-weight:600;color:#f4efe9;background:#2a1f19;border:2px solid transparent;border-radius:14px;padding:13px 22px;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;font-family:inherit}#umitRmtLogin .umr-btn.umr-pri{background:linear-gradient(135deg,#ffb020,#ff8a00);color:#1a1200}#umitRmtLogin .umr-btn:focus,#umitRmtLogin .umr-btn:focus-visible{outline:none;border-color:#fff;box-shadow:0 0 0 4px var(--bord2);transform:scale(1.05)}#umitRmtLogin .umr-hint{margin-top:18px;text-align:center;font-size:12px;color:#7d7066;letter-spacing:.3px}</style>
