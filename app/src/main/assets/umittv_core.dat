<style id="umit-gs-css">#umitGs{position:fixed;inset:0;z-index:2147483200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2.4vmin;pointer-events:none;text-align:center;background:radial-gradient(circle at 50% 50%,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 62%)}#umitGs .gs-logo{width:min(34vmin,340px);height:min(34vmin,340px);object-fit:contain;animation:gsLogoIn .8s cubic-bezier(.2,1.3,.4,1) both}#umitGs .gs-txt{max-width:88vw;font-family:'Outfit',sans-serif;font-weight:900;line-height:1.25;color:#fdb912;font-size:clamp(16px,3.4vmin,38px);text-shadow:0 2px 6px rgba(0,0,0,.95),0 0 2px #000;animation:gsTxtIn .6s ease-out .45s both}#umitGs .gs-txt b{display:block;color:#a90432;font-size:.86em;font-weight:900;margin-top:.35em;text-shadow:2px 0 #fdb912,-2px 0 #fdb912,0 2px #fdb912,0 -2px #fdb912,1.5px 1.5px #fdb912,-1.5px -1.5px #fdb912,1.5px -1.5px #fdb912,-1.5px 1.5px #fdb912,0 4px 10px rgba(0,0,0,.85)} html.tv-device #umitGs,html.tv-device #umitGs *{box-sizing:border-box}html.tv-device #umitGs{gap:3.2vmin;background:radial-gradient(circle at 50% 50%,rgba(0,0,0,.65) 0%,rgba(0,0,0,0) 70%)}html.tv-device #umitGs .gs-logo{width:min(52vmin,620px);height:min(52vmin,620px)}html.tv-device #umitGs .gs-txt{max-width:92vw;font-size:clamp(30px,6.4vmin,96px)}html.tv-device #umitGs .gs-txt b{text-shadow:3px 0 #fdb912,-3px 0 #fdb912,0 3px #fdb912,0 -3px #fdb912,2px 2px #fdb912,-2px -2px #fdb912,2px -2px #fdb912,-2px 2px #fdb912,0 6px 14px rgba(0,0,0,.85)}@media (min-width:1200px) and (min-height:650px){#umitGs{gap:3vmin}#umitGs .gs-logo{width:min(46vmin,520px);height:min(46vmin,520px)}#umitGs .gs-txt{font-size:clamp(26px,5.4vmin,80px)}}#umitGs.gs-out{animation:gsBoxOut .55s ease-in both}@keyframes gsBoxOut{0%{opacity:1;visibility:visible}99%{opacity:0;visibility:visible}100%{opacity:0;visibility:hidden}}#umitGs.gs-out .gs-logo{animation:gsLogoOut .55s ease-in both}#umitGs.gs-out .gs-txt{animation:gsTxtOut .45s ease-in both}@keyframes gsLogoIn{0%{opacity:0;transform:scale(.25) rotate(-12deg)}60%{opacity:1;transform:scale(1.12) rotate(3deg)}100%{opacity:1;transform:scale(1) rotate(0)}}@keyframes gsTxtIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}@keyframes gsLogoOut{from{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(1.35)}}@keyframes gsTxtOut{from{opacity:1;transform:none}to{opacity:0;transform:translateY(-12px)}}</style>
