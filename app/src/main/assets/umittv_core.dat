<style id="umit-modern-loader">#loading{gap:clamp(22px,4.2vmin,56px)!important;background:radial-gradient(ellipse at 50% 42%,rgba(249,115,22,.16) 0%,transparent 55%),var(--bg0)!important}#loading .ld-badge{position:relative;width:clamp(130px,30vmin,340px)!important;height:clamp(130px,30vmin,340px)!important;background:radial-gradient(circle at 50% 35%,var(--bg4),var(--bg1))!important;box-shadow:0 0 0 1px rgba(255,255,255,.08),inset 0 0 30px rgba(255,255,255,.04)!important}#loading .ld-badge::after{inset:-6%!important;box-shadow:0 0 clamp(40px,8vmin,110px) rgba(249,115,22,.65)!important} #loading .ld-badge::before{content:'';position:absolute;inset:-9%;border-radius:50%;pointer-events:none;z-index:2;background:conic-gradient(from 0deg,transparent 0deg,transparent 90deg,var(--acc) 270deg,var(--acc2) 350deg,transparent 360deg);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - clamp(5px,1vmin,12px)),#000 calc(100% - clamp(5px,1vmin,12px) + 1px));mask:radial-gradient(farthest-side,transparent calc(100% - clamp(5px,1vmin,12px)),#000 calc(100% - clamp(5px,1vmin,12px) + 1px));will-change:transform;animation:umLdSpin 1.4s linear infinite!important;animation-duration:1.4s!important;animation-iteration-count:infinite!important;animation-play-state:running!important}@keyframes umLdSpin{to{transform:rotate(360deg)}}#loading .ld-logo-img{width:62%!important;height:62%!important}#loading .ld-logo{font-size:clamp(1.4rem,5vmin,3.6rem)!important}#loading .ld-bar{width:clamp(260px,46vw,820px)!important;height:clamp(6px,1vmin,12px)!important;border-radius:999px!important;background:rgba(255,255,255,.1)!important}#loading .ld-fill{border-radius:999px!important;box-shadow:0 0 clamp(10px,2vmin,24px) var(--acc)!important}#loading .ld-msg{font-size:clamp(1.05rem,3vmin,2.2rem)!important;font-weight:600;letter-spacing:.06em!important;text-transform:none!important;color:var(--text)!important;opacity:.9;text-align:center;max-width:90vw;text-shadow:0 2px 18px rgba(0,0,0,.6)}html.tv-device #loading .ld-badge{width:clamp(180px,34vmin,380px)!important;height:clamp(180px,34vmin,380px)!important}html.tv-device #loading .ld-msg{font-size:clamp(1.3rem,3.4vmin,2.6rem)!important}</style>

<style id="umit-tv-grid-btn-loader-v2">#loading .ld-bar::after{display:none!important}#loading .ld-bar{position:relative;overflow:hidden}#loading .ld-sweep{position:absolute;top:0;left:0;height:100%;width:35%;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85),transparent);transform:translate3d(-110%,0,0);-webkit-backface-visibility:hidden;backface-visibility:hidden;will-change:transform;animation:ldSweepV2 1.2s linear infinite!important;animation-duration:1.2s!important;animation-iteration-count:infinite!important;animation-play-state:running!important}@keyframes ldSweepV2{from{transform:translate3d(-110%,0,0)}to{transform:translate3d(300%,0,0)}} html.tv-device .chi.grid .chi-actions{left:8px;right:8px;bottom:8px;gap:3px}html.tv-device .chi.grid .chi-act-btn{width:25px;height:25px;border-radius:8px}html.tv-device .chi.grid .chi-act-btn svg{width:14px;height:14px}html.tv-device .chi.grid .chi-act-btn{transition:transform .1s linear;transform-origin:50% 100%}html.tv-device .chi.grid .chi-act-btn:focus,html.tv-device .chi.grid .chi-act-btn:focus-visible{transform:scale(1.55);z-index:6}#chiActTip{position:fixed;left:0;top:0;z-index:99990;display:none;pointer-events:none;max-width:70vw;padding:9px 16px;border-radius:12px;background:rgba(15,15,20,.96);color:#fff;border:2px solid var(--acc3,#f97316);font-size:clamp(.95rem,2.2vmin,1.3rem);font-weight:800;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#chiActTip small{display:block;font-weight:600;opacity:.75;font-size:.8em;overflow:hidden;text-overflow:ellipsis}</style>
