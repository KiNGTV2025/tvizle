<style id="v6-style">.v6-modal{position:fixed;inset:0;z-index:390;display:none;background:var(--bg0);flex-direction:column}.v6-modal.show{display:flex}.v6-hdr{flex-shrink:0;display:flex;align-items:center;gap:12px;padding:14px 16px;padding-top:calc(14px + env(safe-area-inset-top,0px));border-bottom:1px solid var(--bord);background:var(--bg1)}.v6-back{width:36px;height:36px;flex-shrink:0;border-radius:50%;border:none;background:transparent;color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1.3rem}.v6-ttl{font-size:1.05rem;font-weight:800;color:var(--text)}.v6-tabs{flex-shrink:0;display:flex;gap:6px;padding:8px 10px;overflow-x:auto;scrollbar-width:none;border-bottom:1px solid var(--bord);background:var(--bg1)}.v6-tabs::-webkit-scrollbar{display:none}.v6-tab{flex-shrink:0;padding:8px 12px;border-radius:10px;border:1px solid var(--bord);background:var(--bg3);color:var(--text2);font-weight:700;font-size:.8rem;font-family:inherit;cursor:pointer}.v6-tab.on{background:var(--acc);color:#111;border-color:var(--acc)}.v6-body{flex:1;overflow-y:auto;padding:14px 14px calc(24px + env(safe-area-inset-bottom,0px));-webkit-overflow-scrolling:touch}.v6-card{background:var(--bg2);border:1px solid var(--bord);border-radius:12px;padding:12px;margin-bottom:10px}.v6-row{display:flex;align-items:center;gap:8px}.v6-grow{flex:1;min-width:0}.v6-nm{font-weight:700;color:var(--text);font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.v6-sub{font-size:.72rem;color:var(--text2);margin-top:2px}.v6-btn{padding:8px 12px;border-radius:9px;border:1px solid var(--bord);background:var(--bg3);color:var(--text);font-weight:700;font-size:.78rem;font-family:inherit;cursor:pointer;flex-shrink:0}.v6-btn.pri{background:var(--acc);color:#111;border-color:var(--acc)}.v6-btn.dng{color:#ef4444}.v6-in{width:100%;box-sizing:border-box;background:var(--bg3);border:1px solid var(--bord);border-radius:9px;padding:9px 11px;color:var(--text);font-family:inherit;font-size:.85rem;outline:none;margin-bottom:8px}.v6-in:focus{border-color:var(--acc)}.v6-hint{font-size:.72rem;color:var(--text2);line-height:1.45;margin:4px 0 10px}.v6-lbl{font-size:.72rem;font-weight:700;color:var(--text2);margin:4px 0 4px;display:block}.v6-pill{display:inline-block;padding:2px 8px;border-radius:99px;font-size:.66rem;font-weight:800;background:var(--bg3);color:var(--text2)}.v6-pill.ok{color:#22c55e}.v6-pill.rec{color:#ef4444}.v6-pill.wait{color:var(--acc)}.v6-empty{text-align:center;color:var(--text2);font-size:.82rem;padding:26px 8px}.v6-bar{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:395;display:none;background:var(--bg2);border:1px solid var(--acc);color:var(--text);padding:8px 12px;border-radius:99px;font-size:.78rem;font-weight:700;gap:10px;align-items:center}.v6-bar.show{display:flex}</style>

<div id="v6Modal" class="v6-modal" role="dialog" aria-modal="true">
  <div class="v6-hdr">
    <button class="v6-back" onclick="V6.close()" aria-label="Geri">&#8592;</button>
    <div class="v6-ttl">Yeni Araçlar</div>
  </div>
  <div class="v6-tabs" id="v6Tabs">
    <button class="v6-tab" data-t="cols" onclick="V6.tab('cols')">Özel Listeler</button>
    <button class="v6-tab" data-t="sched" onclick="V6.tab('sched')">Zamanlı Kayıt</button>
    <button class="v6-tab" data-t="follow" onclick="V6.tab('follow')">Dizi Takibi</button>
    <button class="v6-tab" data-t="auto" onclick="V6.tab('auto')">Oto Güncelleme</button>
  </div>
  <div class="v6-body" id="v6Body"></div>
</div>
<div class="v6-bar" id="v6Bar"><span id="v6BarTxt"></span><button class="v6-btn" onclick="V6.exitView()">Normal liste</button></div>

