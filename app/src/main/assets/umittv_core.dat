        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
    </div>
    <div id="fbBody" class="fb-body"></div>
  </div>
</div>


<div id="appSettingsModal">
  <div class="as-card">
    <div class="as-hdr">
      <button class="as-back" onclick="closeAppSettings()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </button>
      <div class="as-ttl">AYARLAR</div>
    </div>
    <div class="as-body">
      <button class="as-row" id="umit-kumanda-pin-btn" onclick="umitKumandaShow()"><span class="as-row-t">TV kodu ile telefonu kumanda yap</span><span class="as-chev">›</span></button>
      <button class="as-row" id="umit-upd-check-btn" onclick="if(window.umitCheckUpdate)umitCheckUpdate()"><span class="as-row-t">Güncellemeyi kontrol et</span><span class="as-chev">›</span></button>
      <button class="as-row" id="umit-remote-login-btn" onclick="umitRemoteLogin()"><span class="as-row-t">Telefon kumandası (TV girişi)</span><span class="as-chev">›</span></button>
      
      <button class="as-row" id="perfrec-open-btn" onclick="perfRecOpen()"><span class="as-row-t">Performans Kaydı (geçici test)</span><span class="as-chev">›</span></button>
      

      
      <div class="as-sec as-collapse as-collapse-accent" id="as-collapse-wrap-profile">
        <button class="as-collapse-hd" onclick="asToggleCollapse('profile')">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </span>
          <span class="as-collapse-txt">
            <span class="as-collapse-t">Profil &amp; İçerik Ayarları</span>
            <span class="as-collapse-s">Profil seçimi, kategoriler ve yetişkin içerik filtreleri</span>
          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body as-collapse-body-tall" id="as-collapse-profile">

          <button class="as-row" onclick="openCatManageModal()">
            <span class="as-row-t">Kategori Yönetimi (Gizle/Kilitle/Sırala)</span><span class="as-chev">›</span>
          </button>

          <button class="as-row" onclick="openChildModeModal()">
            <span class="as-row-t">Çocuk Modu İçerik Seçimi</span><span class="as-chev">›</span>
          </button>

          <label class="as-toggle-row as-row-as-toggle" for="as-hideadult-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.804 11.804 0 001 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
            </span>
            <span class="as-toggle-txt">Yetişkin Yayınları Gizle</span>
            <input type="checkbox" id="as-hideadult-toggle" onchange="asSetHideAdult(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-deadch-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg>
            </span>
            <span class="as-toggle-txt">Çalışmayan Kanalları Otomatik Çıkar</span>
            <input type="checkbox" id="as-deadch-toggle" checked onchange="umitDeadToggle(this.checked)">
            <span class="as-switch"></span>
          </label>

          <button class="as-row" onclick="umitDeadRestore()">
            <span class="as-row-t" id="as-deadch-restore-t">Çıkarılan Kanalları Geri Getir (0)</span><span class="as-chev">›</span>
          </button>

          <label class="as-toggle-row as-row-as-toggle" for="as-stats-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z"/></svg>
            </span>
            <span class="as-toggle-txt">Gelişmiş İstatistikler</span>
            <input type="checkbox" id="as-stats-toggle" onchange="asSetStatsEnabled(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-recentfav-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3a9 9 0 00-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 117 7 6.9 6.9 0 01-4.9-2.03l-1.42 1.42A9 9 0 1013 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
            </span>
            <span class="as-toggle-txt">Son Eklenen/Favoriler/Geçmişi Göster</span>
            <input type="checkbox" id="as-recentfav-toggle" onchange="asSetShowRecentFavHistory(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-continuerow-discover-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3a9 9 0 00-9 9H1l3.89 3.89.07.14L9 12H6a7 7 0 117 7 6.9 6.9 0 01-4.9-2.03l-1.42 1.42A9 9 0 1013 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
            </span>
            <span class="as-toggle-txt">Kaldığın Yerde'yi Sadece Keşif'te Göster</span>
            <input type="checkbox" id="as-continuerow-discover-toggle" onchange="asSetContinueRowOnlyDiscover(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-swipetabs-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 5l-1.41 1.41L11.17 10H2v2h9.17l-3.58 3.59L9 17l6-6-6-6zm6 0l-1.41 1.41L17.17 10H8v2h9.17l-3.58 3.59L15 17l6-6-6-6z" transform="scale(-1,1) translate(-24,0)"/></svg>
            </span>
            <span class="as-toggle-txt">Kaydırarak Sekme Geçişi</span>
            <input type="checkbox" id="as-swipetabs-toggle" onchange="asSetSwipeTabs(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-autopip-toggle">
            <span class="as-toggle-ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-8v6h8v-6zm4 8V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z"/></svg>
            </span>
            <span class="as-toggle-txt">Otomatik PiP (sekme/uygulama değişince)</span>
            <input type="checkbox" id="as-autopip-toggle" onchange="asSetAutoPip(this.checked)">
            <span class="as-switch"></span>
          </label>

          <label class="as-toggle-row as-row-as-toggle" for="as-pipfs-toggle">
            <span class="as-toggle-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-8v6h8v-6zm4 8V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z"/></svg></span>
            <span class="as-toggle-txt">PiP için oynatınca tam ekran (telefon)</span>
            <input type="checkbox" id="as-pipfs-toggle" onchange="asSetPipFs(this.checked)">
            <span class="as-switch"></span>
          </label>
          <label class="as-toggle-row as-row-as-toggle" for="as-imgwifi-toggle">
            <span class="as-toggle-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 11h-8v6h8v-6zm4 8V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z"/></svg></span>
            <span class="as-toggle-txt">Logo/afiş arka plan indirmesi yalnızca Wi-Fi'da</span>
            <input type="checkbox" id="as-imgwifi-toggle" onchange="asSetImgWifi(this.checked)">
            <span class="as-switch"></span>
          </label>
          <button class="as-row" onclick="asCycleImgMax()"><span class="as-row-t">Görsel önbelleği boyut sınırı<br><small id="as-imgmax-val" style="opacity:.65">300 MB</small></span><span class="as-chev">›</span></button>
          <button class="as-row" onclick="asCycleImgRefresh()"><span class="as-row-t">Görsel yenileme sıklığı<br><small id="as-imgref-val" style="opacity:.65">12 saat</small></span><span class="as-chev">›</span></button>
          <button class="as-row" onclick="umitImgCacheClear()"><span class="as-row-t">Görsel önbelleğini temizle<br><small id="as-imgcache-val" style="opacity:.65">logolar/afişler</small></span><span class="as-chev">›</span></button>
          <button class="as-row" onclick="umitShowDiag()"><span class="as-row-t">Tanı (PiP ve önbellek durumu)<br><small style="opacity:.65">hata nedenleri, günlük, kopyala</small></span><span class="as-chev">›</span></button>

          <div class="as-row-inline" style="flex-direction:column;align-items:stretch;gap:6px;padding:10px 4px;">
            <span class="as-row-lbl">User-Agent (proxy üzerinden akışlarda)</span>
            <input type="text" id="as-ua-input" class="as-input" list="as-ua-presets" placeholder="Boş = varsayılan (örn. VLC/3.0.20 LibVLC/3.0.20)" autocomplete="off" autocapitalize="off" spellcheck="false" onchange="asSetUserAgent(this.value)" onblur="asSetUserAgent(this.value)">
            <div class="as-seg" id="as-ua-seg">
              <button data-v="" onclick="asPickUA('')">Varsayılan</button>
              <button data-v="vlc" onclick="asPickUA('vlc')">VLC</button>
              <button data-v="exo" onclick="asPickUA('exo')">ExoPlayer</button>
              <button data-v="okhttp" onclick="asPickUA('okhttp')">okhttp</button>
              <button data-v="lavf" onclick="asPickUA('lavf')">Lavf</button>
              <button data-v="tv" onclick="asPickUA('tv')">Chrome (Android TV)</button>
              <button data-v="win" onclick="asPickUA('win')">Chrome (Windows)</button>
            </div>
            <datalist id="as-ua-presets">
              <option value="VLC/3.0.20 LibVLC/3.0.20"></option>
              <option value="ExoPlayer"></option>
              <option value="okhttp/4.12.0"></option>
              <option value="Lavf/60.16.100"></option>
              <option value="Mozilla/5.0 (Linux; Android 13; TV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"></option>
              <option value="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"></option>
            </datalist>
          </div>

        </div>
      </div>

      
      <div class="as-sec as-collapse as-collapse-accent" id="as-collapse-wrap-theme">
        <button class="as-collapse-hd" onclick="asToggleCollapse('theme')">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
