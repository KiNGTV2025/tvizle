<style id="umit-loader-anim-fix">#loading .ld-bar{position:relative;height:4px;overflow:hidden;background:rgba(255,255,255,.12)}#loading .ld-bar::after{content:'';position:absolute;top:0;left:0;height:100%;width:40%;background:linear-gradient(90deg,transparent,var(--acc2,#fb923c),transparent);transform:translateX(-120%);will-change:transform;animation:ldBarFlow 1.3s linear infinite!important;animation-duration:1.3s!important;animation-iteration-count:infinite!important}@keyframes ldBarFlow{from{transform:translateX(-120%)}to{transform:translateX(300%)}}#loading .ld-fill{min-width:6%}#loading .ld-badge{animation:ldPulseSoft 1.6s ease-in-out infinite!important;animation-duration:1.6s!important;animation-iteration-count:infinite!important;transform:none;will-change:transform}@keyframes ldPulseSoft{0%,100%{transform:scale(1);opacity:.9}50%{transform:scale(1.06);opacity:1}}</style>
<style id="umit-logo-glow">@keyframes umLogoHalo{0%,100%{opacity:.35;transform:translate(-50%,-50%) scale(.92)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}}@keyframes umLogoHaloBadge{0%,100%{opacity:.3}50%{opacity:1}}@keyframes umLogoBreath{0%,100%{opacity:.82}50%{opacity:1}} #pw-brand::before{content:'';position:absolute;left:50%;top:50%;width:min(78%,560px);aspect-ratio:1/1;border-radius:50%;pointer-events:none;background:radial-gradient(circle,rgba(249,115,22,.55) 0%,rgba(251,191,36,.22) 38%,transparent 68%);transform:translate(-50%,-50%);will-change:opacity,transform;animation:umLogoHalo 2.6s ease-in-out infinite!important;animation-duration:2.6s!important;animation-iteration-count:infinite!important}#pw-brand img,#pw-brand .pwb-txt{position:relative;z-index:1}#pw-brand img{will-change:opacity;animation:umLogoBreath 2.6s ease-in-out infinite!important;animation-duration:2.6s!important;animation-iteration-count:infinite!important}#pw-brand #pwb-load{position:relative;z-index:1}@media (orientation:portrait){#pw-brand::before{width:min(62%,320px)}} #pwb-load::after,#spin::after{will-change:transform;animation-name:pwbar!important;animation-duration:1.15s!important;animation-timing-function:linear!important;animation-iteration-count:infinite!important;animation-play-state:running!important}#pw.is-loading #pwb-load{display:block!important} #loading .ld-badge{position:relative}#loading .ld-badge::after{content:'';position:absolute;inset:-10px;border-radius:50%;pointer-events:none;box-shadow:0 0 38px rgba(249,115,22,.75);will-change:opacity;animation:umLogoHaloBadge 1.6s ease-in-out infinite!important;animation-duration:1.6s!important;animation-iteration-count:infinite!important} #setup .brand-badge{position:relative;animation:none!important}#setup .brand-badge::after{content:'';position:absolute;inset:-4px;border-radius:999px;pointer-events:none;box-shadow:0 0 0 3px rgba(249,115,22,.2),0 0 36px rgba(249,115,22,.85);will-change:opacity;animation:umLogoHaloBadge 2.6s ease-in-out infinite!important;animation-duration:2.6s!important;animation-iteration-count:infinite!important}</style>
