<style id="umit-pro-ui">:root,:root[data-theme]{ --r:10px;--r2:8px;--glow:none;--sh:0 1px 2px rgba(0,0,0,.5),0 10px 28px rgba(0,0,0,.35)}html body{font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif!important;font-feature-settings:'cv11','ss01';-webkit-font-smoothing:antialiased;letter-spacing:0;background:var(--bg0)!important}html body button,html body input,html body select,html body textarea,html body .inp{font-family:inherit!important} html body #setup{background:var(--bg0)!important;background-image:none!important}html body #setup::before,html body #setup::after{display:none!important}html body .brand-badge{background:var(--bg2)!important;border:1px solid var(--bord)!important;box-shadow:none!important;animation:none!important;border-radius:12px!important;padding:8px 16px 8px 8px!important}html body .brand-icon{background:var(--acc)!important;box-shadow:none!important;border-radius:8px!important;color:var(--on-acc)!important}html body .brand-name,html body .tb-logo{font-weight:700!important;letter-spacing:-.01em!important;background:none!important;-webkit-text-fill-color:currentColor!important;color:var(--text)!important;text-shadow:none!important}html body .brand-name span,html body .tb-logo span{color:var(--acc)!important;-webkit-text-fill-color:var(--acc)!important}html body .scard{background:var(--bg2)!important;border:1px solid var(--bord)!important;border-radius:12px!important;box-shadow:none!important;padding:18px!important}html body .stitle{text-transform:none!important;letter-spacing:0!important;font-size:.8125rem!important;font-weight:600!important;color:var(--text2)!important}html body .stitle svg{opacity:.7}html body .inp{background:var(--bg1)!important;border:1px solid var(--bord)!important;border-radius:8px!important;color:var(--text)!important;font-size:.9rem!important}html body .inp:focus{border-color:var(--acc)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 22%,transparent)!important}html body .inp::placeholder{color:var(--text3)!important}html body .btn-launch,html body .btn-add{background:var(--acc)!important;color:var(--on-acc)!important;border:0!important;border-radius:10px!important;box-shadow:none!important;text-shadow:none!important;font-weight:650!important;letter-spacing:.01em!important;font-size:.95rem!important;transition:background-color .15s,filter .15s!important}html body .btn-launch:hover:not(:disabled),html body .btn-add:hover{filter:brightness(1.08);transform:none!important;box-shadow:none!important}html body .btn-launch:disabled{background:var(--bg4)!important;color:var(--text3)!important;opacity:1!important}html body .btn-exit{background:transparent!important;border:1px solid var(--bord2)!important;color:var(--text2)!important;border-radius:10px!important;box-shadow:none!important;font-weight:600!important;letter-spacing:0!important;text-shadow:none!important}html body .btn-exit:hover{color:var(--text)!important;border-color:var(--text3)!important} html body #saved-list > *,html body .pl-item{background:var(--bg1)!important;border:1px solid var(--bord)!important;border-left:3px solid var(--bord2)!important;border-radius:10px!important;box-shadow:none!important}html body #saved-list > .on,html body .pl-item.on,html body .pl-item.act{border-color:var(--bord2)!important;border-left-color:var(--acc)!important;background:var(--bg3)!important}html body #saved-list *{text-shadow:none!important}html body #saved-list [class*="url"],html body #saved-list [class*="sub"],html body #saved-list .pl-u{font-family:inherit!important;font-style:normal!important;color:var(--text2)!important;font-size:.75rem!important} html body #setup .brand-badge::before,html body #setup .brand-badge::after{display:none!important;animation:none!important;box-shadow:none!important}html body .pl-row{background:var(--bg1)!important;border:1px solid var(--bord)!important;border-radius:10px!important;box-shadow:none!important}html body .pl-row::before{background:var(--bord2)!important;width:3px!important}html body .pl-row.sel{background:var(--bg3)!important;border-color:var(--bord2)!important}html body .pl-row.sel::before{background:var(--acc)!important}html body .pl-row.umt-brand,html body .pl-row.umt-brand.sel{border-color:var(--bord)!important}html body .pl-row.umt-brand.sel{background:var(--bg3)!important;border-color:var(--bord2)!important}html body .pl-row.umt-brand::before{background:var(--bord2)!important}html body .pl-row.umt-brand.sel::before{background:var(--acc)!important}html body .pl-ic,html body .pl-row.umt-brand .pl-ic,html body .pl-ic.k-xtream,html body .pl-ic.k-file{background:var(--bg4)!important;color:var(--text)!important;border-radius:8px!important;box-shadow:none!important}html body .pl-ic.k-github{background:var(--bg4)!important;box-shadow:none!important}html body .pl-ic svg{filter:none!important}html body .pl-nm{font-weight:600!important}html body .pl-ur,html body .pl-row.umt-brand .pl-ur{font-family:inherit!important;font-style:normal!important;color:var(--text2)!important;font-size:.72rem!important}html body .pl-cnt{color:var(--text2)!important;font-weight:600!important}html body .pl-sel-play{animation:none!important;box-shadow:none!important;background:var(--green)!important}html body .btn-x{background:transparent!important;border:1px solid var(--bord)!important;color:var(--text2)!important;border-radius:6px!important;box-shadow:none!important}html body .btn-x:hover{color:#f87171!important;border-color:rgba(248,113,113,.5)!important}html body .pl-drag{color:var(--text3)!important;opacity:1!important} html body .sbtn{background:var(--bg1)!important;border:1px solid var(--bord)!important;border-radius:8px!important;color:var(--text2)!important;box-shadow:none!important;font-weight:550!important}html body .sbtn.on{background:var(--bg4)!important;color:var(--text)!important;border-color:var(--bord2)!important;box-shadow:inset 0 -2px 0 var(--acc)!important} html body .stabs button,html body .src-tab,html bod