<style id="umit-ch-epg-tip-css">#umitChEpgTip{position:fixed;left:0;top:0;z-index:2147483000;display:none;pointer-events:none;box-sizing:border-box;max-width:min(92vw,calc(560px*var(--umit-fs,1)));padding:9px 14px;border-radius:12px;background:linear-gradient(135deg,var(--acc,#f97316),var(--acc2,#fb923c));color:var(--on-acc,#fff);border:2px solid var(--acc3,var(--acc2,#fbbf24));box-shadow:0 8px 24px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.22);font:800 calc(.98rem*var(--umit-fs,1))/1.28 'Outfit','Nunito',system-ui,sans-serif;white-space:normal;overflow-wrap:anywhere}#umitChEpgTip small{display:block;margin-top:3px;font-weight:700;font-size:.82em;opacity:.95}#umitChEpgTip small.w{font-weight:800}</style>
