<style id="umit-loader-clean">html:root:root #pwb-load{display:none!important}html:root:root #spin{width:36px!important;height:36px!important;border-radius:50%!important;background:none!important;overflow:visible!important;border:3px solid rgba(255,255,255,.2)!important;border-top-color:var(--acc,#f97316)!important;box-shadow:none!important;animation:umSpinRing .8s linear infinite!important}html:root:root #spin::after{display:none!important}html:root:root #main.pw-mini #spin{width:22px!important;height:22px!important;border-width:2.5px!important}@keyframes umSpinRing{to{transform:translate(-50%,-50%) rotate(360deg)}}html:root:root #pw.is-loading #pw-brand img{filter:none!important} html:root:root #pw.umit-preroll #pw-brand{display:flex!important}html:root:root #pw.umit-preroll #spin{display:none!important}</style>
