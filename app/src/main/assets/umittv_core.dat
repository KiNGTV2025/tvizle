<style id="umit-cmp-css">#chlist.chl-cmp .chi .chi-act-btn{width:var(--chi-bs,24px);height:var(--chi-bs,24px);border-radius:7px;flex-shrink:0}#chlist.chl-cmp .chi .chi-act-btn svg{width:calc(var(--chi-bs,24px)*.5);height:calc(var(--chi-bs,24px)*.5)} #chlist.chl-cmp .chi.list{height:132px;display:grid;grid-template-columns:52px minmax(0,1fr);grid-template-rows:78px auto;column-gap:12px;row-gap:6px;align-items:center;align-content:center;padding:8px 10px}#chlist.chl-cmp .chi.list .chi-actions{grid-column:1/-1;grid-row:2;justify-self:end;margin:0;gap:4px;position:static;transform:none} #chlist.chl-cmp .chi.grid .chi-actions{position:static;left:auto;right:auto;bottom:auto;width:100%;box-sizing:border-box;padding:0 4px 4px;margin:0;justify-content:center;gap:3px;flex-wrap:nowrap!important}#chlist .chi.grid .chi-actions .chi-act-btn{flex:0 1 auto;min-width:0;box-sizing:border-box}html #app:fullscreen #chpanel.fs-open #chlist .chi.grid .chi-actions,html.fs-fallback #chpanel.fs-open #chlist .chi.grid .chi-actions{flex-wrap:nowrap!important}#chlist.chl-cmp .chi.grid .chi-act-btn,#chlist.chl-cmp .chi.grid .chi-drag-h{background:var(--bg3);border:1px solid var(--bord);backdrop-filter:none} .chi.ch-kbmove{outline:3px solid var(--acc3,#fbbf24)!important;outline-offset:-3px;box-shadow:0 0 0 4px rgba(251,191,36,.28),0 10px 26px rgba(0,0,0,.55)!important;z-index:6}.chi.ch-kbmove .chi-drag-h{background:var(--acc,#f97316)!important;border-color:var(--acc,#f97316)!important;color:#fff!important}#chKbMove{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:2147482000;display:none;align-items:center;gap:10px;max-width:92vw;box-sizing:border-box;padding:10px 16px;border-radius:14px;background:rgba(15,15,20,.95);color:#fff;border:2px solid var(--acc3,#fbbf24);font:700 .85rem/1.3 'Outfit',system-ui,sans-serif;pointer-events:none;box-shadow:0 10px 30px rgba(0,0,0,.6)}#chKbMove.show{display:flex}#chKbMove b{color:var(--acc3,#fbbf24)} #chlist>#chlist-spacer{grid-column:1/-1!important}</style>
