d var(--bord,rgba(255,255,255,.1));border-bottom:1px solid var(--bord,rgba(255,255,255,.1));-webkit-overflow-scrolling:touch;scrollbar-width:none}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #sidebar::-webkit-scrollbar{display:none}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #sidebar>*{flex:none!important}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #sidebar-catlist{display:flex!important;flex-direction:row!important;align-items:center!important;gap:6px!important;width:auto!important;max-width:none!important;overflow:visible!important}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #chpanel,html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #chpanel.open{grid-column:1;grid-row:3;width:auto!important;max-width:none!important}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .catbtn{width:auto!important;min-width:0!important;max-width:none!important;min-height:36px!important;height:36px!important;flex-direction:row!important;justify-content:center!important;align-items:center!important;gap:6px!important;padding:0 12px!important;border-radius:18px!important;overflow:visible!important}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .catbtn .ci{width:18px!important;height:18px!important;flex-shrink:0}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .catbtn .cl{font-size:.78rem!important;line-height:1.1!important;text-align:left!important;text-transform:none!important;flex:none!important;max-width:none!important;overflow:visible!important;text-overflow:clip!important;white-space:nowrap!important}html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .catdiv,html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .umit-fs-row,html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) .cat-search-side,html.umit-phonetv:not(.umit-fs-on):not(.mm-nonlive):not(.vod-skin) #chExitSideBtn{display: