<style id="perfrec-css">#perfrec-modal{position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}#perfrec-modal.show{display:flex}#perfrec-modal.mini{inset:auto;right:12px;bottom:12px;left:auto;top:auto;width:min(420px,46vw);background:transparent;padding:0;pointer-events:none;align-items:flex-end;justify-content:flex-end}.perfrec-card{width:min(760px,100%);max-height:100%;overflow:auto;background:#1a120e;border:1px solid #5a3a2a;border-radius:14px;padding:16px;box-sizing:border-box;color:#fff;font-family:system-ui,sans-serif}#perfrec-modal.mini .perfrec-card{width:100%;max-height:60vh;pointer-events:auto;background:rgba(26,18,14,.95);font-size:13px;padding:10px}#perfrec-modal.mini .perfrec-hdr,#perfrec-modal.mini .perfrec-btns{display:none}#perfrec-modal.mini .perfrec-out{min-height:0;max-height:40vh;font-size:12px}#perfrec-modal.mini .perfrec-note{display:none}.perfrec-hdr{display:flex;align-items:center;gap:12px;margin-bottom:12px}.perfrec-ttl{font-weight:700;letter-spacing:.5px}.perfrec-btns{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}.perfrec-btn{background:#2b1d16;color:#fff;border:2px solid #5a3a2a;border-radius:10px;padding:10px 16px;font-size:16px;cursor:pointer}.perfrec-btn:focus,.perfrec-btn:focus-visible{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--bord2)}.perfrec-btn.on{background:#7f1d1d;border-color:#ef4444}.perfrec-out{background:#0d0907;border-radius:10px;padding:12px;font-size:14px;line-height:1.5;white-space:pre-wrap;margin:0 0 12px;min-height:200px;max-height:50vh;overflow:auto}.perfrec-note{font-size:13px;color:#c9b3a6;line-height:1.5}#perfrec-badge{position:fixed;left:8px;bottom:8px;z-index:99999;display:none;background:rgba(127,29,29,.92);color:#fff;font:12px/1.3 monospace;padding:4px 8px;border-radius:6px;pointer-events:none}#perfrec-badge.show{display:block}</style>
<div id="perfrec-modal" role="dialog">
  <div class="perfrec-card">
    <div class="perfrec-hdr">
      <button class="perfrec-btn" onclick="perfRecClose()">‹ Geri</button>
      <div class="perfrec-ttl">PERFORMANS KAYDI</div>
    </div>
    <div class="perfrec-btns">
      <button class="perfrec-btn" id="perfrec-toggle" onclick="perfRecToggle()">● Kaydı Başlat</button>
      <button class="perfrec-btn" onclick="perfRecSave()">Hesaba Kaydet</button><button class="perfrec-btn" onclick="perfRecScroll(-200)">▲</button><button class="perfrec-btn" onclick="perfRecScroll(200)">▼</button>
      <button class="perfrec-btn" onclick="perfRecClear()">Temizle</button>
    </div>
    <pre id="perfrec-out" class="perfrec-out"></pre>
    <div class="perfrec-note">Kayıt başlayınca bu pencere sağ alta küçülür ve kumanda uygulamaya döner. Durdurmak için Ayarlar → Performans Kaydı. Bitince Hesaba Kaydet: veri Firebase'e yazılır ve ekranda tam metin görünür. ▲▼ ile metni kaydır.</div>
  </div>
</div>
<div id="perfrec-badge"></div>
