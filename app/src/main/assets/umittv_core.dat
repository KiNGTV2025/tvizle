          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body as-collapse-body-tall" id="as-collapse-theme">
          <div class="as-theme-sec-hd">
            <span class="as-sec-ico">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            </span>
            <span>Premium Temalar</span>
          </div>
          <div class="as-theme-grid" id="as-theme-grid"></div>
        </div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5C3.9 3 3 3.9 3 5v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
        </span><span>TV Rehberi (EPG)</span></div>
        <input type="url" id="as-epg-url" class="as-input" placeholder="Özel XMLTV Linki (opsiyonel)" onblur="asPersistEpgUrlFromInput()">
        <div class="as-row-inline">
          <span class="as-row-lbl">Saat Kayması</span>
          <div class="as-stepper">
            <button onclick="asStepEpgOffset(-1)" aria-label="Azalt">−</button>
            <span id="as-epg-offset-val">0</span>
            <button onclick="asStepEpgOffset(1)" aria-label="Artır">+</button>
          </div>
        </div>
        <button class="as-link-btn" onclick="asRefreshEpgNow()">Yayın Akışını Şimdi Yenile</button>
      </div>

      
      <div class="as-sec as-collapse as-collapse-accent" id="as-collapse-wrap-weguide">
        <button class="as-collapse-hd" onclick="asToggleCollapse('weguide');weOnAccordionToggle();">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 3H4a2 2 0 00-2 2v14a2 2 0 002 2h16a2 2 0 002-2V5a2 2 0 00-2-2zm0 16H4V8h16v11zM6 10h4v3H6zm5 0h4v3h-4zm5 0h2v3h-2zM6 14h4v3H6zm5 0h6v3h-6z"/></svg>
          </span>
          <span class="as-collapse-txt">
            <span class="as-collapse-t">Haftalık TV Rehberi</span>
            <span class="as-collapse-s">Kanal × saat yayın akışı, program detayı ve hatırlatıcı</span>
          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body as-collapse-body-tall" id="as-collapse-weguide">
          <div id="we-wrap">
            <div class="we-toolbar">
              <div class="we-days" id="we-days"></div>
              <div class="we-searchwrap">
                <input type="text" class="we-search" id="we-search" placeholder="Kanal veya program ara...">
                <span class="we-remind-count" id="we-remind-count" onclick="weShowReminderList()" title="Kurulu hatırlatıcılar" tabindex="0" role="button" onkeydown="if(event.key==='Enter'||event.key==='Select'){event.preventDefault();this.click();}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
                  <span id="we-remind-count-n">0</span>
                </span>
              </div>
            </div>
            <div class="we-body" id="we-body">
              <div class="we-grid" id="we-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="as-sec as-toggle-sec">
        <label class="as-toggle-row" for="as-swipe-toggle">
          <span class="as-toggle-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 5l-1.41 1.41L11.17 10H2v2h9.17l-3.58 3.59L9 17l6-6-6-6zm6 0l-1.41 1.41L17.17 10H8v2h9.17l-3.58 3.59L15 17l6-6-6-6z" transform="scale(-1,1) translate(-24,0)"/></svg>
          </span>
          <span class="as-toggle-txt">Kaydırarak Kanal Değiştir (Canlı TV)</span>
          <input type="checkbox" id="as-swipe-toggle" onchange="asSetSwipe(this.checked)">
          <span class="as-switch"></span>
        </label>
      </div>

      
      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v10H4V6zm2 12h12v2H6v-2z"/></svg>
        </span><span>Kanal Değiştirme Ekranı</span></div>
        <div class="as-seg" id="as-chswitch-seg">
          <button data-v="smart" onclick="asSetChSwitchMode('smart')">Akıllı (Önerilen)</button>
          <button data-v="freeze" onclick="asSetChSwitchMode('freeze')">Donarak Geçiş</button>
          <button data-v="fast" onclick="asSetChSwitchMode('fast')">Hızlı (Siyah Ekran Olabilir)</button>
        </div>
        <div class="as-hint" id="as-chswitch-hint"></div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.5 15.5l-3-3 1.41-1.41L10.5 14.67l5.09-5.09L17 11l-6.5 6.5z"/></svg>
        </span><span>Akıllı Ağ / Arabellek Modu</span></div>
        <div class="as-seg" id="as-netmode-seg">
          <button data-v="lowlatency" onclick="asSetNetMode('lowlatency')">Düşük Gecikme</button>
          <button data-v="balanced" onclick="asSetNetMode('balanced')">Dengeli</button>
          <button data-v="highbuffer" onclick="asSetNetMode('highbuffer')">Yüksek Arabellek</button>
        </div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 1.99-.9 1.99-2L23 5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z"/></svg>
        </span><span>Oynatıcı</span></div>
        <div class="as-hint" style="margin:0 0 6px;font-weight:700;opacity:.9">Canlı TV</div>
        <div class="as-seg" id="as-liveplayer-seg">
          <button data-v="internal" onclick="asSetLivePlayer('internal')">Dahili</button>
          <button data-v="external" onclick="asSetLivePlayer('external')">Harici (Exo/VLC/MX)</button>
        </div>
        <div class="as-hint" style="margin:14px 0 6px;font-weight:700;opacity:.9">Film / Dizi</div>
        <div class="as-seg" id="as-vodplayer-seg">
          <button data-v="internal" onclick="asSetVodPlayer('internal')">Dahili</button>
          <button data-v="external" onclick="asSetVodPlayer('external')">Harici (Exo/VLC/MX)</button>
        </div>
        <label class="as-toggle-row" for="as-vodlive-toggle" style="margin-top:12px">
          <span class="as-toggle-txt">Canlı yayın (m3u8/ts) bağlantıları Harici seçiliyken de dahili oynatıcıda açılsın</span>
          <input type="checkbox" id="as-vodlive-toggle" onchange="asSetVodLiveInternal(this.checked)">
          <span class="as-switch"></span>
        </label>
        <div class="as-hint">Harici: içerik cihazdaki oynatıcıda (Just Player, VLC, MX Player vb.) açılır; sadece Android uygulamasında çalışır. Canlı TV'de her kanal geçişinde açılır, uygulama açılışındaki otomatik kanal etkilenmez.</div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h18v4H3zm0 6h18v12H3z" opacity=".9"/></svg>
        </span><span>Üst Menü (tam ekran)</span></div>
        <div class="as-seg" id="as-topmenu-seg">
          <button data-v="fixed" onclick="asSetTopMenu('fixed')">Sabit</button>
          <button data-v="withctrl" onclick="asSetTopMenu('withctrl')">Butonlarla Kaybolsun</button>
        </div>
        <div class="as-hint">Sabit: tam ekranda üst menü hep görünür. Butonlarla Kaybolsun: oynatıcı butonları açılınca görünür, kapanınca o da kaybolur.</div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
        </span><span>Alt Çubuk (kanal adı · CANLI · saat)</span></div>
        <div class="as-seg" id="as-clockmode-seg">
          <button data-v="fixed" onclick="asSetClockMode('fixed')">Sabit</button>
          <button data-v="withctrl" onclick="asSetClockMode('withctrl')">Butonlarla Kaybolsun</button>
          <button data-v="off" onclick="asSetClockMode('off')">Kaldır</button>
        </div>
        <div class="as-hint">Sabit: alt çubuk hep görünür. Butonlarla Kaybolsun: oynatıcı butonları açılınca görünür, kapanınca o da kaybolur. Kaldır: alt çubuk hiç gösterilmez (yer kazanılır).</div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="7"/></svg>
        </span><span>Kayıtlarım</span></div>
        <div class="as-seg"><button onclick="openRecLibrary()">Kayıtları Aç</button></div>
        <div class="as-seg" id="as-recmode-seg" style="margin-top:8px">
          <button data-v="canvas" onclick="asSetRecMode('canvas')">Hafif (önerilen)</button>
          <button data-v="raw" onclick="asSetRecMode('raw')">Doğrudan akış</button>
        </div>
        <div class="as-hint">Canlı yayında aldığın kayıtlar uygulamada saklanır; buradan izleyebilir, indirebilir veya silebilirsin.</div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        </span><span>Listeyi M3U Olarak Dışa Aktar</span></div>
        <div class="as-seg" id="as-m3uexp-seg">
          <button onclick="exportM3UPick('live')">Canlı TV</button>
          <button onclick="exportM3UPick('vod')">Filmler</button>
          <button onclick="exportM3UPick('copy')">Panoya Kopyala</button>
        </div>
        <div class="as-hint" id="as-m3uexp-hint">Yüklü listedeki yayınları .m3u dosyası yapar; indirmeden önce kategorileri seçebilirsin. Dikkat: bağlantılarda hesap şifren yer alır, dosyayı kimseyle paylaşma.</div>
      </div>

      <div class="as-sec">
        <div class="as-sec-hd"><span class="as-sec-ico">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 1h9v6H4V1zm0 8h9v6H4V9zm0 8h9v6H4v-6zM15 4h5v3h-5V4zm0 9h5v3h-5v-3z"/></svg>
        </span><span>DNS Sağlayıcısı (ISS Engeli Aşma)</span></div>
        <div class="as-seg as-seg-4" id="as-dns-seg">
          <button data-v="cloudflare" onclick="asSetDns('cloudflare')">Cloudflare</button>
          <button data-v="google" onclick="asSetDns('google')">Google</button>
          <button data-v="quad9" onclick="asSetDns('quad9')">Quad9</button>
          <button data-v="adguard" onclick="asSetDns('adguard')">AdGuard</button>
        </div>
        <div class="as-hint">Yayın engellendiğinde istekler seçilen DoH sağlayıcısı üzerinden çözülmeye çalışılır.</div>
        <label class="as-toggle-row as-row-as-toggle" for="as-dnsprotect-toggle">
          <span class="as-toggle-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 15l-4-4 1.41-1.41L11 13.17l5.59-5.59L18 9l-7 7z"/></svg>
          </span>
          <span class="as-toggle-txt">DNS Koruma (DoH)</span>
          <input type="checkbox" id="as-dnsprotect-toggle" onchange="asSetDnsProtect(this.checked)">
          <span class="as-switch"></span>
        </label>
        <div class="as-hint" id="as-dnsprotect-hint">Açıkken http yayınların alan adı seçili DoH sağlayıcısıyla çözülür (ISS DNS engelini aşar). https ve proxy yayınlara dokunmaz.</div>
      </div>

      <div class="as-sec as-collapse">
        <button class="as-collapse-hd" onclick="asToggleCollapse('speed')">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 14l4-5"/><path d="M3.5 17a9.5 9.5 0 1117 0"/><circle cx="12" cy="14" r="1.2" fill="currentColor"/></svg>
          </span>
          <span class="as-collapse-txt">
            <span class="as-collapse-t">İnternet Hız Testi</span>
            <span class="as-collapse-s">Ping, indirme ve yükleme hızını ölç</span>
          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body" id="as-collapse-speed">
          <div class="spd-wrap">
            <div class="spd-meter"><span class="spd-val" id="spd-val">0.0</span><span class="spd-unit">Mbps</span></div>
            <div class="spd-phase" id="spd-phase">Teste hazır</div>
            <div class="spd-barw"><div class="spd-bar" id="spd-bar"></div></div>
            <div class="spd-grid">
              <div class="spd-tile"><div class="spd-tl">İNDİRME</div><div class="spd-tv" id="spd-dl">—</div><div class="spd-tu">Mbps</div></div>
              <div class="spd-tile"><div class="spd-tl">YÜKLEME</div><div class="spd-tv" id="spd-ul">—</div><div class="spd-tu">Mbps</div></div>
              <div class="spd-tile"><div class="spd-tl">PING</div><div class="spd-tv" id="spd-ping">—</div><div class="spd-tu">ms</div></div>
              <div class="spd-tile"><div class="spd-tl">JİTTER</div><div class="spd-tv" id="spd-jit">—</div><div class="spd-tu">ms</div></div>
            </div>
            <div class="spd-verdict" id="spd-verdict"></div>
            <div class="spd-sug" id="spd-sug" style="display:none;"></div>
            <button class="spd-btn" id="spd-btn" type="button" onclick="spdStart()">Testi Başlat</button>
            <div class="as-hint">Test yaklaşık 20 saniye sürer ve mobil veride yüzlerce MB'a kadar veri kullanabilir. Ölçüm Cloudflare sunucularıyla yapılır.</div>
          </div>
        </div>
      </div>

      <div class="as-sec as-collapse">
        <button class="as-collapse-hd" onclick="asToggleCollapse('security')">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          </span>
          <span class="as-collapse-txt">
            <span class="as-collapse-t">Güvenlik &amp; Gizlilik</span>
            <span class="as-collapse-s">Ebeveyn kontrolü, şifre işlemleri</span>
          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body" id="as-collapse-security">
          <button class="as-row" onclick="openParentalLockSettings()">
            <span class="as-row-t">Ebeveyn Kilidi</span><span class="as-chev">›</span>
          </button>
          <button class="as-row" onclick="openAppPasswordSettings()">
            <span class="as-row-t">Uygulama Şifresi</span><span class="as-chev">›</span>
          </button>
        </div>
      </div>

      <div class="as-sec as-collapse">
        <button class="as-collapse-hd" onclick="asToggleCollapse('data')">
          <span class="as-collapse-ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/></svg>
          </span>
          <span class="as-collapse-txt">
            <span class="as-collapse-t">Sistem &amp; Veri Yönetimi</span>
            <span class="as-collapse-s">İzleme geçmişi temizleme, önbellek ve oturum kapatma</span>
          </span>
          <span class="as-collapse-chev">›</span>
        </button>
        <div class="as-collapse-body" id="as-collapse-data">
          <button class="as-row" onclick="asSetDlProxy()">
            <span class="as-row-t">İndirme Sunucusu</span><span id="as-dlproxy-v" style="margin-left:auto;margin-right:8px;font-size:.75rem;font-weight:700;color:var(--text2);">Tanımsız</span><span class="as-chev">›</span>
          </button>
          <button class="as-row" onclick="asClearWatchHistory()">
            <span class="as-row-t">İzleme Geçmişini Temizle</span><span class="as-chev">›</span>
          </button>
          <button class="as-row" onclick="asClearCache()">
            <span class="as-row-t">Önbelleği Temizle</span><span class="as-chev">›</span>
          </button>
          <button class="as-row as-row-danger" onclick="asLogoutConfirm()">
            <span class="as-row-t">Oturumu Kapat</span><span class="as-chev">›</span>
          </button>
        </div>
      </div>

      <div class="as-ver">Ümitmod</div>
    </div>
  </div>
</div>


<div id="catManageModal">
  <div class="as-card">
    <div class="as-hdr">
      <button class="as-back" onclick="closeCatManageModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </button>
      <div class="as-ttl">KATEGORİ YÖNETİMİ</div>
    </div>
    <div class="as-body">
      <div class="as-hint" style="margin:0 0 14px;">Göz ikonuna dokunarak kategoriyi gizleyip gösterebilir, kilit ikonuna dokunarak PIN korumalı hale getirebilirsin. Tutamaçtan sürükleyerek sırasını değiştirebilirsin.</div>
      <div class="as-sec" style="padding:8px;">
        <div id="cm-pin-row" class="as-row-inline" style="padding:8px 8px 14px;">
          <span class="as-row-lbl">Kilit PIN'i</span>
          <button class="as-link-btn" onclick="asSetCatLockPin()" id="cm-pin-btn">PIN Belirle</button>
        </div>
        <div id="cm-cat-list"></div>
      </div>
    </div>
  </div>
</div>


<div id="childModeModal">
  <div class="as-card">
    <div class="as-hdr">
      <button class="as-back" onclick="closeChildModeModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      </button>
      <div class="as-ttl">ÇOCUK MODU</div>
    </div>
    <div class="as-body">
      <div class="as-hint" style="margin:0 0 14px;">Çocuk Modu açıldığında sadece aşağıda işaretlediğin kategoriler görünür olur — aramalar da dahil. Diğer her şey (film/dizi sekmeleri, yetişkin yayınlar, işaretlemediğin kategoriler) gizlenir.</div>
      <div class="as-sec" style="padding:8px;">
        <div id="cmode-cat-list"></div>
      </div>
      <button class="as-row as-row-cta" onclick="startChildModeFromModal()" id="cmode-start-btn">
        <span class="as-row-t">Çocuk Modunu Başlat</span><span class="as-chev">›</span>
      </button>
    </div>
  </div>
</div>


<div id="childModeBadge" onclick="exitChildModeRequest()">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
  <span>Çocuk Modu — Çıkmak için dokun</span>
</div>

<div id="kbh">
  <h4 style="display:flex;align-items:center;gap:6px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20 5H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zM7 8h2v2H7V8zm0 3h2v2H7v-2zM4 8h2v2H4V8zm0 3h2v2H4v-2zm3 5H4v-2h3v2zm5 0h-4v-2h4v2zm0-3h-2v-2h2v2zm0-3h-2V8h2v2zm3 6h-2v-2h2v2zm0-3h-2v-2h2v2zm0-3h-2V8h2v2zm3 6h-2v-2h2v2zm0-3h-2v-2h2v2zm0-3h-2V8h2v2z"/></svg>Kumanda Tuşları</h4>
  <div class="kbr"><span class="kbk kbk-arrows"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-8 8h5v8h6v-8h5z"/></svg><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 20l8-8h-5V4h-6v8H4z"/></svg></span><span class="kbd">Kanal değiştir</span></div>
  <div class="kbr"><span class="kbk kbk-arrows"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M4 12l8-8v5h8v6h-8v5z"/></svg><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M20 12l-8-8v5H4v6h8v5z"/></svg></span><span class="kbd">Kategori geç</span></div>
  <div class="kbr"><span class="kbk">0–9</span><span class="kbd">Kanal no gir</span></div>
  <div class="kbr"><span class="kbk">Enter</span><span class="kbd">Oyna</span></div>
  <div class="kbr"><span class="kbk">Space</span><span class="kbd">Duraklat</span></div>
  <div class="kbr"><span class="kbk">M</span><span class="kbd">Sessiz</span></div>
  <div class="kbr"><span class="kbk">F</span><span class="kbd">Tam ekran</span></div>
  <div class="kbr"><span class="kbk">E</span><span class="kbd">EPG aç/kapat</span></div>
  <div class="kbr"><span class="kbk">P</span><span class="kbd">Önceki kanal</span></div>
  <div class="kbr"><span class="kbk">Z</span><span class="kbd">Görüntü modu</span></div>
</div>
<div id="toast"></div>

<div id="rec-status-bar">
  <div class="rec-dot"></div>
  <span id="rec-status-txt">Kaydediliyor 0:00</span>
  <button onclick="stopRecordingAndSave()" style="background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);border-radius:6px;padding:3px 10px;color:#fff;font-size:.72rem;cursor:pointer;font-family:'Outfit',sans-serif;font-weight:700;">Bitir & İndir</button>
</div>

<script>_u("")</script>

<div id="we-modal-scrim" onclick="if(event.target===this)weCloseModal()">
  <div class="we-modal">
    <div class="we-modal-title" id="we-modal-title"></div>
    <div class="we-modal-meta" id="we-modal-meta"></div>
    <div class="we-modal-desc" id="we-modal-desc"></div>
    <div class="we-modal-actions">
      <button class="we-modal-close" onclick="weCloseModal()">Kapat</button>
      <button class="we-modal-remind" id="we-modal-remind-btn" onclick="weToggleReminder()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
        <span id="we-modal-remind-txt">Hatırlat</span>
      </button>
    </div>
  </div>
</div>


<div id="we-rlist-scrim" onclick="if(event.target===this)weCloseReminderList()">
  <div class="we-modal we-rlist-modal">
    <div class="we-modal-title">Hatırlatıcılar</div>
    <ul class="we-rlist" id="we-rlist-body"></ul>
    <div class="we-modal-actions">
      <button class="we-modal-close" onclick="weCloseReminderList()">Kapat</button>
    </div>
  </div>
</div>

<script>_u("")</script>


<style id="x12-style">.x12-modal{position:fixed;inset:0;z-index:380;display:none;background:var(--bg0);flex-direction:column}.x12-modal.show{display:flex}.x12-hdr{flex-shrink:0;display:flex;align-items:center;gap:12px;padding:16px;border-bottom:1px solid var(--bord);background:var(--bg1)}.x12-back{width:36px;height:36px;flex-shrink:0;border-radius:50%;border:none;background:transparent;color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer}.x12-back:hover,.x12-back:focus-visible{background:var(--bg3);outline:2px solid var(--acc);outline-offset:1px}.x12-ttl{font-size:1.1rem;font-weight:800;letter-spacing:.5px;color:var(--text)}.x12-body{flex:1;overflow-y:auto;padding:16px;max-width:640px;width:100%;margin:0 auto;box-sizing:border-box;scrollbar-width:thin;scrollbar-color:var(--bord) transparent}.x12-card{background:var(--bg2);border:1px solid var(--bord);border-radius:var(--r);padding:14px;margin-bottom:12px}.x12-card h4{margin:0 0 8px;font-size:.92rem;color:var(--acc2);font-weight:800}.x12-hint{font-size:.74rem;color:var(--text2);line-height:1.45;margin:6px 0 10px}.x12-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:8px 14px;border-radius:var(--r2);border:1px solid var(--bord2);background:var(--bg3);color:var(--text);font-weight:700;font-size:.82rem;cursor:pointer;margin:4px 6px 4px 0}.x12-btn:hover,.x12-btn:focus-visible{background:var(--acc);color:#000;outline:none}.x12-btn.pri{background:var(--acc);color:#000;border-color:var(--acc)}.x12-btn.dng{border-color:var(--red);color:var(--red)}.x12-btn.dng:hover{background:var(--red);color:#fff}.x12-btn:disabled{opacity:.45;cursor:not-allowed}.x12-in{width:100%;box-sizing:border-box;padding:10px 12px;border-radius:var(--r2);border:1px solid var(--bord2);background:var(--bg1);color:var(--text);font-size:.85rem;margin:4px 0}.x12-in:focus{outline:2px solid var(--acc)}.x12-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--bord);font-size:.84rem;color:var(--text)}.x12-row:last-child{border-bottom:none}.x12-row small{color:var(--text2)}.x12-prog{height:8px;border-radius:6px;background:var(--bg4);overflow:hidden;margin:8px 0}.x12-prog>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2));transition:width .2s}.x12-list{max-height:46vh;overflow-y:auto;border:1px solid var(--bord);border-radius:var(--r2)}.x12-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid var(--bord);font-size:.8rem;color:var(--text)}.x12-item:last-child{border-bottom:none}.x12-item .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.x12-item .st{font-size:.7rem;font-weight:800;padding:2px 7px;border-radius:8px}.x12-item .st.ok{background:rgba(16,217,160,.18);color:var(--green)}.x12-item .st.bad{background:rgba(239,68,68,.18);color:var(--red)}.x12-item .st.unk{background:var(--bg4);color:var(--text2)}.x12-bars{display:flex;align-items:flex-end;gap:6px;height:110px;margin:10px 0 4px}.x12-bars>div{flex:1;background:linear-gradient(to top,var(--acc),var(--acc2));border-radius:5px 5px 0 0;min-height:3px;position:relative}.x12-bars>div span{position:absolute;bottom:-18px;left:0;right:0;text-align:center;font-size:.62rem;color:var(--text2)}.x12-bars>div b{position:absolute;top:-16px;left:0;right:0;text-align:center;font-size:.6rem;color:var(--acc2);font-weight:700}.x12-slot{display:grid;grid-template-columns:34px 1fr auto;gap:8px;align-items:center;padding:6px 0}.x12-slot .k{width:34px;height:34px;border-radius:9px;background:var(--acc);color:#000;font-weight:900;display:flex;align-items:center;justify-content:center}.x12-qr{background:#fff;padding:12px;border-radius:12px;display:inline-block;margin:8px 0}.x12-qr canvas,.x12-qr img{display:block}.x12-overlay-pill{position:fixed;z-index:120;left:50%;transform:translateX(-50%);top:calc(env(safe-area-inset-top,0px) + 10px);background:rgba(0,0,0,.72);color:#fff;border:1px solid rgba(255,255,255,.18);border-radius:22px;padding:6px 14px;font-size:.8rem;font-weight:700;display:none;align-items:center;gap:10px;backdrop-filter:blur(6px);max-width:92vw}.x12-overlay-pill.show{display:flex}.x12-overlay-pill .sc{font-size:1rem;font-weight:900;color:var(--acc2);letter-spacing:1px}.x12-overlay-pill .tm{font-size:.7rem;color:#ffb066}.x12-nextep{position:fixed;z-index:130;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 90px);background:rgba(10,6,0,.92);border:1px solid var(--bord2);border-radius:14px;padding:12px 14px;min-width:230px;max-width:80vw;color:#fff;box-shadow:var(--sh);display:none}.x12-nextep.show{display:block}.x12-nextep b{display:block;font-size:.72rem;color:var(--acc2);margin-bottom:2px}.x12-nextep .t{font-size:.86rem;font-weight:800;margin-bottom:8px}.x12-srcmenu{position:fixed;z-index:300;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg1);border:1px solid var(--bord2);border-radius:16px;padding:14px;width:min(92vw,380px);box-shadow:var(--sh);display:none}.x12-srcmenu.show{display:block}.x12-profsel{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}.x12-prof{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 12px;border-radius:12px;border:2px solid var(--bord);background:var(--bg3);color:var(--text);cursor:pointer;min-width:74px;font-size:.78rem;font-weight:700}.x12-prof.on{border-color:var(--acc);background:rgba(249,115,22,.14)}.x12-prof i{width:38px;height:38px;border-radius:50%;background:var(--acc);color:#000;font-style:normal;font-weight:900;font-size:1.05rem;display:flex;align-items:center;justify-content:center}.x12-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;font-size:.84rem}.x12-toggle input{width:20px;height:20px;accent-color:var(--acc)}</style>


<div id="x12DeadModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12DeadModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">KANAL SAĞLIK DENETİMİ</div></div>
  <div class="x12-body">
    <div class="x12-card">
      <h4>Aktif listeyi tara</h4>
      <div class="x12-hint">Her kanala kısa bir istek atılır; yanıt vermeyenler "ölü" işaretlenir. Referer/UA korumalı yayınlar proxy üzerinden denenir. Büyük listelerde birkaç dakika sürebilir; tarama sırasında ekranı açık tut.</div>
      <div id="x12DeadInfo" class="x12-hint"></div>
      <div class="x12-prog"><i id="x12DeadBar"></i></div>
      <button class="x12-btn pri" id="x12DeadStart" onclick="X12.dead.start()">Taramayı Başlat</button>
      <button class="x12-btn" id="x12DeadStop" onclick="X12.dead.stop()" disabled>Durdur</button>
    </div>
    <div class="x12-card">
      <h4>Sonuçlar <small id="x12DeadCount" style="color:var(--text2);font-weight:600"></small></h4>
      <div class="x12-list" id="x12DeadList"><div class="x12-item"><span class="nm" style="color:var(--text2)">Henüz tarama yapılmadı</span></div></div>
      <div style="margin-top:10px">
        <button class="x12-btn" onclick="X12.dead.hideDead()">Ölüleri Gizle</button>
        <button class="x12-btn" onclick="X12.dead.unhideAll()">Gizlemeyi Kaldır</button>
        <button class="x12-btn dng" onclick="X12.dead.removeDead()">Ölüleri Listeden Sil</button>
      </div>
      <div class="x12-hint">"Gizle" geri alınabilir (yalnızca bu cihazda). "Sil" aktif listeden kalıcı çıkarır.</div>
    </div>
  </div>
</div>


<div id="x12BackupModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12BackupModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">YEDEKLE / GERİ YÜKLE</div></div>
  <div class="x12-body">
    <div class="x12-card">
      <h4>Yedek al</h4>
      <div class="x12-hint">Favoriler, kategoriler, kanal adları, kaldığın yer ilerlemesi, listeler, ayarlar ve profiller tek JSON dosyasına yazılır.</div>
      <div id="x12BackupSummary" class="x12-hint"></div>
      <button class="x12-btn pri" onclick="X12.backup.download()">Dosya olarak indir</button>
      <button class="x12-btn" onclick="X12.backup.copy()">Panoya kopyala</button>
    </div>
    <div class="x12-card">
      <h4>Geri yükle</h4>
      <div class="x12-hint">Yedek dosyasını seç veya JSON'u yapıştır. Mevcut veriyle birleştirilir; aynı anahtar varsa yedektekiyle değişir.</div>
      <input type="file" id="x12BackupFile" accept=".json,application/json" class="x12-in">
      <textarea id="x12BackupText" class="x12-in" rows="4" placeholder="veya JSON'u buraya yapıştır"></textarea>
      <button class="x12-btn pri" onclick="X12.backup.restore()">Geri Yükle</button>
    </div>
  </div>
</div>


<div id="x12StatsModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12StatsModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">İZLEME İSTATİSTİKLERİ</div></div>
  <div class="x12-body" id="x12StatsBody"></div>
</div>


<div id="x12ProfModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12ProfModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">PROFİLLER</div></div>
  <div class="x12-body">
    <div class="x12-card">
      <h4>Aktif profil</h4>
      <div class="x12-hint">Her profilin kendi favorileri, izleme geçmişi, kanal adları, kategori düzeni ve istatistiği vardır. Profil değişince sayfa yenilenir.</div>
      <div class="x12-profsel" id="x12ProfSel"></div>
      <input id="x12ProfName" class="x12-in" maxlength="16" placeholder="Yeni profil adı">
      <button class="x12-btn pri" onclick="X12.prof.add()">Profil Ekle</button>
      <button class="x12-btn" onclick="X12.prof.rename()">Aktifi Yeniden Adlandır</button>
      <button class="x12-btn dng" onclick="X12.prof.del()">Aktifi Sil</button>
    </div>
  </div>
</div>


<div id="x12SlotModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12SlotModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">HIZLI NUMARA ATAMA</div></div>
  <div class="x12-body">
    <div class="x12-card">
      <h4>Kumanda kısayolları</h4>
      <div class="x12-hint">Bir rakama <b>uzun bas</b> (0.8 sn) = o an izlediğin kanalı o rakama ata. Rakama kısa basınca normal kanal numarası girişi çalışır; bu nedenle burada tanımlı rakama <b>iki kez hızlı</b> basınca atanmış kanal açılır. Aşağıdan da elle atayabilirsin.</div>
      <div id="x12SlotList"></div>
    </div>
  </div>
</div>


<div id="x12QrModal" class="x12-modal">
  <div class="x12-hdr"><button class="x12-back" onclick="X12.closeModal('x12QrModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button><div class="x12-ttl">QR İLE LİSTE PAYLAŞ</div></div>
  <div class="x12-body">
    <div class="x12-card">
      <h4>Liste seç</h4>
      <select id="x12QrSel" class="x12-in" onchange="X12.qr.render()"></select>
      <div style="text-align:center"><div class="x12-qr" id="x12QrBox"></div></div>
      <div class="x12-hint" id="x12QrTxt"></div>
      <button class="x12-btn" onclick="X12.qr.copy()">Bağlantıyı kopyala</button>
      <button class="x12-btn" onclick="X12.qr.share()">Paylaş…</button>
    </div>
    <div class="x12-card">
      <h4>QR'dan / bağlantıdan içe aktar</h4>
      <div class="x12-hint">Diğer cihazdaki QR'ı telefon kamerasıyla okut, çıkan bağlantıyı buraya yapıştır (veya bu sayfayı o bağlantıyla aç, otomatik eklenir).</div>
      <input id="x12QrIn" class="x12-in" placeholder="umittv-liste://… veya ?x12list=…">
      <button class="x12-btn pri" onclick="X12.qr.importFrom(document.getElementById('x12QrIn').value)">Listeyi Ekle</button>
    </div>
  </div>
</div>


<div id="x12SrcMenu" class="x12-srcmenu">
  <div style="font-weight:800;margin-bottom:6px;color:var(--acc2)">Kaynak Seç</div>
  <div class="x12-hint" id="x12SrcHint"></div>
  <div id="x12SrcList"></div>
  <div style="margin-top:8px;text-align:right"><button class="x12-btn" onclick="X12.src.close()">Kapat</button></div>
</div>


<div id="x12ScorePill" class="x12-overlay-pill"></div>
<div id="x12NextEp" class="x12-nextep"><b>SIRADAKİ BÖLÜM</b><div class="t" id="x12NextEpT"></div>
  <button class="x12-btn pri" onclick="X12.next.go()">Şimdi Oynat (<span id="x12NextEpN">10</span>)</button>
  <button class="x12-btn" onclick="X12.next.cancel()">İptal</button></div>

<script>_u("")</script>


<style id="x13-style">.x13-modal{position:fixed;inset:0;z-index:385;display:none;background:var(--bg0);flex-direction:column}.x13-modal.show{display:flex}.x13-hdr{flex-shrink:0;display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid var(--bord);background:var(--bg1)}.x13-back{width:36px;height:36px;flex-shrink:0;border-radius:50%;border:none;background:transparent;color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer}.x13-back:hover,.x13-back:focus-visible{background:var(--bg3);outline:2px solid var(--acc);outline-offset:1px}.x13-ttl{font-size:1.05rem;font-weight:800;letter-spacing:.5px;color:var(--text)}.x13-body{flex:1;overflow-y:auto;padding:14px;max-width:720px;width:100%;margin:0 auto;box-sizing:border-box;scrollbar-width:thin;scrollbar-color:var(--bord) transparent}.x13-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:7px 13px;border-radius:var(--r2);border:1px solid var(--bord2);background:var(--bg3);color:var(--text);font-weight:700;font-size:.8rem;cursor:pointer;margin:3px 6px 3px 0}.x13-btn:hover,.x13-btn:focus-visible{background:var(--acc);color:#000;outline:none}.x13-btn.pri{background:var(--acc);color:#000;border-color:var(--acc)}.x13-btn.dng{border-color:var(--red);color:var(--red)}.x13-btn.dng:hover{background:var(--red);color:#fff}.x13-in{width:100%;box-sizing:border-box;padding:11px 13px;border-radius:var(--r2);border:1px solid var(--bord2);background:var(--bg1);color:var(--text);font-size:.92rem}.x13-in:focus{outline:2px solid var(--acc)}.x13-hint{font-size:.74rem;color:var(--text2);line-height:1.45;margin:6px 0}.x13-card{background:var(--bg2);border:1px solid var(--bord);border-radius:var(--r);padding:12px;margin-bottom:12px}.x13-card h4{margin:0 0 8px;font-size:.9rem;color:var(--acc2);font-weight:800} .x13-sbox{display:flex;gap:8px;align-items:center;position:sticky;top:0;background:var(--bg0);padding-bottom:10px;z-index:2}.x13-chips{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 10px}.x13-chip{padding:5px 11px;border-radius:16px;border:1px solid var(--bord2);background:var(--bg3);color:var(--text2);font-size:.74rem;font-weight:700;cursor:pointer}.x13-chip.on{background:var(--acc);color:#000;border-color:var(--acc)}.x13-sec{margin:14px 0 6px;font-size:.78rem;font-weight:800;color:var(--acc2);letter-spacing:.6px;text-transform:uppercase}.x13-res{display:flex;align-items:center;gap:10px;padding:8px 6px;border-bottom:1px solid var(--bord);cursor:pointer;border-radius:8px}.x13-res:hover,.x13-res:focus-visible{background:var(--bg3);outline:none}.x13-res img,.x13-res .ph{width:44px;height:44px;flex-shrink:0;border-radius:8px;object-fit:cover;background:var(--bg4);display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:.7rem;font-weight:800}.x13-res.poster img,.x13-res.poster .ph{width:38px;height:56px}.x13-res .tx{flex:1;min-width:0}.x13-res .t{font-size:.86rem;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.x13-res .s{font-size:.72rem;color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.x13-res .tag{font-size:.64rem;font-weight:800;padding:2px 7px;border-radius:8px;background:var(--bg4);color:var(--acc2);flex-shrink:0}.x13-res .tag.live{background:rgba(239,68,68,.18);color:var(--red)}.x13-empty{text-align:center;color:var(--text2);padding:30px 0;font-size:.85rem}.x13-more{display:block;width:100%;text-align:center;padding:8px;color:var(--acc2);font-size:.76rem;font-weight:700;cursor:pointer} .x13-skip{position:fixed;z-index:131;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 150px);display:none;align-items:center;gap:8px;background:rgba(10,6,0,.9);border:1.5px solid var(--acc);color:#fff;border-radius:22px;padding:10px 18px;font-weight:800;font-size:.86rem;cursor:pointer;box-shadow:var(--sh)}.x13-skip.show{display:flex}.x13-skip:hover,.x13-skip:focus-visible,.x13-skip:focus{background:var(--acc);color:#000;outline:none}.x13-skip:focus{box-shadow:0 0 0 3px #fff,0 0 18px var(--acc);transform:scale(1.06)} #x13SkipBtn:focus,#x13SkipBtn:focus-visible,.x13-skip:focus,.x13-skip:focus-visible{position:fixed!important;left:auto!important;width:auto!important;z-index:131!important}.x13-mark{position:absolute;top:-3px;height:14px;background:rgba(251,191,36,.55);border-radius:3px;pointer-events:none;z-index:2} .x13-radio{position:fixed;inset:0;z-index:125;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:radial-gradient(circle at 50% 35%,var(--bg3),var(--bg0) 70%);padding:24px;text-align:center}.x13-radio.show{display:flex}.x13-radio .art{width:min(52vw,220px);height:min(52vw,220px);border-radius:24px;background:var(--bg4) center/cover no-repeat;box-shadow:var(--sh);border:2px solid var(--bord2);display:flex;align-items:center;justify-content:center;color:var(--acc)}.x13-radio .art.pulse{animation:x13pulse 2.4s ease-in-out infinite}@keyframes x13pulse{0%,100%{box-shadow:0 0 0 0 rgba(249,115,22,.35),var(--sh)}50%{box-shadow:0 0 0 22px rgba(249,115,22,0),var(--sh)}}.x13-radio .nm{font-size:1.15rem;font-weight:900;color:var(--text);max-width:88vw}.x13-radio .pr{font-size:.85rem;color:var(--text2);max-width:88vw}.x13-radio .row{display:flex;gap:12px;align-items:center;margin-top:8px}.x13-radio .rb{width:52px;height:52px;border-radius:50%;border:1px solid var(--bord2);background:var(--bg3);color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer}.x13-radio .rb.big{width:68px;height:68px;background:var(--acc);color:#000;border-color:var(--acc)}.x13-radio .rb:hover,.x13-radio .rb:focus-visible{outline:2px solid var(--acc);outline-offset:2px}.x13-radio .bar{width:min(80vw,360px);height:6px;border-radius:4px;background:var(--bg4);overflow:hidden}.x13-radio .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2))}.x13-radio .tm{font-size:.72rem;color:var(--text2)}.x13-radio .exit{margin-top:10px} .x13-bm-item{display:flex;align-items:center;gap:10px;padding:10px 4px;border-bottom:1px solid var(--bord)}.x13-bm-item:last-child{border-bottom:none}.x13-bm-item .tx{flex:1;min-width:0;cursor:pointer}.x13-bm-item .t{font-size:.86rem;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.x13-bm-item .s{font-size:.72rem;color:var(--text2)}.x13-bm-item .tm{font-size:.8rem;font-weight:900;color:var(--acc2);flex-shrink:0}.x13-bm-item .x{width:30px;height:30px;border-radius:50%;border:none;background:var(--bg3);color:var(--text2);cursor:pointer;flex-shrink:0}.x13-bm-item .x:hover{background:var(--red);color:#fff}.x13-bmpanel{position:fixed;z-index:300;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg1);border:1px solid var(--bord2);border-radius:16px;padding:14px;width:min(94vw,400px);max-height:70vh;overflow-y:auto;box-shadow:var(--sh);display:none}.x13-bmpanel.show{display:block} .x13-nextep-pre{position:fixed;z-index:132;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 90px);display:none;gap:10px;align-items:stretch;background:rgba(10,6,0,.94);border:1px solid var(--bord2);border-radius:14px;padding:10px;width:min(88vw,330px);color:#fff;box-shadow:var(--sh)}.x13-nextep-pre.show{display:flex}.x13-nextep-pre .th{width:96px;flex-shrink:0;border-radius:8px;background:var(--bg4) center/cover no-repeat;aspect-ratio:16/10}.x13-nextep-pre .in{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between}.x13-nextep-pre b{font-size:.68rem;color:var(--acc2);letter-spacing:.5px}.x13-nextep-pre .t{font-size:.8rem;font-weight:800;line-height:1.25;margin:2px 0 6px;max-height:2.5em;overflow:hidden}.x13-nextep-pre .rr{display:flex;gap:6px;flex-wrap:wrap}.x13-nextep-pre .rr .x13-btn{min-height:30px;padding:4px 10px;font-size:.72rem;margin:0}.x13-nextep-pre .cd{position:absolute;top:-9px;left:12px;background:var(--acc);color:#000;font-weight:900;font-size:.72rem;padding:2px 9px;border-radius:10px}.x13-nextep-pre{position:fixed}html.tv-device .x13-skip,html.tv-device .x13-nextep-pre{bottom:calc(env(safe-area-inset-bottom,0px) + 120px)}</style>


<div id="x13SearchModal" class="x13-modal">
  <div class="x13-hdr">
    <button class="x13-back" onclick="X13.closeModal('x13SearchModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button>
    <div class="x13-ttl">GLOBAL ARAMA</div>
  </div>
  <div class="x13-body">
    <div class="x13-sbox">
      <input id="x13SearchIn" class="x13-in" type="search" autocomplete="off" placeholder="Kanal, film, dizi veya program ara..." oninput="X13.search.onInput(this.value)">
    </div>
    <div class="x13-chips" id="x13SearchChips">
      <span class="x13-chip on" data-f="all" onclick="X13.search.setFilter('all')">Tümü</span>
      <span class="x13-chip" data-f="live" onclick="X13.search.setFilter('live')">Kanallar</span>
      <span class="x13-chip" data-f="vod" onclick="X13.search.setFilter('vod')">Filmler</span>
      <span class="x13-chip" data-f="series" onclick="X13.search.setFilter('series')">Diziler</span>
      <span class="x13-chip" data-f="epg" onclick="X13.search.setFilter('epg')">Programlar</span>
    </div>
    <div class="x13-hint" id="x13SearchScope"></div>
    <div id="x13SearchOut"></div>
  </div>
</div>


<div id="x13BmModal" class="x13-modal">
  <div class="x13-hdr">
    <button class="x13-back" onclick="X13.closeModal('x13BmModal')" aria-label="Geri"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg></button>
    <div class="x13-ttl">YER İMLERİ / KLİPLER</div>
  </div>
  <div class="x13-body">
    <div class="x13-card">
      <h4>Buradan devam et</h4>
      <div class="x13-hint">Player'da yer imi butonuna basınca o an kaydedilir. Film/dizi kaydına tıklayınca tam o saniyeden, canlı yayın kaydına tıklayınca o kanaldan açılır.</div>
      <div id="x13BmList"></div>
    </div>
    <div class="x13-card">
      <h4>Intro işaretleri</h4>
      <div class="x13-hint">Dizilerde intro başlangıç/bitişini işaretlediğin bölümler burada sayılır. Aynı dizinin diğer bölümlerinde de otomatik "Girişi geç" çıkar.</div>
      <div id="x13IntroInfo" class="x13-hint"></div>
      <button class="x13-btn dng" onclick="X13.intro.clearAll()">Tüm intro işaretlerini sil</button>
    </div>
  </div>
</div>


<div id="x13SkipBtn" class="x13-skip" onclick="X13.intro.skip()" tabindex="0" role="button" onkeydown="if(event.key==='Enter'||event.key===' '||event.key==='Select'||event.keyCode===13||event.keyCode===23||event.keyCode===66){event.preventDefault();event.stopPropagation();X13.intro.skip();}">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm2-8.14L11.03 12 8 14.14V9.86zM16 6h2v12h-2z"/></svg>
  <span id="x13SkipLbl">Girişi geç</span>
</div>

<div id="x13BmPanel" class="x13-bmpanel">
  <div style="font-weight:800;margin-bottom:6px;color:var(--acc2)" id="x13BmPanelTitle">Yer imi</div>
  <div class="x13-hint" id="x13BmPanelHint"></div>
  <div id="x13BmPanelBody"></div>
  <div style="margin-top:8px;text-align:right"><button class="x13-btn" onclick="X13.bm.closePanel()">Kapat</button></div>
</div>

<div id="x13NextPre" class="x13-nextep-pre">
  <span class="cd" id="x13NextPreCd">20</span>
  <div class="th" id="x13NextPreTh"></div>
  <div class="in">
    <div><b>SIRADAKİ BÖLÜM</b><div class="t" id="x13NextPreT"></div></div>
    <div class="rr">
      <button class="x13-btn pri" onclick="X13.pre.go()">Şimdi Oynat</button>
      <button class="x13-btn" onclick="X13.pre.dismiss()">Gizle</button>
    </div>
  </div>
</div>


<div id="x13Radio" class="x13-radio">
  <div class="art pulse" id="x13RadioArt"><svg width="72" height="72" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55A4 4 0 1014 17V7h4V3h-6z"/></svg></div>
  <div class="nm" id="x13RadioNm">—</div>
  <div class="pr" id="x13RadioPr"></div>
  <div class="bar" id="x13RadioBarW" style="display:none"><i id="x13RadioBar"></i></div>
  <div class="tm" id="x13RadioTm"></div>
  <div class="row">
    <button class="rb" id="x13RadioPrev" onclick="X13.radio.prev()" aria-label="Önceki"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
    <button class="rb big" id="x13RadioPP" onclick="X13.radio.toggle()" aria-label="Oynat/Duraklat"><svg id="x13RadioPPi" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg></button>
    <button class="rb" id="x13RadioNext" onclick="X13.radio.next()" aria-label="Sonraki"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
  </div>
  <button class="x13-btn exit" onclick="X13.radio.stop()">Görüntüye dön</button>
</div>

<script>_u("")</script>


<style id="tvx-style">html{--tvx-safe-h:0%;--tvx-safe-v:0%}html.tvx-safe #app,html.tvx-safe #setup{inset:var(--tvx-safe-v) var(--tvx-safe-h);height:auto} html.tvx-safe body{background:#000} html.tv-device.tvx-safe-auto:not(.tvx-safe):not(.vod-skin):not(.fs-fallback) #app{inset:0;height:auto}html.tv-device.tvx-safe-auto:not(.tvx-safe):not(.vod-skin):not(.fs-fallback) body{background:#000}html.umit-tvish.tvx-safe-auto:not(.tvx-safe):not(.vod-skin):not(.fs-fallback) #app{inset:0;height:auto}html.umit-tvish.tvx-safe-auto:not(.tvx-safe):not(.vod-skin):not(.fs-fallback) body{background:#000}html.tv-device.tvx-fs-lg{font-size:112.5%}html.tv-device.tvx-fs-xl{font-size:125%}html.tv-device.tvx-fs-lg .ov-btn,html.tv-device.tvx-fs-xl .ov-btn{font-size:1rem}  @keyframes vcFocusPop{0%{transform:scale(1)}55%{transform:scale(1.09)}100%{transform:scale(1.06)}}#vodview .vcard:focus,#vodview .vcard:focus-visible{transform:scale(1.06);z-index:5;will-change:transform;outline:3px solid var(--acc)!important;outline-offset:-3px;box-shadow:none!important;transition:none!important;animation:vcFocusPop .18s ease-out both}#vodview .vcard:focus .vcard-title,#vodview .vcard:focus-visible .vcard-title{color:var(--acc)}#vodview .vcard:focus .vcard-poster,#vodview .vcard:focus-visible .vcard-poster{border-color:var(--acc)}html.tv-device.tvx-focusfx .chi:focus,html.tv-device.tvx-focusfx .chi:focus-visible,html.tv-device.tvx-focusfx .chi.kbd-hi,html.tv-device.tvx-focusfx .vcard:focus,html.tv-device.tvx-focusfx .vcard:focus-visible{transform:scale(1.04);outline:3px solid var(--acc);outline-offset:-3px;box-shadow:inset 0 0 0 2px var(--acc),inset 0 0 26px color-mix(in srgb,var(--acc) 45%,transparent);transition:transform .14s ease,box-shadow .14s ease}@media (prefers-reduced-motion:reduce){html.tv-device.tvx-focusfx .chi:focus,html.tv-device.tvx-focusfx .vcard:focus{transition:none;transform:none}} #tvxNum{position:fixed;top:5%;right:5%;z-index:620;display:none;min-width:120px;padding:10px 22px;border-radius:14px;background:rgba(0,0,0,.72);border:2px solid var(--acc3);color:var(--acc3);font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(2.6rem,7vw,5rem);letter-spacing:4px;text-align:center;line-height:1.1;box-shadow:0 8px 30px rgba(0,0,0,.6)}#tvxNum.show{display:block}#tvxNum small{display:block;font-size:clamp(.8rem,1.8vw,1.2rem);font-weight:700;letter-spacing:.5px;color:var(--text);max-width:42vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px}#tvxNum small.miss{color:var(--red)} #tvxBar{position:fixed;left:5%;right:5%;bottom:6%;z-index:610;display:none;align-items:center;gap:16px;padding:14px 20px;border-radius:16px;background:linear-gradient(180deg,rgba(0,0,0,.62),rgba(0,0,0,.88));border:1px solid var(--bord2);color:var(--text);font-family:'Outfit',sans-serif;box-shadow:0 10px 36px rgba(0,0,0,.6)}#tvxBar.show{display:flex;animation:tvxUp .18s ease}@keyframes tvxUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}#tvxBar .tn{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:900;color:var(--acc3);min-width:2.4ch;text-align:center}#tvxBar img{height:clamp(34px,6vw,56px);max-width:90px;object-fit:contain;border-radius:6px}#tvxBar .tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}#tvxBar .nm{font-size:clamp(1.05rem,2.4vw,1.6rem);font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#tvxBar .pr{font-size:clamp(.85rem,1.8vw,1.15rem);color:var(--acc2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#tvxBar .nx{font-size:clamp(.75rem,1.5vw,1rem);color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#tvxBar .pb{height:5px;border-radius:3px;background:rgba(255,255,255,.16);overflow:hidden;margin-top:4px}#tvxBar .pb i{display:block;height:100%;background:var(--acc);width:0} #tvxVol{position:fixed;top:50%;right:4%;z-index:615;display:none;transform:translateY(-50%);flex-direction:column;align-items:center;gap:8px;padding:14px 12px;border-radius:14px;background:rgba(0,0,0,.74);border:1px solid var(--bord2);color:var(--text);font-family:'Outfit',sans-serif}#tvxVol.show{display:flex}#tvxVol .tr{width:12px;height:clamp(120px,26vh,220px);border-radius:6px;background:rgba(255,255,255,.18);position:relative;overflow:hidden}#tvxVol .tr i{position:absolute;left:0;right:0;bottom:0;background:var(--acc);border-radius:6px}#tvxVol b{font-size:1rem} #tvxSeek{position:fixed;left:50%;top:40%;transform:translateX(-50%);z-index:615;display:none;overflow:hidden;width:clamp(300px,40vw,480px);padding:14px 18px 14px;border-radius:24px;box-sizing:border-box;background:var(--card-bg,var(--bg2));border:1.5px solid var(--acc);box-shadow:var(--sh),var(--glow);color:var(--text);font-family:'Outfit',sans-serif}#tvxSeek::before{content:'';position:absolute;inset:0;pointer-events:none;border-radius:inherit;background:linear-gradient(135deg,var(--acc) 0%,transparent 55%);opacity:.16}#tvxSeek>*{position:relative}#tvxSeek.show{display:block}#tvxSeek .sk-top{display:flex;align-items:center;gap:14px}#tvxSeek .sk-ic{flex:none;width:clamp(46px,5vw,62px);height:clamp(46px,5vw,62px);border-radius:50%;background:linear-gradient(135deg,var(--acc),var(--acc2));color:var(--on-acc,#000);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 4px rgba(255,255,255,.06),var(--glow)}#tvxSeek .sk-ic svg{width:56%;height:56%;fill:currentColor;display:block}#tvxSeek[data-dir="-1"] .sk-fw,#tvxSeek[data-dir="1"] .sk-bw{display:none}#tvxSeek .sk-main{display:flex;flex-direction:column;gap:5px;min-width:0;flex:1;line-height:1}#tvxSeek .sk-lbl{font-size:clamp(.66rem,1.2vw,.8rem);font-weight:800;letter-spacing:.14em;color:var(--acc3)}#tvxSeek .sk-cur{font-weight:900;font-size:clamp(1.9rem,4.4vw,3rem);letter-spacing:.5px;color:var(--text);font-variant-numeric:tabular-nums}#tvxSeek .sk-side{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:6px}#tvxSeek .sk-d{padding:5px 13px;border-radius:999px;background:var(--acc);color:var(--on-acc,#000);font-weight:900;font-size:clamp(.85rem,1.7vw,1.1rem);white-space:nowrap}#tvxSeek .sk-rate{padding:2px 9px;border-radius:999px;border:1px solid var(--acc2);color:var(--acc2);font-weight:800;font-size:clamp(.66rem,1.2vw,.8rem);letter-spacing:.06em}#tvxSeek .sk-rate:empty{display:none}#tvxSeek .sk-track{position:relative;margin:14px 0 12px;height:8px;border-radius:5px;background:rgba(255,255,255,.14)}#tvxSeek .sk-base,#tvxSeek .sk-seg{position:absolute;top:0;bottom:0;border-radius:5px;display:block}#tvxSeek .sk-base{left:0;width:0;background:var(--text2);opacity:.65}#tvxSeek .sk-seg{left:0;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2))}#tvxSeek .sk-thumb{position:absolute;top:50%;left:0;width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:50%;background:var(--acc3);border:3px solid var(--bg1,#000);box-shadow:var(--glow);text-decoration:none}#tvxSeek .sk-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}#tvxSeek .sk-stats>div{display:flex;flex-direction:column;gap:3px;padding:6px 8px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid var(--bord);min-width:0}#tvxSeek .sk-stats small{font-size:clamp(.56rem,1vw,.68rem);font-weight:800;letter-spacing:.1em;color:var(--text2)}#tvxSeek .sk-stats span{font-size:clamp(.78rem,1.5vw,1rem);font-weight:800;color:var(--text);font-variant-numeric:tabular-nums;white-space:nowrap} #tvxNet{position:fixed;top:0;left:0;right:0;z-index:640;display:none;text-align:center;padding:8px 12px;font:700 .9rem 'Outfit',sans-serif;color:#fff;background:#b45309}#tvxNet.show{display:block}#tvxNet.ok{background:#047857} #tvxQM{position:fixed;inset:0;z-index:650;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.66)}#tvxQM.show{display:flex}#tvxQM .box{width:min(560px,92vw);max-height:88vh;overflow:auto;background:var(--bg1);border:2px solid var(--bord2);border-radius:18px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.7);font-family:'Outfit',sans-serif}#tvxQM h3{margin:0 0 4px;font-size:1.15rem;color:var(--acc3);font-weight:900}#tvxQM .sub{font-size:.75rem;color:var(--text2);margin-bottom:10px}#tvxQM .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}#tvxQM button{display:flex;align-items:center;gap:10px;min-height:54px;padding:10px 14px;border-radius:12px;border:1px solid var(--bord2);background:var(--bg3);color:var(--text);cursor:pointer;font:700 .95rem 'Outfit',sans-serif;text-align:left}#tvxQM button .k{flex-shrink:0;width:14px;height:14px;border-radius:50%;background:var(--bord2)}#tvxQM button .k.r{background:#ef4444}#tvxQM button .k.g{background:#22c55e}#tvxQM button .k.y{background:#eab308}#tvxQM button .k.b{background:#3b82f6}#tvxQM button:focus,#tvxQM button:focus-visible,#tvxQM button:hover{outline:3px solid var(--acc);outline-offset:1px;background:var(--acc);color:#000}#tvxQM .ft{margin-top:10px;font-size:.72rem;color:var(--text2);text-align:center} #tvxDiag{position:fixed;left:2%;right:2%;bottom:2%;z-index:660;display:none;background:rgba(0,0,0,.88);border:2px solid var(--acc3);border-radius:14px;padding:12px 14px;color:var(--text);font-family:'Outfit',sans-serif;max-height:62vh;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.7)}#tvxDiag.show{display:block}#tvxDiag .hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}#tvxDiag .hd b{color:var(--acc3);font-size:1rem}#tvxDiag .hd span{font-size:.72rem;color:var(--text2)}#tvxDiag .big{font:900 clamp(1.4rem,4vw,2.6rem) monospace;color:var(--acc3);text-align:center;padding:8px;border-radius:10px;background:var(--bg2);border:1px solid var(--bord2);min-height:1.3em;word-break:break-all}#tvxDiag .row{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin:8px 0;font:.85rem monospace;color:var(--text2)}#tvxDiag .row b{color:var(--text)}#tvxDiag .log{font:.78rem/1.5 monospace;color:var(--text2);max-height:16vh;overflow:hidden;border-top:1px solid var(--bord);padding-top:6px;white-space:pre}#tvxDiag button{min-height:44px;padding:8px 18px;border-radius:10px;border:1px solid var(--bord2);background:var(--bg3);color:var(--text);font:800 .9rem 'Outfit',sans-serif;cursor:pointer}#tvxDiag button:focus,#tvxDiag button:focus-visible,#tvxDiag button:hover{outline:3px solid var(--acc);background:var(--acc);color:#000} html.tvx-paused *,html.tvx-paused *::before,html.tvx-paused *::after{animation-play-state:paused !important} #as-collapse-wrap-tvx.open .as-collapse-body{max-height:none !important}.tvx-hint{font-size:.74rem;color:var(--text2);line-height:1.5;margin:6px 0 10px}</style>

