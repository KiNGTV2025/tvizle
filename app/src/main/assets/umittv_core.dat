<style id="umit-clock-tint">html[data-clock="off"] #sb{display:none!important} html[data-clock="withctrl"] #sb{position:fixed;left:0;right:0;bottom:0;z-index:60;box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom,0px);height:auto;min-height:26px;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(100%);transition:opacity .25s,transform .25s,visibility 0s linear .25s}html[data-clock="withctrl"] #ov .ov-bot{margin-bottom:calc(28px + env(safe-area-inset-bottom,0px))!important} html[data-clock="withctrl"].ctrl-on #sb{opacity:1;visibility:visible;pointer-events:auto;transform:none;transition:opacity .25s,transform .25s,visibility 0s} #ov .ov-bot{background:linear-gradient(180deg,color-mix(in srgb,var(--acc) 18%,transparent),color-mix(in srgb,var(--acc) 6%,transparent)),color-mix(in srgb,var(--bg2) 62%,transparent)!important;border-color:color-mix(in srgb,var(--acc) 30%,transparent)!important}#sb{background:linear-gradient(180deg,color-mix(in srgb,var(--acc) 12%,transparent),color-mix(in srgb,var(--acc) 4%,transparent)),color-mix(in srgb,var(--bg2) 80%,transparent);border-top-color:color-mix(in srgb,var(--acc) 35%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)} :root[data-theme="light"] #ov .ov-bot{background:linear-gradient(180deg,color-mix(in srgb,var(--acc) 22%,transparent),color-mix(in srgb,var(--acc) 8%,transparent)),rgba(14,10,6,.58)!important} html[data-topmenu] #app:fullscreen #topbar,html.fs-fallback[data-topmenu] #topbar{display:flex!important;position:fixed;top:0;left:0;right:0;z-index:70;box-sizing:border-box;padding-top:calc(6px + env(safe-area-inset-top,0px));background:color-mix(in srgb,var(--bg1) 78%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}html[data-topmenu] #app:-webkit-full-screen #topbar{display:flex!important;position:fixed;top:0;left:0;right:0;z-index:70;box-sizing:border-box;padding-top:calc(6px + env(safe-area-inset-top,0px));background:color-mix(in srgb,var(