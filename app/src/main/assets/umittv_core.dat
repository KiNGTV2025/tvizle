<style id="umit-xttop-css">#xtTopPop{position:fixed;left:0;top:0;z-index:99995;display:none;width:min(340px,92vw);max-height:80vh;overflow:auto;padding:12px 14px;border-radius:14px;background:rgba(15,15,20,.97);color:#fff;border:2px solid var(--acc3,#f97316);font-size:.78rem;line-height:1.45;box-shadow:0 10px 30px rgba(0,0,0,.5)}#xtTopPop p{margin:6px 0 0}#xtTopPop ul{margin:6px 0 0;padding-left:17px}#xtTopPop li{margin:3px 0}#xtTopPop .ex{font-family:'JetBrains Mono',monospace;font-size:.66rem;word-break:break-all;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.08)}#xtTopPop u{text-decoration:none;color:var(--acc3,#f59e0b);font-weight:700}#xtTopPop .acc{margin-top:8px;padding:8px 10px;border-radius:10px;background:rgba(255,255,255,.07);display:flex;flex-direction:column;gap:3px}#xtTopPop .acc div{display:flex;justify-content:space-between;gap:10px}#xtTopPop .ok{color:#22c55e;font-weight:700}#xtTopPop .warn{color:#f59e0b;font-weight:700}#xtTopPop .err{color:#ef4444;font-weight:700}html.tv-device #xtTopPop{font-size:1rem;width:min(520px,70vw)}#xtTopInfoBtn[aria-expanded="true"]{background:var(--acc3,#f59e0b);color:#1a0a0a}</style>
