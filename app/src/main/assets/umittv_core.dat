<style id="umit-xtinfo-touchtip-css">.xt-lbl-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.xt-info-btn{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:var(--bg3);color:var(--acc3,#f59e0b);border:1px solid var(--bord);cursor:pointer;padding:0}.xt-info-btn:hover,.xt-info-btn:focus-visible,.xt-info-btn[aria-expanded="true"]{background:var(--acc);color:var(--on-acc,#111);outline:none}html.tv-device .xt-info-btn{width:44px;height:44px}html.tv-device .xt-info-btn:focus-visible{outline:3px solid #fff;outline-offset:2px}.xt-info-pop{margin:0 0 8px;padding:11px 13px;border-radius:12px;background:var(--bg3);border:1px solid var(--acc3,#f59e0b);font-size:.74rem;line-height:1.45;color:var(--text,#fff)}.xt-info-pop p{margin:6px 0 0}.xt-info-pop ul{margin:6px 0 0;padding-left:17px}.xt-info-pop li{margin:3px 0}.xt-info-pop .xt-ex{font-family:'JetBrains Mono',monospace;font-size:.66rem;word-break:break-all;opacity:.9;padding:6px 8px;border-radius:8px;background:rgba(0,0,0,.25)}.xt-info-pop u{text-decoration:none;color:var(--acc3,#f59e0b);font-weight:700}.xt-info-pop .xt-warn{color:#f59e0b;font-weight:700}</style>
