<style id="umit-vk-css">#umitVk{position:fixed;left:0;right:0;bottom:2.5vh;width:min(760px,68vw);margin:0 auto;z-index:2147483000;display:none;box-sizing:border-box;padding:10px 10px 12px;background:linear-gradient(180deg,var(--bg3,#171b28) 0%,var(--bg2,#11141e) 100%);border:1px solid var(--bord2,rgba(255,255,255,.12));border-radius:22px;color:var(--text,#fff);font-family:'Outfit',system-ui,sans-serif;box-shadow:0 24px 70px rgba(0,0,0,.65),0 -1px 0 var(--acc,#f97316);contain:layout style}#umitVk.show{display:block}#umitVk .vk-prev{position:relative;display:flex;align-items:center;gap:8px;box-sizing:border-box;margin:0 0 9px;padding:7px 14px;min-height:40px;border-radius:14px;background:var(--bg0,#0b0d14);border:1px solid var(--acc,#f97316);box-shadow:inset 0 2px 8px rgba(0,0,0,.45);font-weight:600;font-size:1rem;line-height:1.4;white-space:nowrap;overflow:hidden;color:var(--text,#fff)}#umitVk .vk-txt{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}#umitVk .vk-txt .ph{opacity:.4;font-weight:500}#umitVk .vk-c{display:inline-block;width:2px;height:1.15em;margin:0 1px -.2em;background:var(--acc3,#fbbf24);border-radius:2px;animation:vkblink 1s steps(1) infinite}@keyframes vkblink{50%{opacity:0}}html.tv-device #umitVk .vk-c{animation:none}#umitVk .vk-msg{flex:none;opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s;font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:999px;background:rgba(34,197,94,.2);color:#86efac}#umitVk .vk-msg.show{opacity:1;transform:none}#umitVk .vk-msg.bad{background:rgba(239,68,68,.22);color:#fca5a5}#umitVk .vk-row{display:flex;gap:5px;justify-content:center;margin:0 0 5px}#umitVk .vk-row:last-child{margin-bottom:0}#umitVk .vk-k{flex:1 1 0;min-width:0;height:clamp(28px,4.8vh,40px);display:flex;align-items:center;justify-content:center;gap:6px;box-sizing:border-box;padding:0 2px;overflow:hidden;white-space:nowrap;border:1px solid rgba(255,255,255,.07);border-radius:11px;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035)),var(--bg4,#1f2536);color:var(--text,#e8ebf4);font-weight:650;font-size:.9rem;cursor:pointer;user-select:none;-webkit-user-select:none;box-shadow:0 2px 0 rgba(0,0,0,.38);touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:transform .08s ease,background .12s ease}#umitVk .vk-k.w2{flex:2 1 0}#umitVk .vk-k.w3{flex:3 1 0}#umitVk .vk-k.w5{flex:5 1 0}#umitVk .vk-k.act{background:linear-gradient(180deg,rgba(255,255,255,.13),rgba(255,255,255,.06)),var(--bg3,#2c3349);border-color:var(--bord2,rgba(255,255,255,.18));font-size:.84rem}#umitVk .vk-k.done{background:linear-gradient(135deg,var(--acc,#f97316),var(--acc2,var(--acc,#f97316)));border-color:transparent;color:var(--on-acc,#fff);font-weight:800;font-size:.95rem}#umitVk .vk-k.tg{background:var(--acc2,var(--acc,#f97316));color:var(--on-acc,#fff)}#umitVk .vk-k.caps{box-shadow:inset 0 -3px 0 var(--acc3,#fbbf24),0 2px 0 rgba(0,0,0,.38)}#umitVk .vk-k.chip{height:clamp(30px,5vh,42px);border-radius:999px;background:rgba(255,255,255,.07);box-shadow:none;font-size:.82rem;padding:0 10px}#umitVk .vk-k.chip svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;flex:none;pointer-events:none}#umitVk .vk-k.chip b{font-weight:700;pointer-events:none}#umitVk .vk-k.chip.pri{background:linear-gradient(135deg,var(--acc,#f97316),var(--acc2,var(--acc,#f97316)));color:var(--on-acc,#fff);border-color:transparent}#umitVk .vk-k.quick{height:clamp(26px,4.2vh,34px);border-radius:9px;font-size:.78rem;color:var(--acc3,#fbbf24);background:rgba(255,255,255,.05);box-shadow:none}#umitVk .vk-k.on{background:var(--acc,#f97316);border-color:var(--acc3,#fbbf24);color:var(--on-acc,#fff);outline:2px solid var(--acc3,#fbbf24);outline-offset:1px;z-index:2}#umitVk .vk-k:active{transform:scale(.93)}#umitVk .vk-pin{position:absolute;left:0;top:0;width:100%;height:100%;margin:0;padding:0;border:0;background:transparent;color:transparent;caret-color:transparent;opacity:0;font-size:16px;z-index:3;-webkit-tap-highlight-color:transparent}#umitVkPop{position:fixed;z-index:2147483647;display:none;align-items:center;justify-content:center;box-sizing:border-box;pointer-events:none;border-radius:16px;background:linear-gradient(180deg,var(--acc3,#fbbf24),var(--acc,#f97316));color:var(--on-acc,#1a1200);font:800 1.9rem/1 'Outfit',system-ui,sans-serif;box-shadow:0 12px 30px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.18) inset;contain:layout paint;will-change:transform}@media (max-width:820px){html:not(.tv-device) #umitVk{left:0;right:0;bottom:0;width:100%;max-width:none;margin:0;padding:8px 6px calc(10px + env(safe-area-inset-bottom,0px));border-radius:24px 24px 0 0;border-left:none;border-right:none;border-bottom:none;box-shadow:0 -18px 50px rgba(0,0,0,.6),0 -1px 0 var(--acc,#f97316);max-height:78vh;overflow:hidden}html:not(.tv-device) #umitVk::before{content:'';display:block;width:38px;height:4px;border-radius:4px;background:rgba(255,255,255,.22);margin:0 auto 8px}html:not(.tv-device) #umitVk .vk-prev{min-height:44px;padding:8px 14px;margin:0 4px 9px;font-size:1.05rem}html:not(.tv-device) #umitVk .vk-row{gap:4px;margin:0 0 5px;padding:0 2px}html:not(.tv-device) #umitVk .vk-k{height:clamp(38px,5.6vh,48px);border-radius:10px;font-size:1.05rem;font-weight:700}html:not(.tv-device) #umitVk .vk-k.chip{height:clamp(36px,5.2vh,44px);font-size:.84rem}html:not(.tv-device) #umitVk .vk-k.quick{height:clamp(30px,4.4vh,36px);font-size:.8rem}html:not(.tv-device) #umitVk .vk-k:active{background:var(--acc,#f97316);color:var(--on-acc,#fff)}html:not(.tv-device) #umitVk .vk-k.act{font-size:.84rem}html:not(.tv-device) #umitVk .vk-k.w5{flex:4 1 0}html:not(.tv-device) #umitVk .vk-k.on{outline-width:2px;outline-offset:0}}@media (max-width:920px) and (max-height:480px){html:not(.tv-device) #umitVk{padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));max-height:none}html:not(.tv-device) #umitVk::before{display:none}html