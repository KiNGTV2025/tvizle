<style id="umit-landscape-fix">@media (orientation:landscape) and (max-height:600px){#topbar{flex-wrap:nowrap!important;height:42px!important;min-height:42px!important;padding:3px 8px!important;row-gap:0!important;gap:6px!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:none;-webkit-overflow-scrolling:touch}#topbar::-webkit-scrollbar{display:none}#topbar>*{flex-shrink:0!important}#mmtabs{order:0!important;flex-basis:auto!important;width:auto!important;overflow:visible!important}#whatBtn{order:0!important}.tb-btns{overflow:visible!important;max-width:none!important}.tbbtn{padding:5px 9px!important;border-radius:9px!important}.mmtab{padding:5px 9px!important}#tb-orient-lbl,#tb-fit-lbl{display:none}.tb-logo{font-size:.95rem!important}} @media (orientation:landscape) and (max-height:600px){#ch-transition{justify-content:stretch!important;align-items:flex-end!important;padding:0!important}#ch-transition .ct-card{width:100%!important;min-width:0!important;max-width:none!important;max-height:none!important;overflow:visible!important;box-sizing:border-box;display:grid!important;grid-template-columns:minmax(0,5fr) minmax(0,6fr);column-gap:18px;row-gap:5px;align-items:center;padding:8px calc(14px + env(safe-area-inset-right,0px)) calc(8px + env(safe-area-inset-bottom,0px)) calc(14px + env(safe-area-inset-left,0px))!important;border-radius:0!important;border:0!important;border-top:1px solid rgba(249,115,22,.35)!important;animation:none}#ch-transition .ct-top{grid-column:1;grid-row:1 / span 3;gap:10px!important;align-self:center}#ch-transition .ct-tech{grid-column:2;grid-row:1;padding:3px 10px!important}#ch-transition .ct-epg{grid-column:2;grid-row:2;gap:3px!important}#ch-transition .ct-next{grid-column:2;grid-row:3;padding-top:5px!important}#ch-transition .ct-logo-inner{width:44px!important;height:44px!important}#ch-transition .ct-logo-ring{inset:-2px!important;border-radius:12px!important}#ch-transition .ct-ch-name{font-size:1rem!important}#ch-transition .ct-ch-time{font-size:.72rem!important}#ch-transition .ct-now-badge,#ch-transition .ct-num-badge{font-size:.55rem!important;padding:1px 7px!important}#ch-transition .ct-epg-title{font-size:.82rem!important}#ch-transition .ct-epg-desc{display:block!important;font-size:.68rem!important}#ch-transition .ct-next-title,#ch-transition .ct-next-time{font-size:.72rem!important} #ch-transition .ct-tech:not([style*="display:none"]):not([style*="display: none"]){display:flex!important}#ch-transition .ct-next:not([style*="display:none"]):not([style*="display: none"]){display:flex!important}}</style>
<style id="umit-tv-banner-xl">html.tv-device #ch-transition{justify-content:stretch!important;align-items:flex-end!important;padding:0!important}html.tv-device #ch-transition .ct-card{width:100%!important;max-width:none!important;min-width:0!important;max-height:34vh!important;overflow:hidden!important;box-sizing:border-box;display:grid!important;grid-template-columns:minmax(0,3fr) minmax(0,7fr)!important;column-gap:clamp(14px,2vw,36px)!important;row-gap:clamp(3px,.6vh,8px)!important;align-items:center!important;padding:clamp(8px,1.5vh,18px) clamp(18px,3vw,56px) clamp(10px,1.8vh,22px)!important;border-radius:0!important;border:0!important;border-top:2px solid rgba(249,115,22,.55)!important;background:linear-gradient(180deg,rgba(10,6,3,.82),rgba(8,5,3,.96))!important;animation:none}html.tv-device #ch-transition .ct-top{grid-column:1!important;grid-row:1 / span 3!important;gap:clamp(10px,1.2vw,20px)!important;align-self:center}html.tv-device #ch-transition .ct-logo-inner{width:clamp(52px,6vw,100px)!important;height:clamp(52px,6vw,100px)!important}html.tv-device #ch-transition .ct-logo-ring{inset:-3px!important;border-radius:16px!important}html.tv-device #ch-transition .ct-ch-name{font-size:clamp(1.1rem,2vw,2rem)!important;line-height:1.1;white-space:normal!important}html.tv-device #ch-transition .ct-ch-time{font-size:clamp(.85rem,1.3vw,1.3rem)!important}html.tv-device #ch-transition .ct-now-badge,html.tv-device #ch-transition .ct-num-badge{font-size:clamp(.7rem,1vw,1rem)!important;padding:2px 10px!important}html.tv-device #ch-transition .ct-tech:not([style*="display:none"]):not([style*="display: none"]){display:flex!important;grid-column:2!important;grid-row:1!important;padding:2px 0!important;gap:clamp(6px,.8vw,12px)!important}html.tv-device #ch-transition .ct-res-badge{font-size:clamp(.7rem,1vw,1rem)!important;padding:2px 10px!important}html.tv-device #ch-transition .ct-tech-pill{font-size:clamp(.8rem,1.15vw,1.15rem)!important}html.tv-device #ch-transition .ct-epg{display:flex!important;grid-column:2!important;grid-row:2!important;gap:clamp(3px,.6vh,8px)!important}html.tv-device #ch-transition .ct-epg-title{font-size:clamp(1.1rem,1.95vw,1.95rem)!important;font-weight:800;line-height:1.15;white-space:normal!important;text-overflow:clip!important;overflow:hidden!important;display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2}html.tv-device #ch-transition .ct-epg-desc{font-size:clamp(.9rem,1.3vw,1.3rem)!important;line-height:1.3;color:#f1e6da!important;white-space:normal!important;text-overflow:clip!important;overflow:hidden!important;display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:3;line-clamp:3}html.tv-device #ch-transition .ct-prog{height:clamp(5px,.7vh,8px)!important;margin-top:3px}html.tv-device #ch-transition .ct-next:not([style*="display:none"]):not([style*="display: none"]){display:flex!important;grid-column:2!important;grid-row:3!important;align-items:baseline;gap:clamp(8px,1vw,18px);padding-top:clamp(2px,.5vh,6px)!important}html.tv-device #ch-transition .ct-next-lbl{font-size:clamp(.65rem,.95vw,.95rem)!important;padding:2px 10px!important}html.tv-device #ch-transition .ct-next-title{font-size:clamp(.95rem,1.4vw,1.4rem)!important;white-space:normal!important;overflow:hidden!important;text-overflow:clip!important;font-weight:700;display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:1;line-clamp:1}html.tv-device #ch-transition .ct-next-time{font-size:clamp(.9rem,1.3vw,1.3rem)!important} html.tv-device #ch-transition .ct-card{grid-template-columns:minmax(190px,4fr) minmax(0,6fr)!important}html.tv-device #ch-transition .ct-top{flex-wrap:wrap!important;align-content:center;row-gap:4px!important;min-width:0}html.tv-device #ch-transition .ct-logo-inner{width:clamp(44px,4.6vw,84px)!important;height:clamp(44px,4.6vw,84px)!important}html.tv-device #ch-transition .ct-info{flex:1 1 110px!important;min-width:110px!important;overflow:visible!important}html.tv-device #ch-transition .ct-badge-row{flex-wrap:wrap;gap:4px 6px!important}html.tv-device #ch-transition .ct-now-badge,html.tv-device #ch-transition .ct-num-badge{font-size:clamp(.6rem,.8vw,.85rem)!important;padding:2px 8px!important;letter-spacing:1px!important;white-space:nowrap;flex-shrink:0}html.tv-device #ch-transition .ct-ch-name{font-size:clamp(1rem,1.7vw,1.7rem)!important;white-space:normal!important;overflow:hidden!important;word-break:normal!important;overflow-wrap:break-word;min-width:0;display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2}html.tv-device #ch-transition .ct-ch-time{flex:0 0 100%!important;margin-left:0!important;align-self:auto!important;padding-top:0!important;font-size:clamp(.8rem,1.1vw,1.15rem)!important} html #app:fullscreen #ch-transition .ct-top .ct-badge-row .ct-num-badge{order:-1;font-size:clamp(2.2rem,4.8vw,5rem)!important;font-weight:900!important;line-height:1!important;letter-spacing:0!important;padding:0 6px 0 0!important;border:0!important;background:none!important;color:var(--neon2,#fbbf24)!important;text-shadow:0 0 14px rgba(251,191,36,.55)!important}html #app:-webkit-full-screen #ch-transition .ct-top .ct-badge-row .ct-num-badge{order:-1;font-size:clamp(2.2rem,4.8vw,5rem)!important;font-weight:900!important;line-height:1!important;letter-spacing:0!important;padding:0 6px 0 0!important;border:0!important;background:none!important;color:var(--neon2,#fbbf24)!important;text-shadow:0 0 14px rgba(251,191,36,.55)!important}html.fs-fallback #ch-transition .ct-top .ct-badge-row .ct-num-badge{order:-1;font-size:clamp(2.2rem,4.8vw,5rem)!important;font-weight:900!important;line-height:1!important;letter-spacing:0!important;padding:0 6px 0 0!important;border:0!important;background:none!important;color:var(--neon2,#fbbf24)!important;text-shadow:0 0 14px rgba(251,191,36,.55)!important}html #app:fullscreen #ch-transition .ct-top .ct-badge-row{align-items:center!important}html.fs-fallback #ch-transition .ct-top .ct-badge-row{align-items:center!important} html.tv-device #ch-transition .ct-card{grid-template-columns:auto minmax(0,1fr)!important;column-gap:clamp(12px,1.6vw,28px)!important}html.tv-device #ch-transition .ct-top{display:grid!important;grid-template-columns:auto minmax(0,auto);column-gap:clamp(8px,1vw,16px)!important;row-gap:2px!important;align-items:center;justify-self:start;max-width:clamp(220px,34vw,520px)}html.tv-device #ch-transition .ct-logo-wrap{grid-column:1;grid-row:1 / span 2;align-self:center}html.tv-device #ch-transition .ct-info{grid-column:2;grid-row:1;flex:none!important;min-width:0!important;max-width:clamp(120px,22vw,340px)}html.tv-device #ch-transition .ct-ch-time{grid-column:2;grid-row:2;flex:none!important;justify-self:start}</style>
<style id="umit-modern-player">#ov .ov-bot{gap:10px;padding:12px 14px 14px;border-radius:26px;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.015)),rgba(14,10,6,.5);backdrop-filter:blur(26px) saturate(1.8);-webkit-backdrop-filter:blur(26px) saturate(1.8);border:1px solid rgba(255,255,255,.1);box-shadow:0 18px 50px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.14)} #ov .prog-bar{height:8px;background:rgba(255,255,255,.1);box-shadow:inset 0 1px 2px rgba(0,0,0,.5);overflow:visible}#ov .prog-bar.seekable{height:8px}#ov .prog-bar.seekable:hover,#ov .prog-bar.seekable:active,#ov .prog-bar.seekable.dragging{height:12px}#ov .prog-buf{background:repeating-linear-gradient(115deg,rgba(255,255,255,.2) 0 6px,rgba(255,255,255,.1) 6px 12px);background-size:24px 100%;animation:umBuf 1.2s linear infinite}#ov .prog-fill{background: linear-gradient(100deg,transparent 30%,rgba(255,255,255,.7) 50%,transparent 70%) -90px 0/90px 100% no-repeat,linear-gradient(90deg,var(--acc),var(--acc2),#fff3,var(--acc2),var(--acc)) 0 0/220% 100%;animation:umSweep 2.6s ease-in-out infinite,umFlow 5s linear infinite;box-shadow:0 0 14px color-mix(in srgb,var(--acc) 70%,transparent),0 0 30px color-mix(in srgb,var(--acc) 35%,transparent)}#ov .prog-bar .prog-fill-knob{width:18px;height:18px;right:-9px;transform:translateY(-50%) scale(1);background:radial-gradient(circle at 35% 30%,#fff,var(--acc2) 70%);box-shadow:0 0 0 4px color-mix(in srgb,var(--acc) 35%,transparent),0 3px 10px rgba(0,0,0,.6);animation:umPulse 1.8s ease-in-out infinite}#ov .prog-bar.dragging .prog-fill-knob{transform:translateY(-50%) scale(1.4)}#ov .prog-times{font-size:.72rem;font-weight:700;color:rgba(255,255,255,.7);letter-spacing:.3px}@keyframes umSweep{0%{background-position:-90px 0,0 0}60%,100%{background-position:420px 0,0 0}}@keyframes umFlow{to{background-size:90px 100%,220% 100%}}@keyframes umPulse{50%{box-shadow:0 0 0 9px transparent,0 3px 10px rgba(0,0,0,.6)}}@keyframes umBuf{to{background-position:24px 0}}@keyframes umSpin{to{transform:rotate(360deg)}}@keyframes umBreath{50%{transform:scale(1.04)}} #ov .ov-acts-row{gap:8px;-webkit-mask-image:linear-gradient(90deg,#000 90%,transparent);mask-image:linear-gradient(90deg,#000 90%,transparent);scroll-snap-type:x proximity}#ov .ov-btn{scroll-snap-align:start;min-width:46px;height:46px;padding:0 13px;justify-content:center;border-radius:16px;border:1px solid transparent;background:linear-gradient(160deg,rgba(255,255,255,.13),rgba(255,255,255,.02)) padding-box,linear-gradient(160deg,rgba(255,255,255,.4),rgba(255,255,255,.04) 60%,color-mix(in srgb,var(--acc) 40%,transparent)) border-box;box-shadow:0 6px 16px rgba(0,0,0,.35);transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .25s,background .25s}#ov .ov-btn svg{width:19px;height:19px;filter:drop-shadow(0 0 6px rgba(255,255,255,.25))}#ov .ov-btn:hover{transform:translateY(-3px);box-shadow:0 12px 24px color-mix(in srgb,var(--acc) 35%,transparent)}#ov .ov-btn:active{transform:scale(.88)}#ov .ov-btn.on,#ov .ov-btn.active{box-shadow:0 0 0 2px var(--acc),0 0 22px color-mix(in srgb,var(--acc) 55%,transparent)} #ov .icbtn{border-radius:50%;border:1px solid rgba(255,255,255,.16);background:linear-gradient(160deg,rgba(255,255,255,.16),rgba(255,255,255,.03));transition:transform .35s cubic-bezier(.34,1.56,.64,1),box-shadow .25s}#ov .icbtn:active{transform:scale(.86)} #ov .icbtn.lg{position:relative;width:68px;height:68px;overflow:visible;border:0;color:var(--on-acc,#fff);background:radial-gradient(circle at 30% 25%,var(--acc2),var(--acc) 65%,color-mix(in srgb,var(--acc) 70%,#000));box-shadow:0 10px 30px color-mix(in srgb,var(--acc) 60%,transparent),inset 0 2px 0 rgba(255,255,255,.4);animation:umBreath 3s ease-in-out infinite}#ov .icbtn.lg::before{content:"";position:absolute;inset:-6px;border-radius:50%;pointer-events:none;background:conic-gradient(from 0deg,var(--acc2),transparent 40%,var(--acc),transparent 80%,var(--acc2));-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));animation:umSpin 3.5s linear infinite;opacity:.9}#ov .icbtn.lg svg{width:28px;height:28px;color:var(--on-acc,#fff);fill:currentColor;filter:drop-shadow(0 1px 2px rgba(0,0,0,.2))} #ov .vol-sl{height:6px;border-radius:99px}#ov .ch-badge{padding:4px 14px;border-radius:14px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1);text-shadow:0 0 14px currentColor;letter-spacing:1px} #ov .ov-nm{font-size:1.5rem;background:linear-gradient(90deg,#fff,var(--acc2));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-shadow:none;filter:drop-shadow(0 2px 8px rgba(0,0,0,.7))}#ov .vs-top-btn{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);opacity:1;display:flex;align-items:center;justify-content:center}@media (orientation:landscape) and (max-height:600px){#ov .ov-bot{padding:8px 12px 10px;gap:6px;border-radius:20px}#ov .icbtn.lg{width:54px;height:54px}#ov .ov-btn{height:40px;min-width:40px}}@media (prefers-reduced-motion:reduce){#ov *,#ov *::before{animation:none!important}}#ov .ov-acts-row{touch-action:pan-x;overscroll-behavior-x:contain}</style>
<style id="umit-compact-bar">#ov{padding:0!important}#ov .ov-top{padding:12px 16px 0}#ov .ov-bot{margin:0;width:100%;box-sizing:border-box;gap:5px;padding:8px 14px calc(8px + env(safe-area-inset-bottom,0px));border-radius:16px 16px 0 0;border-width:1px 0 0;box-shadow:0 -8px 28px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.14)}#ov .prog-bar,#ov .prog-bar.seekable{height:6px}#ov .prog-bar.seekable:hover,#ov .prog-bar.seekable:active,#ov .prog-bar.seekable.dragging{height:9px}#ov .prog-bar .prog-fill-knob{width:14px;height:14px;right:-7px}#ov .prog-wrap{gap:3px}#ov .prog-times{font-size:.66rem;line-height:1}#ov .ov-acts-row{gap:6px;padding-bottom:0}#ov .ov-btn{height:36px;min-width:38px;padding:0 10px;border-radius:12px}#ov .ov-btn svg{width:17px;height:17px}#ov .ctrl-row{gap:8px;padding:4px 0}#ov .icbtn.sm{width:34px;height:34px}#ov .icbtn.lg{width:50px;height:50px}#ov .icbtn.lg::before{inset:-4px}#ov .icbtn.lg svg{width:22px;height:22px}#ov .ch-badge{font-size:.95rem;padding:2px 10px;border-radius:11px}#ov .vol-sl{width:64px}#ov #ctrlsExpandBtn{width:30px;height:30px}#ov .ov-nm{font-size:1.25rem}@media (orientation:landscape) and (max-height:600px){#ov .ov-bot{padding:5px 12px calc(5px + env(safe-area-inset-bottom,0px));gap:3px;border-radius:12px 12px 0 0}#ov .ov-btn{height:32px;min-width:34px}#ov .icbtn.sm{width:30px;height:30px}#ov .icbtn.lg{width:42px;height:42px}#ov .ctrl-row{padding:2px 0}}</style>
<style id="umit-tip">#umTip{position:absolute;z-index:95;pointer-events:none;left:0;top:0;opacity:0;padding:7px 14px;border-radius:12px;font-size:.78rem;font-weight:800;letter-spacing:.3px;color:var(--on-acc,#fff);white-space:nowrap;background:linear-gradient(135deg,var(--acc),var(--acc2));box-shadow:0 8px 24px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.22),0 0 22px color-mix(in srgb,var(--acc) 55%,transparent);transform:translateY(10px) scale(.6);transform-origin:50% 100%;transition:opacity .18s,transform .38s cubic-bezier(.34,1.56,.64,1);overflow:hidden}#umTip.show{opacity:1;transform:translateY(0) scale(1)}#umTip::before{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-120%)}#umTip.show::before{animation:umTipShine 1.1s .15s ease-out}#umTip::after{content:"";position:absolute;left:var(--ax,50%);bottom:-1px;width:10px;height:10px;transform:translate(-50%,50%) rotate(45deg);background:inherit}@keyframes umTipShine{to{transform:translateX(120%)}}#ov button.um-tipped,#umitMediaBtnBar button.um-tipped{outline:2px solid var(--acc2);outline-offset:2px}@media (prefers-reduced-motion:reduce){#umTip,#umTip::before{transition:none;animation:none!important}}</style>
