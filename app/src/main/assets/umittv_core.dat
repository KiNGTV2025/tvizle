<style id="umit-fs-single">html.umit-fs-on{--fs-sb:112px}html.umit-fs-on body #mob-cats,html.fs-fallback body #mob-cats{display:none!important;visibility:hidden!important;pointer-events:none!important;width:0!important;min-width:0!important;flex:0 0 0!important;overflow:hidden!important}#app:fullscreen #mob-cats{display:none!important;visibility:hidden!important;pointer-events:none!important}#app:-webkit-full-screen #mob-cats{display:none!important;visibility:hidden!important;pointer-events:none!important}html.umit-fs-on.mm-nonlive body #sidebar,html.umit-fs-on.vod-skin body #sidebar{display:none!important}html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar{display:flex!important;flex-direction:column!important;align-items:stretch!important;position:fixed!important;left:env(safe-area-inset-left,0px)!important;top:env(safe-area-inset-top,0px)!important;bottom:env(safe-area-inset-bottom,0px)!important;z-index:251!important;margin:0!important;box-sizing:border-box!important;width:var(--fs-sb)!important;min-width:var(--fs-sb)!important;max-width:var(--fs-sb)!important;flex:none!important;padding:10px 6px!important;gap:4px!important;overflow-x:hidden!important;overflow-y:auto!important;background:var(--bg1)!important;transform:translate3d(-320%,0,0)!important;visibility:hidden!important;pointer-events:none!important;transition:transform .2s cubic-bezier(.4,0,.6,1),visibility 0s linear .2s!important}html.umit-fs-on.umit-fs-list:not(.mm-nonlive):not(.vod-skin) body #sidebar{transform:translate3d(0,0,0)!important;visibility:visible!important;pointer-events:auto!important;transition:transform .2s cubic-bezier(.16,.84,.3,1),visibility 0s linear 0s!important}html.umit-fs-on.umit-fs-snap:not(.mm-nonlive):not(.vod-skin) body #sidebar{transition:none!important} html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .catbtn{width:100%!important;min-height:42px!important;flex-direction:row!important;justify-content:flex-start!important;gap:8px!important;padding:7px 8px!important}html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .catbtn .ci{width:20px!important;height:20px!important;flex-shrink:0}html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .catbtn .cl{font-size:.72rem!important;line-height:1.2!important;text-align:left!important;text-transform:none!important;word-break:normal!important;overflow-wrap:anywhere!important;white-space:normal!important}html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .catdiv,html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .cat-search-side,html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .cat-search-side .cat-search-inp,html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #sidebar .cat-search-side .cat-search-inp:focus{width:100%!important} html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) #chExitBtn{display:none!important} html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel:not([style*="display: none"]){display:flex!important;position:fixed!important;left:env(safe-area-inset-left,0px)!important;top:env(safe-area-inset-top,0px)!important;bottom:env(safe-area-inset-bottom,0px)!important;z-index:250!important;margin:0!important;width:50vw!important;max-width:none!important;box-sizing:border-box!important;padding-left:var(--fs-sb,112px)!important;transform:translate3d(-104%,0,0)!important;visibility:hidden!important;pointer-events:none!important;box-shadow:none!important;contain:layout paint!important;will-change:transform;transition:transform .2s cubic-bezier(.4,0,.6,1),visibility 0s linear .2s!important}html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel.fs-open:not([style*="display: none"]){transform:translate3d(0,0,0)!important;visibility:visible!important;pointer-events:auto!important;box-shadow:6px 0 26px rgba(0,0,0,.5)!important;transition:transform .2s cubic-bezier(.16,.84,.3,1),visibility 0s linear 0s!important}@media(orientation:portrait){html.umit-fs-on:not(.mm-nonlive):not(.vod-skin) body #chpanel:not([style*="display: none"]){width:min(92vw,480px)!important}} html.umit-fs-on.umit-fs-snap:not(.mm-nonlive):not(.vod-skin) body #chpanel:not([style*="display: none"]),html.umit-fs-on.umit-fs-snap body #fs-chlist-backdrop{transition:none!important} html.umit-fs-on.tv-device:not(.mm-nonlive):not(.vod-skin) body #chpanel.fs-open,html.umit-fs-on.umit-lite:not(.mm-nonlive):not(.vod-skin) body #chpanel.fs-open{box-shadow:none!important} html.umit-fs-on body #fs-chlist-backdrop{display:block!important;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s linear,visibility 0s linear .2s!important}html.umit-fs-on body #fs-chlist-backdrop.show{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s linear,visibility 0s linear 0s!important}html.umit-fs-on.tv-device body #fs-chlist-backdrop,html.umit-fs-on.umit-lite body #fs-chlist-backdrop{background:transparent!important;transition:none!important} html.umit-fs-on.umit-fs-list body #chpanel.fs-open #chlist[id][id]{grid-template-columns:repeat(var(--fs-cols,2),minmax(0,1fr))!important} @media(prefers-reduced-motion:reduce){html.umit-fs-on body #chpanel,html.umit-fs-on body #fs-chlist-backdrop{transition:none!important}}</style>
<style id="umit-exit-side">#sidebar .catbtn-exit{border:1px solid rgba(239,68,68,.45);background:rgba(239,68,68,.10);margin-bottom:4px}#sidebar .catbtn-exit .ci,#sidebar .catbtn-exit .cl{color:#fca5a5}#sidebar .catbtn-exit:hover{background:rgba(239,68,68,.20);border-color:rgba(239,68,68,.7)}@media(min-width:1025px){#chExitBtn{display:none!important}}html.tv-device #chExitBtn{display:none!important}</style>
<style id="umit-catsearch-fix">html:root:root:root .cat-search-side{width:100%!important}html:root:root:root .cat-search-side .cat-search-ic{left:11px!important;right:auto!important;top:50%!important;transform:translateY(-50%)!important;width:14px;height:14px;opacity:.85}html:root:root:root .cat-search-side .cat-search-inp,html:root:root:root .cat-search-side .cat-search-inp:focus{width:100%!important;height:34px!important;box-sizing:border-box!important;padding:0 8px 0 32px!important;text-indent:0!important;text-align:left!important;font-size:.76rem!important}html:root:root:root .cat-search-side .cat-search-inp::placeholder{text-align:left;opacity:.8;text-indent:0}html:root:root:root .cat-search-side .cat-search-inp{min-width:0!important;max-width:100%!important;direction:ltr;text-overflow:ellipsis;white-space:nowrap;overflow:hidden;line-height:34px}html:root:root:root.umit-fs-on #sidebar .cat-search-side .cat-search-inp{padding-left:34px!important;text-indent:0!important} .fep-item{cursor:pointer;margin-bottom:8px}.fep-item:focus,.fep-item:focus-visible{outline:none;border-color:#ffb347;box-shadow:0 0 0 2px rgba(255,179,71,.85),0 6px 18px rgba(0,0,0,.35);transform:scale(1.015)}.fep-hint{display:flex;align-items:center;gap:7px;font-size:.7rem;line-height:1.3;color:var(--text2);padding:2px 4px 10px}.fep-hint svg{flex:none;color:var(--acc)}.fep-badge.reminder svg{display:inline-block}#progRemBanner{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top,0px));z-index:100003;width:min(92vw,460px);box-sizing:border-box;display:flex;align-items:center;gap:12px;padding:12px 12px 14px 14px;border-radius:18px;color:var(--text,#fff);background:linear-gradient(135deg,rgba(46,22,14,.97),rgba(30,12,10,.97));border:1px solid rgba(255,154,31,.45);box-shadow:0 16px 44px rgba(0,0,0,.6);overflow:hidden;transform:translate(-50%,-140%);opacity:0;transition:transform .3s cubic-bezier(.16,.84,.3,1),opacity .25s}#progRemBanner.show{transform:translate(-50%,0);opacity:1}#progRemBanner .prb-ic{flex:none;width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#1a0a00;background:linear-gradient(135deg,#ffc933,#ff9a1f)}#progRemBanner .prb-ic svg{width:22px;height:22px}#progRemBanner .prb-tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}#progRemBanner .prb-tx b{font-size:.92rem;font-weight:800}#progRemBanner .prb-tx span{font-size:.76rem;opacity:.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#progRemBanner .prb-x{flex:none;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:0;border-radius:10px;background:rgba(255,255,255,.08);color:inherit;cursor:pointer}#progRemBanner .prb-x svg{width:16px;height:16px}#progRemBanner .prb-bar{position:absolute;left:0;bottom:0;height:3px;width:100%;background:linear-gradient(90deg,#ffc933,#ff7a18);transform-origin:left;animation:prbBar 10s linear forwards}@keyframes prbBar{from{transform:scaleX(1)}to{transform:scaleX(0)}}</style>
