<style id="umit-tv-bigtext">html.tv-device,html.umit-lite{font-size:130%}html.tv-device #topbar,html.umit-lite #topbar{height:66px}html.tv-device #sidebar,html.umit-lite.tv-device #sidebar{width:150px!important}html.tv-device .catbtn{min-height:52px!important}html.tv-device .catbtn .ci{width:26px!important;height:26px!important}html.tv-device #chpanel,html.tv-device #chpanel.open{width:470px!important;max-width:470px!important}@media(max-width:1024px){html.tv-device #chpanel,html.tv-device #chpanel.open{width:470px!important;max-width:470px!important}}html.tv-device #chlist,html.tv-device #app:fullscreen #chpanel.fs-open #chlist,html.tv-device.fs-fallback #chpanel.fs-open #chlist{grid-template-columns:repeat(auto-fill,minmax(calc(130px*var(--umit-fs,1)),1fr))!important}html.tv-device .mmtab,html.tv-device .tb-src{font-size:.78rem}html.tv-device .umit-stats-header{font-size:14px}html.tv-device .umit-stats-row{font-size:15px}</style>

<style id="umit-fs-style">#sidebar .umit-fs-row{display:flex;align-items:center;justify-content:center;gap:4px;margin:2px 4px 6px;flex-wrap:wrap}#sidebar .umit-fs-btn{flex:1 1 0;width:auto;min-width:0;min-height:40px;display:flex;align-items:center;justify-content:center;padding:4px 2px;margin:0;border:1px solid var(--bord2);border-radius:10px;cursor:pointer}#sidebar .umit-fs-btn .umit-fs-t{font-weight:900;font-size:1.05rem;color:var(--acc3,var(--acc));line-height:1}#sidebar .umit-fs-btn small{font-size:.8em;margin-left:1px}#sidebar .umit-fs-btn.umit-fs-off{opacity:.35}#sidebar .umit-th-name{flex:0 0 100%;order:-1;display:flex!important;visibility:visible!important;opacity:1!important;align-items:center;justify-content:center;gap:6px;font-size:.85rem;font-weight:800;color:var(--text);line-height:1.25;padding:3px 2px;white-space:normal;overflow:visible;text-align:center;min-height:1.4em}#sidebar .umit-th-name span{overflow:visible;text-overflow:clip;white-space:normal;word-break:normal}#sidebar .umit-th-dot{width:12px;height:12px;border-radius:50%;border:1px solid rgba(255,255,255,.4);flex-shrink:0;display:inline-block}#sidebar .umit-fs-pct{flex:0 0 100%;order:3;text-align:center;font-size:1.05rem;font-weight:900;color:var(--text);letter-spacing:.3px;line-height:1.2;padding:2px 0}html.tv-device #sidebar .umit-fs-pct{font-size:1.15rem}html.tv-device #sidebar .umit-fs-btn{min-height:44px} html.tv-device #sidebar,html.umit-lite.tv-device #sidebar{width:calc(150px*max(var(--umit-fs,1),1.6))!important}html.tv-device #topbar,html.umit-lite #topbar{height:calc(66px*var(--umit-fs,1))}  html.tv-device #chpanel,html.tv-device #chpanel.open{width:clamp(280px,calc(var(--umit-chw,350px) - 300px*(var(--umit-fs,1) - 1) - 120px*(max(var(--umit-fs,1),1.6) - var(--umit-fs,1))),460px)!important;max-width:clamp(280px,calc(var(--umit-chw,350px) - 300px*(var(--umit-fs,1) - 1) - 120px*(max(var(--umit-fs,1),1.6) - var(--umit-fs,1))),460px)!important} html.tv-device #topbar{padding-right:22px}html.tv-device .tb-btns{padding:6px 16px 6px 6px;scroll-padding-inline:18px;box-sizing:border-box}#chlist .chi-ep,#chlist .chi-prog,#chlist .chi-next{flex-shrink:0!important;min-height:fit-content}</style>
<style id="umit-light-fix">html:root[data-theme="light"] #chpanel.fs-open .chi.grid .chi-nm,html:root[data-theme="light"] #chpanel.fs-open .chi.list .chi-nm{color:var(--text)!important;text-shadow:none!important}html:root[data-theme="light"] #chpanel.fs-open .chi.grid .chi-ep,html:root[data-theme="light"] #chpanel.fs-open .chi.list .chi-ep{color:var(--text2)!important;text-shadow:none!important}html:root[data-theme="light"] #chpanel.fs-open .chi.on .chi-nm{color:var(--acc)!important}html:root[data-theme="light"] #chpanel.fs-open .chi .chi-act-btn{color:var(--acc3)!important;border-color:var(--bord2)!important;background:rgba(255,255,255,.55)}html:root[data-theme="light"] #chpanel.fs-open .chi.grid .chi-n{background:rgba(35,26,5,.78)!important;color:#fff!important}html:root[data-theme="light"] #chpanel.fs-open .chi{color:var(--text)}html:root[data-theme="light"] #chpanel .chi-prog,html:root[data-theme="light"] #chpanel .chi-bar{background:rgba(35,26,5,.12)}html:root[data-theme="light"] #chpanel.fs-open .chi-now2 .n2-t{color:#fff}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar{background:var(--bg1)!important;border-right-color:var(--bord2)!important}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar::before{border-bottom-color:rgba(35,26,5,.12);color:var(--acc3,#b45309)}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn .ci{background:rgba(35,26,5,.07)}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn.on .ci{background:rgba(234,88,12,.20)}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn:focus,html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn:focus-visible{background:linear-gradient(90deg,rgba(234,88,12,.26),rgba(234,88,12,.08))!important}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn:focus .cl,html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catbtn.on .cl{color:var(--acc)!important}html:not(#u):root[data-theme="light"].tv-device.umit-fs-on body #sidebar .catdiv{background:linear-gradient(90deg,transparent,rgba(35,26,5,.2),transparent)!important}html:root[data-theme="light"] #sidebar .umit-th-dot{border-color:rgba(35,26,5,.35)}</style>
