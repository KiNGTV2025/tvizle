<style id="umit-chlist-v2-css">.chi.list{background:linear-gradient(135deg,var(--bg2),var(--bg3));border-radius:16px;box-shadow:0 2px 10px rgba(0,0,0,.18);transition:border-color .15s,box-shadow .15s,transform .15s}.chi.list:hover{box-shadow:0 6px 18px rgba(0,0,0,.28)}.chi.list.on{box-shadow:0 0 0 1px var(--acc),0 8px 22px rgba(0,0,0,.35)}.chi.list.on::before{content:'';position:absolute;left:0;top:12px;bottom:12px;width:4px;border-radius:0 4px 4px 0;background:var(--acc)}.chi.list .chi-logo{width:56px;height:56px;border-radius:14px;background:radial-gradient(circle at 30% 20%,var(--bg3),var(--bg2))}.chi.list .chi-nm{font-weight:700;letter-spacing:.1px}.chi.list .chi-ep{font-weight:600;color:var(--text);opacity:.92;margin-top:3px;font-size:.7rem}.chi.grid .chi-logo{background:radial-gradient(circle at 30% 20%,var(--bg3),var(--bg2));border-radius:16px}.chi.grid.on .chi-logo{box-shadow:0 0 0 2px var(--acc),0 8px 20px rgba(0,0,0,.4)}.chi-prog{display:flex;align-items:center;gap:6px;margin-top:5px;min-width:0;font-size:.6rem;line-height:1;color:var(--text2)}.chi-prog .cp-bar{flex:1 1 auto;min-width:18px;height:4px;border-radius:4px;background:rgba(255,255,255,.16);overflow:hidden;position:relative}.chi-prog .cp-bar i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:4px;background:linear-gradient(90deg,var(--acc),var(--acc2,var(--acc)));transition:width .4s}.chi-prog .cp-tx{flex-shrink:0;white-space:nowrap;font-variant-numeric:tabular-nums;font-weight:700}.chi-prog .cp-t2{flex-shrink:1;min-width:0;overflow:hidden;text-overflow:ellipsis}.chi.list .cp-t2.lf::after{content:' kaldı';font-weight:600;opacity:.75}.chi-prog .cp-t1{font-weight:600;opacity:.85}.chi.grid .cp-t1{display:none}.chi-next{font-size:.62rem;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px;opacity:.9}.chi.grid .chi-next{display:none!important}#chlist.chl-cmp .chi.list .chi-next,#chlist.chl-cmp .chi.list .cp-t1{display:none!important}.cp-chip{display:inline-flex;align-items:center;gap:3px;flex-shrink:0;padding:2px 5px;border-radius:6px;font-weight:900;letter-spacing:.3px;font-size:.55rem;cursor:pointer;background:rgba(245,158,11,.2);color:#fbbf24;border:1px solid rgba(245,158,11,.55)}.cp-chip[data-st="none"],.cp-chip[data-st="expired"]{background:rgba(148,163,184,.2);color:#e2e8f0;border-color:rgba(148,163,184,.55)}.cp-chip svg{width:10px;height:10px;flex-shrink:0}.chi.grid .cp-chip b{display:none}.chi.grid .cp-chip{padding:2px 3px}.chi[data-epgst="cut"] .cp-bar i,.chi[data-epgst="gap"] .cp-bar i{background:linear-gradient(90deg,#f59e0b,#fbbf24)}#chiActTip small.tip-epg{margin-top:3px;opacity:1;font-weight:700}.fep-warn{margin:0 0 8px;padding:8px 10px;border-radius:10px;font-size:.74rem;font-weight:700;line-height:1.3;background:rgba(245,158,11,.16);color:#fbbf24;border:1px solid rgba(245,158,11,.5)}#app:fullscreen #chpanel.fs-open .chi.list .chi-prog,html.fs-fallback #chpanel.fs-open .chi.list .chi-prog{font-size:.66rem}</style>

<style id="umit-pwinfo-css">#pwInfo{display:none}#main.pwi-on #pwInfo{display:flex;flex-direction:column;gap:8px;flex:1 1 auto;min-height:0;overflow:hidden;box-sizing:border-box;padding:12px 14px;background:linear-gradient(180deg,var(--bg2),var(--bg1,var(--bg2)));border-top:1px solid var(--bord);color:var(--text)}#main.pwi-on #epg-panel.open{display:none}#pwInfo .pwi-h{display:flex;align-items:center;gap:10px;min-width:0}#pwInfo .pwi-logo{width:40px;height:40px;border-radius:11px;background:var(--bg3);border:1px solid var(--bord);flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden}#pwInfo .pwi-logo img{width:100%;height:100%;object-fit:contain;padding:4px;box-sizing:border-box}#pwInfo .pwi-ch{font-size:.8rem;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1}#pwInfo .pwi-ch small{display:block;font-weight:600;font-size:.62rem;color:var(--text2)}#pwInfo .pwi-chip{display:inline-flex;align-items:center;gap:4px;flex-shrink:0;padding:3px 8px;border-radius:7px;font-size:.6rem;font-weight:900;letter-spacing:.3px;background:rgba(245,158,11,.2);color:#fbbf24;border:1px solid rgba(245,158,11,.55)}#pwInfo .pwi-chip[data-st="none"],#pwInfo .pwi-chip[data-st="expired"]{background:rgba(148,163,184,.2);color:#e2e8f0;border-color:rgba(148,163,184,.55)}#pwInfo .pwi-now{display:flex;flex-direction:column;gap:5px;min-width:0}#pwInfo .pwi-tag{align-self:flex-start;padding:1px 7px;border-radius:5px;background:var(--acc);color:var(--on-acc,#000);font-size:.58rem;font-weight:900;letter-spacing:.4px}#pwInfo .pwi-t{font-size:1.02rem;font-weight:800;line-height:1.22;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}#pwInfo .pwi-bar{display:flex;align-items:center;gap:8px;font-size:.68rem;font-weight:700;color:var(--text2);font-variant-numeric:tabular-nums}#pwInfo .pwi-bar span{flex-shrink:0}#pwInfo .pwi-pb{flex:1;height:5px;border-radius:5px;background:rgba(255,255,255,.16);overflow:hidden;position:relative}#pwInfo .pwi-pb i{position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:linear-gradient(90deg,var(--acc),var(--acc2,var(--acc)))}#pwInfo .pwi-d{font-size:.74rem;line-height:1.35;color:var(--text2);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}#pwInfo .pwi-nx{display:flex;flex-direction:column;gap:4px;margin-top:auto;flex-shrink:0}#pwInfo .pwi-nxr{flex-shrink:0}#pwInfo .pwi-nxr{display:flex;gap:8px;font-size:.72rem;min-width:0}#pwInfo .pwi-nxr b{color:var(--acc2,var(--acc));font-variant-numeric:tabular-nums;flex-shrink:0}#pwInfo .pwi-nxr em{font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#pwInfo .pwi-warn{font-size:.72rem;font-weight:700;line-height:1.3;color:#fbbf24}#pwInfo .pwi-none{font-size:.78rem;color:var(--text2)} #main.pwi-on #ov,#main.pwi-on #ch-transition{zoom:var(--pwi-k,.4)}#main.pwi-on #ch-transition .ct-card{max-height:62%!important;overflow:hidden!important}#main.pwi-on #ch-transition .ct-epg-desc,#main.pwi-on #ch-transition .ct-next,#main.pwi-on #ch-transition .ct-tech{display:none!important}#main.pwi-on #pw{overflow:hidden!important;flex:0 0 auto!important;height:var(--pwi-h,auto)!important} html.fs-fallback #main.pwi-on #pwInfo,html.vod-skin #main.pwi-on #pwInfo,html.vod-full #main.pwi-on #pwInfo{display:none!important}html.fs-fallback #main.pwi-on #pw{height:100vh!important;flex:1 1 auto!important}html.fs-fallback #main.pwi-on #ov,html.fs-fallback #main.pwi-on #ch-transition{zoom:1!important}#app:fullscreen #main.pwi-on #pwInfo{display:none!important}#app:fullscreen #main.pwi-on #pw{height:100vh!important;flex:1 1 auto!important}#app:fullscreen #main.pwi-on #ov,#app:fullscreen #main.pwi-on #ch-transition{zoom:1!important}#app:-webkit-full-screen #main.pwi-on #pwInfo{display:none!important}#app:-webkit-full-screen #main.pwi-on #pw{height:100vh!important;flex:1 1 auto!important}#app:-webkit-full-screen #main.pwi-on #ov,#app:-webkit-full-screen #main.pwi-on #ch-transition{zoom:1!important}</style>

