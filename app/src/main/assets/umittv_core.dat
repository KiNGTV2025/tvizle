<style id="umit-reviews-css">#svReviews{margin:14px 0 6px}.rv-h{display:flex;align-items:center;gap:8px;font-weight:800;font-size:.95rem;margin-bottom:8px}.rv-h small{font-weight:600;opacity:.65;font-size:.7rem}.rv-btn{width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--bord2,#555);background:var(--bg3);color:var(--text);font-weight:700;font-size:.8rem;cursor:pointer}.rv-btn:focus-visible,.rv-more:focus-visible{outline:3px solid var(--acc);outline-offset:2px}.rv-card{padding:11px 12px;margin-top:8px;border-radius:12px;background:var(--bg3);border:1px solid var(--bord)}.rv-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;font-size:.74rem}.rv-au{font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rv-rt{flex:0 0 auto;font-weight:800;color:var(--acc3,#fbbf24)}.rv-dt{opacity:.6;font-size:.66rem}.rv-tx{font-size:.78rem;line-height:1.5;white-space:pre-line;word-break:break-word;opacity:.92}.rv-tx.cl{display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}.rv-more{margin-top:5px;background:none;border:0;color:var(--acc3,#fbbf24);font-weight:700;font-size:.74rem;cursor:pointer;padding:4px 0}.rv-note{font-size:.68rem;opacity:.65;margin-top:6px}</style>
