<style id="umit-vs-modern">#vodSettingsPanel{background:linear-gradient(165deg,rgba(26,28,34,.97),rgba(10,11,14,.98));border:1px solid rgba(255,255,255,.10);border-radius:24px;box-shadow:0 28px 80px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.03) inset,0 -1px 0 color-mix(in srgb,var(--acc,#f97316) 40%,transparent) inset;-webkit-backdrop-filter:blur(18px) saturate(1.2);backdrop-filter:blur(18px) saturate(1.2)}#vodSettingsPanel .vs-page{padding:0 0 14px;scrollbar-width:none}#vodSettingsPanel .vs-page::-webkit-scrollbar{display:none}#vodSettingsPanel .vs-head{position:sticky;top:0;z-index:2;padding:20px 22px 14px;font-size:1.3rem;font-weight:900;letter-spacing:-.4px;border-bottom:none;background:linear-gradient(180deg,rgba(18,19,23,.98) 70%,rgba(18,19,23,0))}#vodSettingsPanel .vs-head::before{content:'';width:5px;height:22px;border-radius:4px;flex-shrink:0;margin-right:2px;background:linear-gradient(180deg,var(--acc,#f97316),var(--acc2,#fbbf24));box-shadow:0 0 14px color-mix(in srgb,var(--acc,#f97316) 60%,transparent)}#vodSettingsPanel .vs-back{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;padding:0;background:rgba(255,255,255,.07);transition:background .15s,transform .15s} #vodSettingsPanel .vs-row,#vodSettingsPanel .vs-opt,#vodSettingsPanel .vs-lang-row,#vodSettingsPanel .vs-sub-file-row{width:calc(100% - 20px);margin:5px 10px;border:2px solid transparent;border-radius:18px;background:rgba(255,255,255,.05);transition:background .16s ease,border-color .16s ease,transform .16s ease,box-shadow .16s ease}#vodSettingsPanel .vs-row{padding:13px 14px;gap:14px}#vodSettingsPanel .vs-opt{padding:15px 16px;font-size:.95rem}#vodSettingsPanel .vs-sep{height:6px}#vodSettingsPanel .vs-ico{width:42px;height:42px;border-radius:14px;flex-shrink:0;background:color-mix(in srgb,var(--acc,#f97316) 16%,rgba(255,255,255,.04));color:var(--acc2,#fbbf24);transition:background .16s ease,color .16s ease,transform .16s ease}#vodSettingsPanel .vs-ico svg{width:20px;height:20px}#vodSettingsPanel .vs-row-t{font-size:1rem;font-weight:800;letter-spacing:-.1px}#vodSettingsPanel .vs-row-s{font-size:.8rem;color:#9aa0aa}#vodSettingsPanel .vs-chev{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;line-height:1;background:rgba(255,255,255,.06);color:#b7bcc6;transition:transform .16s ease,background .16s ease,color .16s ease}#vodSettingsPanel .vs-opt.on,#vodSettingsPanel .vs-lang-row.on{background:color-mix(in srgb,var(--acc,#f97316) 15%,rgba(255,255,255,.04));border-color:color-mix(in srgb,var(--acc,#f97316) 55%,transparent)}#vodSettingsPanel .vs-opt.on::after{content:'✓';width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;background:var(--acc,#f97316);color:var(--on-acc,#fff)} #vodSettingsPanel .vs-row:active,#vodSettingsPanel .vs-opt:active,#vodSettingsPanel .vs-lang-row:active{transform:scale(.98)}@media (hover:hover){#vodSettingsPanel .vs-row:hover,#vodSettingsPanel .vs-opt:hover,#vodSettingsPanel .vs-lang-row:hover{background:rgba(255,255,255,.09)}} #vodSettingsPanel .vs-row:focus-visible,#vodSettingsPanel .vs-opt:focus-visible,#vodSettingsPanel .vs-lang-row:focus-visible,#vodSettingsPanel .vs-sub-file-row:focus-visible,#vodSettingsPanel .vs-sub-card:focus-visible,#vodSettingsPanel .vs-sub-actbtn:focus-visible,#vodSettingsPanel .vs-ep-row:focus-visible,#vodSettingsPanel .vs-ep-tab:focus-visible,#vodSettingsPanel .vs-back:focus-visible,html.tv-device #vodSettingsPanel .vs-row:focus,html.tv-device #vodSettingsPanel .vs-opt:focus,html.tv-device #vodSettingsPanel .vs-lang-row:focus,html.tv-device #vodSettingsPanel .vs-sub-file-row:focus,html.tv-device #vodSettingsPanel .vs-sub-card:focus,html.tv-device #vodSettingsPanel .vs-sub-actbtn:focus,html.tv-device #vodSettingsPanel .vs-ep-row:focus,html.tv-device #vodSettingsPanel .vs-ep-tab:focus,html.tv-device #vodSettingsPanel .vs-back:focus{outline:none;border-color:var(--acc);background:linear-gradient(135deg,color-mix(in srgb,var(--acc,#f97316) 42%,#16181d),color-mix(in srgb,var(--acc) 22%,#16181d));box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 55%,transparent),0 10px 30px color-mix(in srgb,var(--acc,#f97316) 45%,transparent);transform:scale(1.035);position:relative;z-index:1}#vodSettingsPanel .vs-row:focus-visible .vs-ico,html.tv-device #vodSettingsPanel .vs-row:focus .vs-ico{background:var(--acc);color:var(--on-acc,#111);transform:scale(1.08) rotate(-4deg)}#vodSettingsPanel .vs-row:focus-visible .vs-chev,html.tv-device #vodSettingsPanel .vs-row:focus .vs-chev{background:var(--acc);color:var(--on-acc,#111);transform:translateX(4px)}#vodSettingsPanel .vs-row:focus-visible .vs-row-s,html.tv-device #vodSettingsPanel .vs-row:focus .vs-row-s{color:#fff;opacity:.9}#vodSettingsPanel .vs-opt:focus-visible,html.tv-device #vodSettingsPanel .vs-opt:focus{color:#fff}#vodSettingsPanel .vs-opt.on:focus-visible::after,html.tv-device #vodSettingsPanel .vs-opt.on:focus::after{background:var(--acc);color:var(--on-acc,#111)} .vs-top-btn{transition:transform .16s ease,box-shadow .16s ease,background .16s ease}.vs-top-btn:focus-visible,html.tv-device .vs-top-btn:focus{outline:none;background:linear-gradient(135deg,var(--acc,#f97316),var(--acc));color:var(--on-acc,#1a1200);opacity:1;box-shadow:0 0 0 3px var(--acc),0 8px 24px color-mix(in srgb,var(--acc,#f97316) 55%,transparent);transform:scale(1.12)} @keyframes vsRowIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}#vodSettingsPanel.open #vs-main>.vs-row{animation:vsRowIn .32s cubic-bezier(.16,1,.3,1) both}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(2){animation-delay:.03s}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(3){animation-delay:.06s}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(4){animation-delay:.09s}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(5){animation-delay:.12s}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(6){animation-delay:.15s}#vodSettingsPanel.open #vs-main>.vs-row:nth-of-type(n+7){animation-delay:.18s}@media (prefers-reduced-motion:reduce){#vodSettingsPanel.open #vs-main>.vs-row{animation:none}} html.tv-device #vodSettingsPanel{width:min(520px,60vw)}html.tv-device #vodSettingsPanel .vs-head{font-size:1.6rem;padding:24px 26px 16px}html.tv-device #vodSettingsPanel .vs-row{padding:16px 18px}html.tv-device #vodSettingsPanel .vs-ico{width:52px;height:52px;border-radius:16px}html.tv-device #vodSettingsPanel .vs-ico svg{width:26px;height:26px}html.tv-device #vodSettingsPanel .vs-row-t{font-size:1.2rem}html.tv-device #vodSettingsPanel .vs-row-s{font-size:.95rem}html.tv-device #vodSettingsPanel .vs-opt{padding:18px 20px;font-size:1.1rem}html.tv-device #vodSettingsPanel .vs-chev{width:34px;height:34px;font-size:1.5rem}</style>
